        hexBorder: '#fdba74',
        namePillStyle: 'background: linear-gradient(90deg, #ad4f22 0%, #733112 100%); border-color: #fdba74; color: #ffffff;',
        cardTintStyle: 'background: linear-gradient(90deg, rgba(173,79,34,0.25) 0%, rgba(15,23,42,0.95) 85%); border-color: rgba(173,79,34,0.45);',
        jobs: ['Blacksmith', 'Whitesmith']
      },
      {
        familyKey: 'alchemist',
        label: 'Alchemist',
        role: 'dps',
        hexMain: '#a65422',
        hexDark: '#632e0e',
        hexBorder: '#fcd34d',
        namePillStyle: 'background: linear-gradient(90deg, #a65422 0%, #6e3512 100%); border-color: #fcd34d; color: #ffffff;',
        cardTintStyle: 'background: linear-gradient(90deg, rgba(166,84,34,0.25) 0%, rgba(15,23,42,0.95) 85%); border-color: rgba(166,84,34,0.45);',
        jobs: ['Alchemist', 'Creator']
      },
      {
        familyKey: 'rebel',
        label: 'Rebel',
        sub: 'Night Walker',
        role: 'dps',
        hexMain: '#6c352c',
        hexDark: '#421d17',
        hexBorder: '#fca5a5',
        namePillStyle: 'background: linear-gradient(90deg, #6c352c 0%, #47201a 100%); border-color: #fca5a5; color: #ffffff;',
        cardTintStyle: 'background: linear-gradient(90deg, rgba(108,53,44,0.28) 0%, rgba(15,23,42,0.95) 85%); border-color: rgba(108,53,44,0.50);',
        jobs: ['Rebel', 'Night Walker', 'Gunslinger']
      },
      {
        familyKey: 'kanos',
        label: 'คานอส',
        role: 'dps',
        hexMain: '#296e67',
        hexDark: '#16403b',
        hexBorder: '#5eead4',
        namePillStyle: 'background: linear-gradient(90deg, #296e67 0%, #194742 100%); border-color: #5eead4; color: #ffffff;',
        cardTintStyle: 'background: linear-gradient(90deg, rgba(41,110,103,0.28) 0%, rgba(15,23,42,0.95) 85%); border-color: rgba(41,110,103,0.50);',
        jobs: ['คานอส', 'อาลิเทีย', 'Kanos', 'Alithea']
      }
    ];

    const JOB_LOOKUP = {};
    JOB_FAMILIES.forEach(fam => {
      fam.jobs.forEach(jName => {
        JOB_LOOKUP[jName.toLowerCase()] = fam;
      });
    });

    function getJobFamily(jobName) {
      const key = (jobName || '').trim().toLowerCase();
      if (JOB_LOOKUP[key]) return JOB_LOOKUP[key];
      for (const fam of JOB_FAMILIES) {
        if (fam.jobs.some(j => key.includes(j.toLowerCase()))) return fam;
      }
      return {
        familyKey: 'novice',
        label: jobName || 'Novice',
        role: 'dps',
        hexMain: '#475569',
        hexDark: '#1e293b',
        hexBorder: '#94a3b8',
        namePillStyle: 'background: linear-gradient(90deg, #475569 0%, #1e293b 100%); border-color: #94a3b8; color: #ffffff;',
        cardTintStyle: 'background: linear-gradient(90deg, rgba(71,85,105,0.20) 0%, rgba(15,23,42,0.95) 85%); border-color: rgba(71,85,105,0.40);',
        jobs: ['Novice']
      };
    }

    function getJobInnerSymbolSVG(familyKey) {
      switch (familyKey) {
        case 'knight':
          return '<path d="M19 45 L44 20 M40 18 L46 18 L46 24" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M23 35 L29 41 M18 46 L22 42" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round"/><path d="M45 45 L20 20 M24 18 L18 18 L18 24" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M41 35 L35 41 M46 46 L42 42" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round"/>';
        case 'crusader':
          return '<path d="M32 16 L45 21 V32 C45 40.5 39 46.5 32 49 C25 46.5 19 40.5 19 32 V21 L32 16 Z" fill="rgba(255,255,255,0.18)" stroke="#ffffff" stroke-width="3.4" stroke-linejoin="round"/><path d="M32 22 V42 M24 29 H40" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round"/>';
        case 'wizard':
          return '<path d="M24 46 L37 29" stroke="#ffffff" stroke-width="3.8" stroke-linecap="round"/><path d="M32 28 C30 21 36 16 42 19 C47 22 45 30 39 31 C36 31.5 35 28 37 26" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round" fill="none"/><circle cx="39" cy="24" r="2.6" fill="#ffffff"/>';
        case 'sage':
          return '<path d="M32 33 C28 28 29 21 34 16 C33 21 38 22 37 28 C39 26 40 23 39 20 C42 24 41 31 35 34 Z" fill="#ffffff"/><path d="M18 33 C23 33 28 35 32 39 C36 35 41 33 46 33 V43 C41 43 36 45 32 49 C28 45 23 43 18 43 Z" fill="rgba(255,255,255,0.2)" stroke="#ffffff" stroke-width="3.2" stroke-linejoin="round"/><path d="M21 29 C25 29 29 31 32 35 C35 31 39 29 43 29" stroke="#ffffff" stroke-width="2.8" stroke-linecap="round" fill="none"/><line x1="32" y1="38" x2="32" y2="48" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round"/>';
        case 'hunter':
          return '<path d="M24 18 C38 21 41 41 24 46" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" fill="none"/><line x1="24" y1="19" x2="24" y2="45" stroke="#ffffff" stroke-width="2" stroke-opacity="0.85"/><path d="M19 32 H45 M39 26 L46 32 L39 38" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>';
        case 'bard':
          return '<path d="M22 20 C22 34 25 44 33 44 C41 44 43 34 42 22" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round" fill="none"/><path d="M20 20 H44" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round"/><line x1="29" y1="22" x2="29" y2="42" stroke="#ffffff" stroke-width="2.2"/><line x1="35" y1="22" x2="35" y2="42" stroke="#ffffff" stroke-width="2.2"/>';
        case 'dancer':
          return '<path d="M22 45 L29 36" stroke="#ffffff" stroke-width="4" stroke-linecap="round"/><path d="M29 36 C38 35 45 27 41 20 C37 15 27 19 29 26 C31 32 42 33 45 41" stroke="#ffffff" stroke-width="3.3" stroke-linecap="round" fill="none"/><circle cx="21" cy="45" r="2.5" fill="#ffffff"/>';
        case 'priest':
          return '<path d="M32 16 V48 M18 30 H46" stroke="#ffffff" stroke-width="4.4" stroke-linecap="round"/><circle cx="32" cy="30" r="5" fill="#218332" stroke="#ffffff" stroke-width="2.6"/><path d="M29 18 H35 M29 46 H35 M20 27 V33 M44 27 V33" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round"/>';
        case 'monk':
          return '<path d="M22 29 C22 23 26 20 32 20 C38 20 42 23 42 29 V37 C42 42 38 45 32 45 C26 45 22 42 22 37 Z" fill="#ffffff"/><path d="M32 26 L33.8 30.2 L38 32 L33.8 33.8 L32 38 L30.2 33.8 L26 32 L30.2 30.2 Z" fill="#288d36"/>';
        case 'assassin':
          return '<path d="M32 16 L42 37 L32 33 L22 37 Z" fill="#ffffff" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round"/><path d="M21 41 H43 M25 45 H39" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round"/>';
        case 'rogue':
          return '<path d="M22 19 C21 29 25 37 31 39 L30 35 L35 37 L38 33 C31 30 26 25 22 19 Z" fill="#ffffff" stroke="#ffffff" stroke-width="2" stroke-linejoin="round"/><path d="M34 41 L40 31" stroke="#ffffff" stroke-width="3.8" stroke-linecap="round"/><path d="M37 37 L43 41 C44.5 42 44.5 44 43 45 C41.5 46 39.5 45 38.5 43.5 L35.5 39" fill="none" stroke="#ffffff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>';
        case 'blacksmith':
          return '<line x1="32" y1="17" x2="32" y2="47" stroke="#ffffff" stroke-width="3.8" stroke-linecap="round"/><path d="M32 22 C24 18 18 22 18 28 C18 34 24 38 32 34 Z" fill="#ffffff"/><path d="M32 22 C40 18 46 22 46 28 C46 34 40 38 32 34 Z" fill="#ffffff"/>';
        case 'alchemist':
          return '<path d="M28 18 H36 M30 18 V26 L21 41 C19.5 43.5 21.5 46 24.5 46 H39.5 C42.5 46 44.5 43.5 43 41 L34 26 V18" stroke="#ffffff" stroke-width="3.3" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M24 38 H40 L42 42 H22 Z" fill="#ffffff"/>';
        case 'rebel':
          return '<path d="M19 25 H43 V31 H32 L29 43 H22 L25 31 H19 Z" fill="#ffffff" stroke="#ffffff" stroke-width="1.8" stroke-linejoin="round"/><circle cx="31" cy="28" r="2.4" fill="#6c352c"/>';
        case 'kanos':
          return '<path d="M32 46 V26" stroke="#ffffff" stroke-width="3.8" stroke-linecap="round"/><path d="M32 34 C25 34 21 29 22 24 C23 19 28 17 32 21 C36 17 41 19 42 24 C43 29 39 34 32 34 Z" fill="none" stroke="#ffffff" stroke-width="3.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M25 46 H39" stroke="#ffffff" stroke-width="3.2" stroke-linecap="round"/>';
        default:
          return '<circle cx="32" cy="32" r="9" fill="#ffffff"/>';
      }
    }

    function renderJobEmblem(jobName, sizePx = 30) {
      const fam = getJobFamily(jobName);
      const innerSvg = getJobInnerSymbolSVG(fam.familyKey);
      return `<svg width="${sizePx}" height="${sizePx}" style="width:${sizePx}px;height:${sizePx}px;min-width:${sizePx}px;" viewBox="0 0 64 64" class="shrink-0 drop-shadow" xmlns="http://www.w3.org/2000/svg"><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(22.5 32 32)" fill="${fam.hexDark}" stroke="rgba(255,255,255,0.75)" stroke-width="2"/><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(67.5 32 32)" fill="${fam.hexMain}" stroke="rgba(255,255,255,0.9)" stroke-width="2"/><polygon points="24,9 40,9 55,24 55,40 40,55 24,55 9,40 9,24" fill="${fam.hexMain}" stroke="#ffffff" stroke-width="2.4" stroke-linejoin="round"/><polygon points="26,14 38,14 50,26 50,38 38,50 26,50 14,38 14,26" fill="${fam.hexDark}" stroke="rgba(255,255,255,0.45)" stroke-width="1.3" stroke-linejoin="round"/>${innerSvg}</svg>`;
    }

    function renderColoredMemberName(member, extraClasses = '') {
      const fam = getJobFamily(member.job);
      const strikeClass = member.status === 'leave' ? 'line-through opacity-75' : '';
      return `<span style="${fam.namePillStyle}" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg border font-semibold text-xs shadow-sm ${strikeClass} ${extraClasses}"><span class="truncate">${member.name}</span></span>`;
    }

    function getJobMeta(job) {
      const fam = getJobFamily(job);
      return {
        role: fam.role,
        familyKey: fam.familyKey,
        label: fam.label,
        hexMain: fam.hexMain,
        hexDark: fam.hexDark,
        hexBorder: fam.hexBorder,
        namePillStyle: fam.namePillStyle,
        cardTintStyle: fam.cardTintStyle,
        badgeStyle: `background-color: ${fam.hexDark}; border-color: ${fam.hexBorder}; color: #ffffff;`
      };
    }

    // ============================================================================
    // 3. APPLICATION STATE & DAILY LEAVE DATE MANAGEMENT
    // ============================================================================
    function getLocalDateISO(dateObj = new Date()) {
      const y = dateObj.getFullYear();
      const m = String(dateObj.getMonth() + 1).padStart(2, '0');
      const d = String(dateObj.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    function formatThaiDateFull(isoDateStr) {
      if (!isoDateStr) return '';
      const [y, m, d] = isoDateStr.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      return dt.toLocaleDateString('th-TH', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
    }

    function formatThaiDateShort(isoDateStr) {
      if (!isoDateStr) return '';
      const [y, m, d] = isoDateStr.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      return dt.toLocaleDateString('th-TH', { day: 'numeric', month: 'short' });
    }

    function getDayNameShort(isoDateStr) {
      const [y, m, d] = isoDateStr.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      return dt.toLocaleDateString('th-TH', { weekday: 'short' });
    }

    let guildName = "Moonz";
    let fileTimestamp = "ยังไม่มีข้อมูล";
    let selectedDate = getLocalDateISO(); // Active date in YYYY-MM-DD
    let activeLeaveSubView = 'dailyList';
    let members = [];
    let teams = [];
    let parties = [];
    let currentTeamFilter = 'all';
    let activeJobBarFamily = 'all';
    let selectedSource = null;
    let selectedMemberIds = new Set();

    // Ensure every member has a valid `leaveHistory` object without overwriting cancellations
    function ensureLeaveHistoryObject(m) {
      if (!m.leaveHistory || typeof m.leaveHistory !== 'object' || Array.isArray(m.leaveHistory)) {
        m.leaveHistory = {};
      }
    }

    // One-time migration for legacy data loaded from Cloud/CSV that had status='leave' but no leaveHistory
    function migrateLegacyLeaveOnce(m) {
      ensureLeaveHistoryObject(m);
      if (!m._leaveMigrated) {
        if (m.status === 'leave' && Object.keys(m.leaveHistory).length === 0) {
          m.leaveHistory[selectedDate] = {
            status: 'leave',
            type: m.leaveType || 'ลากิลด์วอร์ (GVG)',
            reason: m.leaveReason || 'ติดธุระส่วนตัว',
            updatedAt: new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })
          };
        }
        m._leaveMigrated = true;
      }
    }

    // Strictly derive `m.status`, `m.leaveReason`, `m.leaveType` ONE-WAY from `m.leaveHistory[selectedDate]`
    function syncMembersStatusForSelectedDate() {
      members.forEach(m => {
        ensureLeaveHistoryObject(m);
        const rec = m.leaveHistory[selectedDate];
        if (rec && rec.status !== 'ready') {
          m.status = 'leave';
          m.leaveType = rec.type || 'ลากิลด์วอร์ (GVG)';
          m.leaveReason = rec.reason || 'ติดธุระส่วนตัว';
        } else {
          m.status = 'ready';
          m.leaveType = '';
          m.leaveReason = '';
        }
      });
    }

    function changeSelectedDate(newDateStr) {
      if (!newDateStr) return;
      selectedDate = newDateStr;
      const headerInput = document.getElementById('headerDateInput');
      const leaveInput = document.getElementById('leaveDatePicker');
      const startInput = document.getElementById('leaveFormStartDate');
      const endInput = document.getElementById('leaveFormEndDate');
      if (headerInput) headerInput.value = selectedDate;
      if (leaveInput) leaveInput.value = selectedDate;
      if (startInput) startInput.value = selectedDate;
      if (endInput) endInput.value = selectedDate;

      syncMembersStatusForSelectedDate();
      renderAll();
    }

    function shiftSelectedDate(deltaDays) {
      const [y, m, d] = selectedDate.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      dt.setDate(dt.getDate() + deltaDays);
      changeSelectedDate(getLocalDateISO(dt));
    }

    function setSelectedDateToToday() {
      changeSelectedDate(getLocalDateISO(new Date()));
      showToast(`📅 สลับไปยังข้อมูลวันนี้ (${formatThaiDateFull(selectedDate)})`, 'info');
    }

    function showToast(msg, type = 'info') {
      const container = document.getElementById('toastContainer');
      const el = document.createElement('div');
      const colorClass = type === 'danger'
        ? 'bg-rose-950/95 border-rose-500/50 text-rose-200'
        : (type === 'success' ? 'bg-emerald-950/95 border-emerald-500/50 text-emerald-200' : 'bg-slate-900/95 border-indigo-500/50 text-slate-100');
      el.className = `px-4 py-2.5 rounded-xl border shadow-xl text-xs sm:text-sm font-medium transition-all duration-300 ${colorClass}`;
      el.textContent = msg;
      container.appendChild(el);
      setTimeout(() => {
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 300);
      }, 2800);
    }

    // Custom Dialog Helper (replaces alert, confirm, prompt)
    function openCustomDialog({ title, message, showInput = false, inputType = 'text', defaultInput = '', showColorPicker = false, defaultColor = 'rose', showFieldPicker = false, defaultField = 'main', confirmText = 'ตกลง', cancelText = 'ยกเลิก', hideCancel = false, onConfirm }) {
      const modal = document.getElementById('customDialogModal');
      document.getElementById('dialogTitle').textContent = title || 'แจ้งเตือน';
      document.getElementById('dialogMessage').textContent = message || '';

      const inputWrap = document.getElementById('dialogInputWrapper');
      const inputEl = document.getElementById('dialogInput');
      if (showInput) {
        inputWrap.classList.remove('hidden');
        inputEl.type = inputType;
        inputEl.value = defaultInput;
        setTimeout(() => inputEl.focus(), 60);
      } else {
        inputWrap.classList.add('hidden');
      }

      let pickedField = defaultField || 'main';
      const fieldWrap = document.getElementById('dialogFieldPickerWrapper');
      const fieldOptionsEl = document.getElementById('dialogFieldOptions');
      if (showFieldPicker && fieldWrap && fieldOptionsEl) {
        fieldWrap.classList.remove('hidden');
        const renderFieldBtns = () => {
          fieldOptionsEl.innerHTML = FIELD_ZONES.map(fz => `
            <button type="button" data-field="${fz.key}" class="dialog-field-btn flex items-center justify-center gap-2 p-2.5 rounded-xl border text-xs font-semibold transition ${pickedField === fz.key ? 'border-amber-400 bg-indigo-950/80 text-white ring-2 ring-amber-400/60 shadow' : 'border-slate-700 bg-slate-950 text-slate-400 hover:text-white'}">
              <span>${fz.icon}</span>
              <span>${fz.name}</span>
            </button>
          `).join('');
          fieldOptionsEl.querySelectorAll('.dialog-field-btn').forEach(btn => {
            btn.onclick = () => {
              pickedField = btn.getAttribute('data-field');
              renderFieldBtns();
            };
          });
        };
        renderFieldBtns();
      } else if (fieldWrap) {
        fieldWrap.classList.add('hidden');
      }

      let pickedColor = defaultColor;
      const colorWrap = document.getElementById('dialogColorPickerWrapper');
      const colorOptionsEl = document.getElementById('dialogColorOptions');
      if (showColorPicker) {
        colorWrap.classList.remove('hidden');
        const renderPickerDots = () => {
          colorOptionsEl.innerHTML = Object.values(TEAM_COLORS).map(c => `
            <button type="button" data-color="${c.key}" class="dialog-color-btn flex items-center gap-1.5 px-2.5 py-1 rounded-lg border text-xs transition ${pickedColor === c.key ? 'border-white bg-slate-800 text-white ring-2 ring-indigo-400' : 'border-slate-700 bg-slate-950 text-slate-400 hover:text-white'}">
              <span class="w-3 h-3 rounded-full ${c.dotClass}"></span>
              <span>${c.name}</span>
            </button>
          `).join('');
          colorOptionsEl.querySelectorAll('.dialog-color-btn').forEach(btn => {
            btn.onclick = () => {
              pickedColor = btn.getAttribute('data-color');
              renderPickerDots();
            };
          });
        };
        renderPickerDots();
      } else {
        colorWrap.classList.add('hidden');
      }

      const cancelBtn = document.getElementById('dialogCancelBtn');
      cancelBtn.textContent = cancelText;
      cancelBtn.classList.toggle('hidden', hideCancel);
      cancelBtn.onclick = closeCustomDialog;

      const confirmBtn = document.getElementById('dialogConfirmBtn');
      confirmBtn.textContent = confirmText;
      confirmBtn.onclick = () => {
        const val = inputEl.value;
        closeCustomDialog();
        if (onConfirm) onConfirm(val, pickedColor, pickedField);
      };

      inputEl.onkeydown = (e) => {
        if (e.key === 'Enter') confirmBtn.click();
      };

      modal.classList.remove('hidden');
    }

    function closeCustomDialog() {
      document.getElementById('customDialogModal').classList.add('hidden');
    }

    // Initialize Default Teams: สนามหลัก (ทีม A) & สนามรอง (ทีม B, ทีม C) สามารถสลับสนามได้อิสระ
    function initDefaultTeamsAndParties() {
      teams = [
        { id: 'team_a', name: 'ทีม A', color: 'rose', field: 'main' },
        { id: 'team_b', name: 'ทีม B', color: 'blue', field: 'sub' },
        { id: 'team_c', name: 'ทีม C', color: 'emerald', field: 'sub' }
      ];
      parties = [];
      teams.forEach(t => {
        for (let i = 1; i <= 4; i++) {
          parties.push({
            id: `${t.id}_p${i}_${Math.random().toString(36).slice(2, 6)}`,
            name: `ปาร์ตี้ ${i}`,
            teamId: t.id,
            teamName: t.name,
            teamColor: t.color,
            teamField: t.field,
            raid: t.field,
            slots: [null, null, null, null, null]
          });
        }
      });
    }

    function syncTeamMetadataToParties() {
      teams.forEach(t => {
        if (!t.field || (t.field !== 'main' && t.field !== 'sub')) {
          t.field = t.id === 'team_a' ? 'main' : 'sub';
        }
      });
      parties.forEach(p => {
        let team = teams.find(t => t.id === p.teamId);
        if (!team) {
          team = teams[0] || { id: 'team_a', name: 'ทีม A', color: 'rose', field: 'main' };
          if (!teams.length) teams.push(team);
          p.teamId = team.id;
        }
        p.teamName = team.name;
        p.teamColor = team.color;
        p.teamField = team.field;
        p.raid = team.field;
      });
    }

    function rebuildTeamsFromLoadedParties(loadedParties) {
      if (!Array.isArray(loadedParties) || loadedParties.length === 0) {
        initDefaultTeamsAndParties();
        return;
      }

      const hasTeamMetadata = loadedParties.some(p => p.teamId && p.teamName);
      if (hasTeamMetadata) {
        const teamMap = new Map();
        loadedParties.forEach(p => {
          if (!teamMap.has(p.teamId)) {
            const rawField = p.teamField || p.raid || (p.teamId === 'team_a' ? 'main' : 'sub');
            teamMap.set(p.teamId, {
              id: p.teamId,
              name: p.teamName || 'ทีม A',
              color: p.teamColor || 'rose',
              field: (rawField === 'main' || rawField === 'sub') ? rawField : 'main'
            });
          }
        });
        teams = Array.from(teamMap.values());
        parties = loadedParties.map(p => ({
          ...p,
          slots: Array.isArray(p.slots) ? p.slots : [null, null, null, null, null]
        }));
      } else {
        teams = [
          { id: 'team_a', name: 'ทีม A', color: 'rose', field: 'main' },
          { id: 'team_b', name: 'ทีม B', color: 'blue', field: 'sub' },
          { id: 'team_c', name: 'ทีม C', color: 'emerald', field: 'sub' }
        ];
        parties = loadedParties.map((p, idx) => {
          const teamIdx = Math.min(Math.floor(idx / 3), teams.length - 1);
          const assignedTeam = teams[teamIdx];
          const partyNumInTeam = (idx % 3) + 1;
          return {
            id: p.id || `p_${idx}`,
            name: p.name || `ปาร์ตี้ ${partyNumInTeam}`,
            teamId: assignedTeam.id,
            teamName: assignedTeam.name,
            teamColor: assignedTeam.color,
            teamField: assignedTeam.field,
            raid: assignedTeam.field,
            slots: Array.isArray(p.slots) ? p.slots : [null, null, null, null, null]
          };
        });
      }
      syncTeamMetadataToParties();
    }

    // ============================================================================
    // 4. IMAGE EXPORT (PNG) MODAL & HTML2CANVAS GENERATOR (GROUPED BY สนามหลัก / สนามรอง)
    // ============================================================================
    function openExportImageModal(initialFilter = 'all') {
      syncTeamMetadataToParties();
      syncMembersStatusForSelectedDate();

      const mainTeams = teams.filter(t => t.field === 'main');
      const subTeams = teams.filter(t => t.field === 'sub');

      const selectEl = document.getElementById('exportTeamSelect');
      if (selectEl) {
        selectEl.innerHTML =
          `<option value="all">ทุกสนาม & ทุกทีมทั้งหมด (${teams.length} ทีม)</option>` +
          `<option value="field_main">🏟️ เฉพาะสนามหลัก (${mainTeams.length} ทีม)</option>` +
          `<option value="field_sub">🚩 เฉพาะสนามรอง (${subTeams.length} ทีม)</option>` +
          teams.map(t => `<option value="${t.id}">เฉพาะ ${t.name} (${getFieldZone(t.field).name})</option>`).join('');

        const validValues = new Set(['all', 'field_main', 'field_sub', ...teams.map(t => t.id)]);
        selectEl.value = validValues.has(initialFilter) ? initialFilter : 'all';
      }

      document.getElementById('exportImageModal').classList.remove('hidden');
      renderExportPosterPreview();
    }

    function closeExportImageModal() {
      document.getElementById('exportImageModal').classList.add('hidden');
    }

    function renderExportTeamBlockHtml(team, showGear, showStatus) {
      const theme = getTeamTheme(team.color);
      const fZone = getFieldZone(team.field);
      const teamParties = parties.filter(p => p.teamId === team.id);
      const teamMembers = [];
      teamParties.forEach(p => {
        p.slots.forEach(mId => {
          const m = members.find(x => x.id === mId);
          if (m) teamMembers.push(m);
        });
      });
      const teamAvgGear = teamMembers.length
        ? Math.round(teamMembers.reduce((s, m) => s + m.gear, 0) / teamMembers.length)
        : 0;

      const partyCardsHtml = teamParties.map(p => {
        const presentMembers = p.slots.map(id => members.find(m => m.id === id)).filter(Boolean);
        const avgPartyGear = presentMembers.length
          ? Math.round(presentMembers.reduce((s, m) => s + m.gear, 0) / presentMembers.length)
          : 0;

        const slotsRowsHtml = p.slots.map((mId, sIdx) => {
          const m = members.find(x => x.id === mId);
          if (!m) {
            return `
              <div style="background: rgba(15, 23, 42, 0.55); border: 1px dashed rgba(71, 85, 105, 0.6);" class="h-12 rounded-xl px-3.5 flex items-center justify-between text-xs text-slate-500">
                <span>ช่องว่างที่ ${sIdx + 1}</span>
                <span class="text-[10px] opacity-60">-</span>
              </div>
            `;
          }

          const meta = getJobMeta(m.job);
          const isLeave = m.status === 'leave';

          let statusPill = '';
          if (showStatus) {
            if (isLeave) {
              statusPill = `<span style="background: rgba(244,63,94,0.25); border: 1px solid rgba(244,63,94,0.5); color: #fecdd3;" class="px-1.5 py-0.5 rounded text-[10px] font-semibold whitespace-nowrap">🏖️ ลา: ${m.leaveReason || 'วันนี้'}</span>`;
            } else {
              statusPill = `<span style="color: #6ee7b7;" class="text-[10px] font-medium whitespace-nowrap">● พร้อมวอร์</span>`;
            }
          }

          const gearPill = showGear
            ? `<span style="background: rgba(15,23,42,0.85); border: 1px solid rgba(148,163,184,0.3); color: #fde68a;" class="mono px-2.5 py-1 rounded-lg text-xs font-bold shrink-0">${m.gear.toLocaleString()}</span>`
            : '';

          return `
            <div style="${meta.cardTintStyle}" class="py-2 px-3 rounded-xl border flex items-center justify-between gap-2.5">
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                ${renderJobEmblem(m.job, 34)}
                <div class="min-w-0 flex-1 space-y-1">
                  <div class="flex items-center justify-between gap-2">
                    <span style="${meta.namePillStyle}" class="px-2.5 py-2 rounded-md border font-bold text-2xl truncate ${isLeave ? 'line-through opacity-75' : ''}">${m.name}</span>
                    <span class="mono text-[11px] text-slate-300 font-semibold shrink-0">Lv.${m.lv}</span>
                  </div>
                  <div class="flex items-center justify-between gap-2">
                    <span style="${meta.badgeStyle};align-content: center;align-items: center;align-self: center;" class="px-2 py-2 rounded text-[10px] font-medium border truncate">${m.job}</span>
                    <div class="shrink-0">${statusPill}</div>
                  </div>
                </div>
              </div>
              ${gearPill}
            </div>
          `;
        }).join('');

        return `
          <div style="background: rgba(9, 13, 24, 0.92); border: 1px solid ${theme.hexAccent}66;" class="rounded-2xl p-3.5 flex flex-col gap-2.5">
            <div style="background: ${theme.hexHeaderBg}; border-bottom: 1px solid ${theme.hexAccent}44;" class="-mx-3.5 -mt-3.5 px-4 py-2.5 rounded-t-2xl flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span style="background: ${theme.hexAccent}; color: #ffffff;" class="px-2 py-0.5 rounded text-[11px] font-bold">${team.name}</span>
                <span class="font-bold text-sm text-white">${p.name}</span>
              </div>
              <div class="text-xs text-slate-200">
                ${showGear ? `เฉลี่ย <strong class="mono text-amber-300">${avgPartyGear.toLocaleString()}</strong> • ` : ''}<span>${presentMembers.length}/5 คน</span>
              </div>
            </div>
            <div class="space-y-2">
              ${slotsRowsHtml}
            </div>
          </div>
        `;
      }).join('');

      return `
        <div style="background: ${theme.hexBgSoft}; border: 2px solid ${theme.hexAccent}88;" class="rounded-3xl p-5 space-y-4">
          <div style="background: ${theme.hexHeaderBg}; border: 1px solid ${theme.hexAccent}66;" class="px-5 py-3 rounded-2xl flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span style="background: ${theme.hexAccent};" class="w-4 h-4 rounded-full inline-block"></span>
              <h3 class="text-lg font-bold text-white tracking-wide">${team.name} (สี${theme.name})</h3>
              <span style="background: rgba(15, 23, 42, 0.75); border: 1px solid ${fZone.hexAccent}88; color: #f8fafc;" class="px-2.5 py-0.5 rounded-lg text-xs font-semibold">
                ${fZone.icon} ${fZone.name}
              </span>
            </div>
            <div class="flex items-center gap-3 text-xs text-slate-200 bg-slate-950/75 px-4 py-1.5 rounded-xl border border-slate-800">
              <span>จำนวนปาร์ตี้: <strong class="text-white">${teamParties.length} ตี้</strong></span>
              <span>•</span>
              <span>สมาชิกในทีม: <strong class="text-emerald-400">${teamMembers.length}/${teamParties.length * 5} คน</strong></span>
              ${showGear ? `<span>•</span><span>เฉลี่ย Gear ทีม: <strong class="mono text-amber-300">${teamAvgGear.toLocaleString()}</strong></span>` : ''}
            </div>
          </div>

          <div class="grid grid-cols-4 gap-4">
            ${partyCardsHtml}
          </div>
        </div>
      `;
    }

    function renderExportPosterPreview() {
      syncTeamMetadataToParties();
      syncMembersStatusForSelectedDate();

      const teamFilterVal = document.getElementById('exportTeamSelect')?.value || 'all';
      const posterWidth = parseInt(document.getElementById('exportWidthSelect')?.value || '1680', 10);
      const showGear = document.getElementById('exportOptShowGear')?.checked ?? true;
      const showStatus = document.getElementById('exportOptShowStatus')?.checked ?? true;
      const showLeaveFooter = document.getElementById('exportOptShowLeaveFooter')?.checked ?? true;

      const boardEl = document.getElementById('exportPosterBoard');
      if (!boardEl) return;

      boardEl.style.width = `${posterWidth}px`;
      boardEl.style.minWidth = `${posterWidth}px`;

      const readyCount = members.filter(m => m.status === 'ready').length;
      const leaveList = members.filter(m => m.status === 'leave');
      const assignedSet = getAssignedSet();

      let targetTeams = teams;
      if (teamFilterVal === 'field_main') {
        targetTeams = teams.filter(t => t.field === 'main');
      } else if (teamFilterVal === 'field_sub') {
        targetTeams = teams.filter(t => t.field === 'sub');
      } else if (teamFilterVal !== 'all') {
        targetTeams = teams.filter(t => t.id === teamFilterVal);
      }

      const fieldSectionsHtml = FIELD_ZONES.map(fZone => {
        const fTeams = targetTeams.filter(t => t.field === fZone.key);
        if (fTeams.length === 0) return '';

        const fParties = parties.filter(p => fTeams.some(t => t.id === p.teamId));
        const fMembers = [];
        fParties.forEach(p => {
          p.slots.forEach(mId => {
            const m = members.find(x => x.id === mId);
            if (m) fMembers.push(m);
          });
        });
        const fAvgGear = fMembers.length
          ? Math.round(fMembers.reduce((s, m) => s + m.gear, 0) / fMembers.length)
          : 0;

        const innerTeamsHtml = fTeams.map(t => renderExportTeamBlockHtml(t, showGear, showStatus)).join('');

        return `
          <div style="background: ${fZone.hexBgSoft}; border: 2px solid ${fZone.hexAccent}aa;" class="rounded-[28px] p-6 space-y-5 shadow-2xl">
            <div style="background: ${fZone.hexHeaderBg}; border: 1px solid ${fZone.hexAccent}88;" class="px-6 py-4 rounded-2xl flex items-center justify-between">
              <div class="flex items-center gap-3.5">
                <span class="text-2xl">${fZone.icon}</span>
                <div>
                  <div class="flex items-center gap-2.5">
                    <h2 class="text-xl font-bold text-white tracking-wide">${fZone.fullName}</h2>
                    <span style="background: ${fZone.hexAccent}; color: #090d16;" class="px-2.5 py-0.5 rounded-full text-xs font-extrabold">
                      ครอบคลุม ${fTeams.length} ทีม (${fTeams.map(t => t.name).join(', ')})
                    </span>
                  </div>
                  <p class="text-xs text-slate-300 mt-0.5">${fZone.subtitle}</p>
                </div>
              </div>
              <div class="flex items-center gap-3 text-xs text-slate-200 bg-slate-950/80 px-4 py-2 rounded-xl border border-slate-800">
                <span>ทีมใน${fZone.name}: <strong class="text-white">${fTeams.length} ทีม</strong></span>
                <span>•</span>
                <span>ปาร์ตี้รวม: <strong class="text-white">${fParties.length} ตี้</strong></span>
                <span>•</span>
                <span>สมาชิกใน${fZone.name}: <strong class="text-emerald-400">${fMembers.length}/${fParties.length * 5} คน</strong></span>
                ${showGear ? `<span>•</span><span>เฉลี่ย Gear ${fZone.name}: <strong class="mono text-amber-300">${fAvgGear.toLocaleString()}</strong></span>` : ''}
              </div>
            </div>
            <div class="space-y-5">
              ${innerTeamsHtml}
            </div>
          </div>
        `;
      }).filter(Boolean).join('');

      let leaveFooterHtml = '';
      if (showLeaveFooter && leaveList.length > 0) {
        const leaveChips = leaveList.map(m => {
          const pInfo = findMemberPartyInfo(m.id);
          const teamTag = pInfo ? `[${pInfo.fieldZone.name}•${pInfo.team.name}-${pInfo.party.name}]` : '';
          return `
            <span style="background: rgba(136, 19, 55, 0.35); border: 1px solid rgba(244, 63, 94, 0.45);" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs text-rose-200">
              ${renderJobEmblem(m.job, 20)}
              <strong class="text-white">${m.name}</strong>
              <span class="text-rose-300 text-[11px]">${teamTag} (${m.leaveReason || 'แจ้งลา'})</span>
            </span>
          `;
        }).join('');

        leaveFooterHtml = `
          <div style="background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(244, 63, 94, 0.4);" class="rounded-2xl p-4 space-y-2">
            <div class="text-xs font-bold text-rose-300 flex items-center gap-2">
              <span>🏖️ รายชื่อสมาชิกที่แจ้งลาประจำวันที่ ${formatThaiDateFull(selectedDate)} (${leaveList.length} คน):</span>
            </div>
            <div class="flex flex-wrap gap-2">
              ${leaveChips}
            </div>
          </div>
        `;
      }

      boardEl.innerHTML = `
        <div style="background: linear-gradient(90deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.95) 100%);" class="rounded-2xl border border-slate-700 p-5 flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div style="background: linear-gradient(135deg, #f59e0b 0%, #e11d48 100%);" class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl font-bold text-white shadow-lg">
              ⚔️
            </div>
            <div>
              <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-white tracking-wide">ผังทัพกิลด์วอร์ (สนามหลัก & สนามรอง) — ${guildName}</h1>
                <span style="background: rgba(99, 102, 241, 0.2); border: 1px solid rgba(99, 102, 241, 0.5); color: #c7d2fe;" class="px-3 py-0.5 rounded-full text-xs font-semibold">
                  📅 ประจำวันที่ ${formatThaiDateFull(selectedDate)}
                </span>
              </div>
              <p class="text-xs text-slate-400 mt-1">RO Guild Tactical Lineup & Field Assignment (Main / Sub Field) • อัปเดตข้อมูล: ${fileTimestamp}</p>
            </div>
          </div>

          <div class="flex items-center gap-3 text-xs">
            <div class="bg-slate-900 border border-slate-700 rounded-xl px-4 py-2 text-center">
              <div class="text-[10px] text-slate-400">สมาชิกทั้งหมด</div>
              <div class="mono font-bold text-base text-white">${members.length} คน</div>
            </div>
            <div class="bg-slate-900 border border-emerald-500/40 rounded-xl px-4 py-2 text-center">
              <div class="text-[10px] text-emerald-300">พร้อมวอร์วันนี้</div>
              <div class="mono font-bold text-base text-emerald-400">${readyCount} คน</div>
            </div>
            <div class="bg-slate-900 border border-rose-500/40 rounded-xl px-4 py-2 text-center">
              <div class="text-[10px] text-rose-300">แจ้งลาวันนี้</div>
              <div class="mono font-bold text-base text-rose-400">${leaveList.length} คน</div>
            </div>
            <div class="bg-slate-900 border border-amber-500/40 rounded-xl px-4 py-2 text-center">
              <div class="text-[10px] text-amber-300">จัดลงปาร์ตี้แล้ว</div>
              <div class="mono font-bold text-base text-amber-400">${assignedSet.size} คน</div>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          ${fieldSectionsHtml}
        </div>

        ${leaveFooterHtml}
      `;
    }

    async function generatePosterCanvas() {
      const boardEl = document.getElementById('exportPosterBoard');
      if (!boardEl || typeof html2canvas === 'undefined') {
        throw new Error('ไม่พบไลบรารีสร้างรูปภาพ');
      }
      const posterWidth = parseInt(document.getElementById('exportWidthSelect')?.value || '1680', 10);
      return await html2canvas(boardEl, {
        scale: 2,
        backgroundColor: '#0b0f19',
        useCORS: true,
        logging: false,
        width: posterWidth,
        windowWidth: posterWidth + 200
      });
    }

    async function downloadExportedTeamImage() {
      const btn = document.getElementById('btnDownloadExportImg');
      const origHtml = btn ? btn.innerHTML : '';
      try {
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = `<span>⏳ กำลังสร้างรูปภาพ...</span>`;
        }
        showToast('📸 กำลังประมวลผลรูปภาพผังทัพความละเอียดสูง...', 'info');

        const canvas = await generatePosterCanvas();
        const dataUrl = canvas.toDataURL('image/png');

        const selectEl = document.getElementById('exportTeamSelect');
        const filterVal = selectEl ? selectEl.value : 'all';
        let teamSuffix = '_ทุกสนาม';
        if (filterVal === 'field_main') teamSuffix = '_สนามหลัก';
        else if (filterVal === 'field_sub') teamSuffix = '_สนามรอง';
        else {
          const teamObj = teams.find(t => t.id === filterVal);
          if (teamObj) teamSuffix = `_${teamObj.name.replace(/\s+/g, '')}`;
        }

        const a = document.createElement('a');
        a.href = dataUrl;
        a.download = `ผังทัพ_${guildName.replace(/\s+/g, '')}${teamSuffix}_${selectedDate}.png`;
        document.body.appendChild(a);
        a.click();
        a.remove();

        showToast('✅ ดาวน์โหลดรูปภาพผังทัพ (.PNG) สำเร็จแล้ว!', 'success');
      } catch (err) {
        console.error('Export Image Error:', err);
        showToast('เกิดข้อผิดพลาดในการสร้างรูปภาพ กรุณาลองใหม่อีกครั้ง', 'danger');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origHtml;
        }
      }
    }

    // ============================================================================
    // 5. DAILY LEAVE RECORDING SYSTEM FUNCTIONS & AUTO-DATABASE SAVE
    // ============================================================================
    function getDatesBetween(startIso, endIso) {
      const dates = [];
      const [sy, sm, sd] = startIso.split('-').map(Number);
      const [ey, em, ed] = endIso.split('-').map(Number);
      const cur = new Date(sy, sm - 1, sd);
      const last = new Date(ey, em - 1, ed);
      if (last < cur) return [startIso];

      let safety = 0;
      while (cur <= last && safety < 60) {
        dates.push(getLocalDateISO(cur));
        cur.setDate(cur.getDate() + 1);
        safety++;
      }
      return dates;
    }

    function syncLeaveEndDateMin() {
      const startEl = document.getElementById('leaveFormStartDate');
      const endEl = document.getElementById('leaveFormEndDate');
      if (!startEl || !endEl) return;
      if (endEl.value < startEl.value) {
        endEl.value = startEl.value;
      }
    }

    function setLeaveFormSingleDay() {
      const startEl = document.getElementById('leaveFormStartDate');
      const endEl = document.getElementById('leaveFormEndDate');
      if (startEl && endEl) {
        endEl.value = startEl.value || selectedDate;
      }
    }

    function setQuickLeaveReason(reasonText) {
      const input = document.getElementById('leaveFormReasonInput');
      if (input) input.value = reasonText;
    }

    function updateLeaveTypeRadioStyles() {
      const radios = document.querySelectorAll('input[name="leaveTypeRadio"]');
      radios.forEach(r => {
        const label = r.closest('label');
        if (!label) return;
        if (r.checked) {
          label.className = 'cursor-pointer flex items-center gap-2 p-2.5 rounded-xl border border-amber-400/70 bg-amber-500/15 text-white text-xs font-semibold transition shadow';
        } else {
          label.className = 'cursor-pointer flex items-center gap-2 p-2.5 rounded-xl border border-slate-800 bg-slate-950 text-slate-300 text-xs font-medium transition hover:border-slate-700';
        }
      });
    }

    function populateLeaveMemberSelect() {
      const select = document.getElementById('leaveFormMemberSelect');
      if (!select) return;
      const q = (document.getElementById('leaveFormMemberSearch')?.value || '').trim().toLowerCase();
      const prevVal = select.value;

      const filtered = members
        .filter(m => !q || m.name.toLowerCase().includes(q) || m.job.toLowerCase().includes(q))
        .sort((a, b) => a.name.localeCompare(b.name, 'th'));

      if (filtered.length === 0) {
        select.innerHTML = `<option value="" disabled>ไม่พบรายชื่อสมาชิก (${members.length === 0 ? 'กรุณานำเข้าหรือเพิ่มสมาชิกก่อน' : 'ลองค้นหาคำอื่น'})</option>`;
        return;
      }

      select.innerHTML = filtered.map((m, idx) => {
        const pInfo = findMemberPartyInfo(m.id);
        const teamText = pInfo ? `${pInfo.team.name} • ${pInfo.party.name}` : 'ยังไม่ลงตี้';
        const hasLeaveOnSelected = m.leaveHistory && m.leaveHistory[selectedDate];
        const statusMark = hasLeaveOnSelected ? '🏖️ (ลาวันนี้)' : '✅';
        const isSelected = prevVal ? (m.id === prevVal) : (idx === 0);
        return `<option value="${m.id}" ${isSelected ? 'selected' : ''} class="py-1 px-2 rounded hover:bg-slate-800">${statusMark} ${m.name} — ${m.job} [${teamText}]</option>`;
      }).join('');
    }

    async function submitDailyLeaveForm() {
      if (members.length === 0) {
        showToast('กรุณาเพิ่มสมาชิกหรือนำเข้าไฟล์ CSV ก่อนบันทึกการลาครับ', 'danger');
        return;
      }
      const memberId = document.getElementById('leaveFormMemberSelect')?.value;
      const member = members.find(m => String(m.id) === String(memberId));
      if (!member) {
        showToast('กรุณาคลิกเลือกสมาชิกที่ต้องการแจ้งลาจากรายการก่อนครับ', 'danger');
        return;
      }

      const startIso = document.getElementById('leaveFormStartDate')?.value || selectedDate;
      const endIso = document.getElementById('leaveFormEndDate')?.value || startIso;
      const checkedRadio = document.querySelector('input[name="leaveTypeRadio"]:checked');
      const leaveType = checkedRadio ? checkedRadio.value : 'ลากิลด์วอร์ (GVG)';
      const reasonInput = document.getElementById('leaveFormReasonInput');
      const leaveReason = (reasonInput?.value || '').trim() || 'ติดธุระส่วนตัว';

      const targetDates = getDatesBetween(startIso, endIso);
      const nowStamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });

      ensureLeaveHistoryObject(member);
      member._leaveMigrated = true;
      targetDates.forEach(dStr => {
        member.leaveHistory[dStr] = {
          status: 'leave',
          type: leaveType,
          reason: leaveReason,
          updatedAt: nowStamp
        };
      });

      selectedDate = startIso;
      document.getElementById('headerDateInput').value = selectedDate;
      document.getElementById('leaveDatePicker').value = selectedDate;
      if (reasonInput) reasonInput.value = '';

      syncMembersStatusForSelectedDate();
      renderAll();

      const dayRangeMsg = targetDates.length > 1
        ? `${targetDates.length} วัน (${formatThaiDateShort(startIso)} - ${formatThaiDateShort(endIso)})`
        : `วันที่ ${formatThaiDateFull(startIso)}`;

      showToast(`🏖️ บันทึกการลาของ "${member.name}" (${dayRangeMsg}) แล้ว กำลังซิงค์ลง Database...`, 'success');
      await saveLeaveToDatabaseSilent(`บันทึกการลา: ${member.name}`);
    }

    async function setMemberDailyLeaveQuick(memberId, dateStr, leaveType, defaultReason = 'แจ้งลาด่วน') {
      const targetDate = dateStr || selectedDate;
      const m = members.find(x => String(x.id) === String(memberId));
      if (!m) return;
      ensureLeaveHistoryObject(m);
      m._leaveMigrated = true;

      if (!leaveType || leaveType === 'ready') {
        delete m.leaveHistory[targetDate];
        if (targetDate === selectedDate) {
          m.status = 'ready';
          m.leaveReason = '';
          m.leaveType = '';
        }
        syncMembersStatusForSelectedDate();
        renderAll();
        showToast(`✅ ตั้งสถานะ "${m.name}" เป็นพร้อมวอร์ (${formatThaiDateShort(targetDate)})`, 'success');
        await saveLeaveToDatabaseSilent(`ยกเลิกการลา: ${m.name}`);
      } else {
        const existingReason = m.leaveHistory[targetDate]?.reason;
        m.leaveHistory[targetDate] = {
          status: 'leave',
          type: leaveType,
          reason: existingReason || defaultReason,
          updatedAt: new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })
        };
        syncMembersStatusForSelectedDate();
        renderAll();
        showToast(`🏖️ บันทึก "${m.name}" เป็น "${leaveType}" (${formatThaiDateShort(targetDate)})`, 'info');
        await saveLeaveToDatabaseSilent(`อัปเดตการลา: ${m.name}`);
      }
    }

    function editMemberDailyLeaveReason(memberId, dateStr) {
      const targetDate = dateStr || selectedDate;
      const m = members.find(x => String(x.id) === String(memberId));
      if (!m) return;
      ensureLeaveHistoryObject(m);
      const rec = m.leaveHistory[targetDate] || { type: 'ลากิลด์วอร์ (GVG)', reason: '' };

      const searchEl = document.getElementById('leaveFormMemberSearch');
      if (searchEl) searchEl.value = '';
      populateLeaveMemberSelect();
      const selectEl = document.getElementById('leaveFormMemberSelect');
      if (selectEl) selectEl.value = m.id;
      const startEl = document.getElementById('leaveFormStartDate');
      const endEl = document.getElementById('leaveFormEndDate');
      if (startEl) startEl.value = targetDate;
      if (endEl) endEl.value = targetDate;
      const radios = document.querySelectorAll('input[name="leaveTypeRadio"]');
      radios.forEach(r => { r.checked = (r.value === rec.type); });
      updateLeaveTypeRadioStyles();
      const reasonInput = document.getElementById('leaveFormReasonInput');
      if (reasonInput) reasonInput.value = rec.reason || '';

      openCustomDialog({
        title: `✏️ แก้ไขเหตุผลการลา (${formatThaiDateFull(targetDate)})`,
        message: `สมาชิก: ${m.name} (${m.job})\nประเภท: ${rec.type}\nระบุเหตุผลการลาใหม่:`,
        showInput: true,
        defaultInput: rec.reason || '',
        confirmText: '💾 บันทึกการแก้ไข',
        onConfirm: async (newReason) => {
          m.leaveHistory[targetDate] = {
            status: 'leave',
            type: rec.type,
            reason: (newReason || '').trim() || 'ติดธุระส่วนตัว',
            updatedAt: new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })
          };
          syncMembersStatusForSelectedDate();
          renderAll();
          showToast(`✏️ อัปเดตเหตุผลการลาของ "${m.name}" แล้ว`, 'success');
          await saveLeaveToDatabaseSilent(`แก้ไขการลา: ${m.name}`);
        }
      });
    }

    async function removeMemberLeaveOnDate(memberId, dateStr) {
      const targetDate = dateStr || selectedDate;
      const m = members.find(x => String(x.id) === String(memberId));
      if (!m) return;

      ensureLeaveHistoryObject(m);
      m._leaveMigrated = true;

      delete m.leaveHistory[targetDate];
      if (targetDate === selectedDate) {
        m.status = 'ready';
        m.leaveReason = '';
        m.leaveType = '';
      }

      syncMembersStatusForSelectedDate();
      renderAll();
      showToast(`✅ ยกเลิกการลาของ "${m.name}" ในวันที่ ${formatThaiDateShort(targetDate)} เปลี่ยนเป็นพร้อมวอร์แล้ว`, 'success');
      await saveLeaveToDatabaseSilent(`ยกเลิกการลา: ${m.name}`);
    }

    function clearMemberAllLeaveHistory(memberId) {
      const m = members.find(x => String(x.id) === String(memberId));
      if (!m) return;
      const count = m.leaveHistory ? Object.keys(m.leaveHistory).length : 0;
      if (count === 0) return;

      openCustomDialog({
        title: `🗑️ ล้างประวัติการลาทั้งหมดของ "${m.name}"`,
        message: `ต้องการลบประวัติการลาสะสมทั้งหมด ${count} วัน ของ "${m.name}" ออกจากฐานข้อมูลใช่หรือไม่?`,
        confirmText: 'ล้างประวัติการลา',
        onConfirm: async () => {
          m.leaveHistory = {};
          m._leaveMigrated = true;
          m.status = 'ready';
          m.leaveReason = '';
          m.leaveType = '';
          syncMembersStatusForSelectedDate();
          renderAll();
          showToast(`🗑️ ล้างประวัติการลาของ "${m.name}" เรียบร้อยแล้ว`, 'danger');
          await saveLeaveToDatabaseSilent(`ล้างประวัติการลา: ${m.name}`);
        }
      });
    }

    function clearAllLeaveForSelectedDate() {
      openCustomDialog({
        title: `✅ ตั้งทุกคนพร้อมวอร์ในวันที่ ${formatThaiDateFull(selectedDate)}`,
        message: `ต้องการยกเลิกรายการลาทั้งหมดของวันที่ ${formatThaiDateFull(selectedDate)} และตั้งให้ทุกคนพร้อมวอร์ใช่หรือไม่?`,
        confirmText: 'ตั้งทุกคนพร้อมวอร์วันนี้',
        onConfirm: async () => {
          members.forEach(m => {
            ensureLeaveHistoryObject(m);
            m._leaveMigrated = true;
            if (m.leaveHistory[selectedDate]) {
              delete m.leaveHistory[selectedDate];
            }
            m.status = 'ready';
            m.leaveReason = '';
            m.leaveType = '';
          });
          syncMembersStatusForSelectedDate();
          renderAll();
          showToast(`✅ ตั้งสมาชิกทุกคนพร้อมวอร์สำหรับวันที่ ${formatThaiDateShort(selectedDate)} แล้ว`, 'success');
          await saveLeaveToDatabaseSilent(`รีเซ็ตการลาประจำวันที่ ${selectedDate}`);
        }
      });
    }

    function switchLeaveSubView(viewName) {
      activeLeaveSubView = viewName;
      ['dailyList', 'quickCheckin', 'statsHistory'].forEach(v => {
        const el = document.getElementById('leaveSubView-' + v);
        const btn = document.getElementById('leaveSubBtn-' + v);
        if (el) el.classList.toggle('hidden', v !== viewName);
        if (btn) {
          btn.className = v === viewName
            ? 'px-3 py-1.5 rounded-xl text-xs font-semibold bg-rose-600 text-white transition shadow'
            : 'px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white transition';
        }
      });
      renderLeaveSection();
    }

    function getLeaveTypeBadgeHtml(typeStr) {
      const t = typeStr || 'ลากิลด์วอร์ (GVG)';
      if (t.includes('ลาศึกชิงปราสาท')) {
        return `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">🕒 ${t}</span>`;
      }
      if (t.includes('กิจกรรม')) {
        return `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/40">🏰 ${t}</span>`;
      }
      if (t.includes('ทั้งวัน')) {
        return `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-sky-500/20 text-sky-300 border border-sky-500/40">📋 ${t}</span>`;
      }
      return `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40">⚔️ ${t}</span>`;
    }

    function renderLeaveCalendarStrip() {
      const strip = document.getElementById('leaveCalendarStrip');
      if (!strip) return;

      const [y, m, d] = selectedDate.split('-').map(Number);
      const centerDate = new Date(y, m - 1, d);
      const todayIso = getLocalDateISO(new Date());

      const daysHtml = [];
      for (let offset = -2; offset <= 4; offset++) {
        const dt = new Date(centerDate);
        dt.setDate(dt.getDate() + offset);
        const iso = getLocalDateISO(dt);
        const isSelected = iso === selectedDate;
        const isToday = iso === todayIso;

        const leaveCount = members.filter(mem => mem.leaveHistory && mem.leaveHistory[iso]).length;

        const cardStyle = isSelected
          ? 'bg-gradient-to-b from-indigo-600/40 to-slate-900 border-indigo-400 ring-2 ring-indigo-500/40 text-white'
          : 'bg-slate-950/90 hover:bg-slate-800/80 border-slate-800 text-slate-300';

        daysHtml.push(`
          <button onclick="changeSelectedDate('${iso}')" class="p-2.5 rounded-xl border text-left transition flex flex-col justify-between ${cardStyle}">
            <div class="flex items-center justify-between w-full">
              <span class="text-[11px] font-semibold ${isSelected ? 'text-indigo-200' : 'text-slate-400'}">${getDayNameShort(iso)}</span>
              ${isToday ? `<span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">วันนี้</span>` : ''}
            </div>
            <div class="my-1 font-bold text-xs sm:text-sm text-white">${formatThaiDateShort(iso)}</div>
            <div class="flex items-center justify-between w-full pt-1 border-t border-slate-800/80">
              <span class="text-[10px] text-slate-400">แจ้งลา:</span>
              <span class="mono px-1.5 py-0.2 rounded-full text-[10px] font-bold ${leaveCount > 0 ? 'bg-rose-500/25 text-rose-300 border border-rose-500/40' : 'bg-slate-800 text-slate-500'}">
                ${leaveCount} คน
              </span>
            </div>
          </button>
        `);
      }
      strip.innerHTML = daysHtml.join('');
    }

    function renderLeaveSection() {
      const badgeEl = document.getElementById('leaveTabDateThaiBadge');
      if (badgeEl) badgeEl.textContent = `📅 ${formatThaiDateFull(selectedDate)}`;

      const headerInput = document.getElementById('headerDateInput');
      const leaveInput = document.getElementById('leaveDatePicker');
      if (headerInput && headerInput.value !== selectedDate) headerInput.value = selectedDate;
      if (leaveInput && leaveInput.value !== selectedDate) leaveInput.value = selectedDate;

      renderLeaveCalendarStrip();
      populateLeaveMemberSelect();

      const onLeaveList = members.filter(m => m.leaveHistory && m.leaveHistory[selectedDate]);
      const readyCount = members.length - onLeaveList.length;
      const absentCount = onLeaveList.filter(m => {
        const t = m.leaveHistory[selectedDate]?.type || '';
        return t.includes('กิลด์วอร์') || t.includes('ทั้งวัน');
      }).length;
      const lateOrEventCount = onLeaveList.length - absentCount;
      const assignedSet = getAssignedSet();
      const inPartyLeaveCount = onLeaveList.filter(m => assignedSet.has(m.id)).length;

      document.getElementById('leaveStatReadyDay').textContent = `${readyCount} คน`;
      document.getElementById('leaveStatAbsentDay').textContent = `${absentCount} คน`;
      document.getElementById('leaveStatLateDay').textContent = `${lateOrEventCount} คน`;
      document.getElementById('leaveStatInPartyDay').textContent = `${inPartyLeaveCount} คน`;
      document.getElementById('leaveDailyCountLabel').textContent = onLeaveList.length;

      const btnClearAllDaily = document.getElementById('btnClearAllDailyLeave');
      if (btnClearAllDaily) {
        btnClearAllDaily.classList.toggle('hidden', onLeaveList.length === 0);
      }

      const dailyContainer = document.getElementById('dailyLeaveCardsContainer');
      if (dailyContainer) {
        if (onLeaveList.length === 0) {
          dailyContainer.innerHTML = `
            <div class="py-12 text-center space-y-2 border border-dashed border-slate-800 rounded-2xl">
              <div class="text-2xl">🎉</div>
              <div class="text-sm font-semibold text-emerald-400">ไม่มีสมาชิกแจ้งลาในวันที่ ${formatThaiDateFull(selectedDate)}</div>
              <div class="text-xs text-slate-400">สมาชิกทุกคนพร้อมเข้าร่วมกิลด์วอร์และกิจกรรมกิลด์ หรือสามารถบันทึกการลาได้ที่ฟอร์มด้านซ้าย</div>
            </div>
          `;
        } else {
          dailyContainer.innerHTML = onLeaveList.map(m => {
            const rec = m.leaveHistory[selectedDate];
            const meta = getJobMeta(m.job);
            const pInfo = findMemberPartyInfo(m.id);
            let partyHtml = `<span class="px-2 py-0.5 rounded text-[10px] bg-slate-800 text-slate-400">ไม่ได้ลงตี้</span>`;
            if (pInfo) {
              const tTheme = getTeamTheme(pInfo.team.color);
              partyHtml = `<span class="px-2 py-0.5 rounded text-[10px] font-semibold border ${tTheme.badgeClass}">${pInfo.team.name} • ${pInfo.party.name}</span>`;
            }

            return `
              <div style="${meta.cardTintStyle}" class="p-3.5 rounded-2xl border flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  ${renderJobEmblem(m.job, 38)}
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span style="${meta.namePillStyle}" class="px-2.5 py-0.5 rounded-lg border font-bold text-xs">${m.name}</span>
                      <span style="${meta.badgeStyle}" class="px-2 py-0.5 rounded text-[10px] font-medium border">${m.job}</span>
                      ${partyHtml}
                      ${getLeaveTypeBadgeHtml(rec.type)}
                    </div>
                    <div class="text-xs text-slate-200 mt-1.5 flex items-center gap-2 flex-wrap">
                      <span>💬 เหตุผล: <strong class="text-amber-300">${rec.reason || 'ไม่ระบุ'}</strong></span>
                      ${rec.updatedAt ? `<span class="text-[10px] text-slate-400">(บันทึกเมื่อ ${rec.updatedAt})</span>` : ''}
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-1.5 shrink-0">
                  <button onclick="editMemberDailyLeaveReason('${m.id}', '${selectedDate}')" class="px-2.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs border border-slate-700 transition">
                    ✏️ แก้ไข
                  </button>
                  <button onclick="removeMemberLeaveOnDate('${m.id}', '${selectedDate}')" class="px-2.5 py-1.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/35 text-emerald-300 border border-emerald-500/30 text-xs font-semibold transition">
                    ✅ ยกเลิกการลาวันนี้
                  </button>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      if (activeLeaveSubView === 'quickCheckin') {
        renderLeaveQuickCheckin();
      } else if (activeLeaveSubView === 'statsHistory') {
        renderLeaveStatsTable();
      }
    }

    function renderLeaveQuickCheckin() {
      const container = document.getElementById('quickCheckinListContainer');
      if (!container) return;
      const q = (document.getElementById('quickCheckinSearch')?.value || '').trim().toLowerCase();

      const filtered = members.filter(m => {
        if (activeJobBarFamily !== 'all' && getJobFamily(m.job).familyKey !== activeJobBarFamily) return false;
        if (!q) return true;
        const pInfo = findMemberPartyInfo(m.id);
        const teamStr = pInfo ? `${pInfo.team.name} ${pInfo.party.name}`.toLowerCase() : '';
        return m.name.toLowerCase().includes(q) || m.job.toLowerCase().includes(q) || teamStr.includes(q);
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="py-8 text-center text-xs text-slate-500">ไม่พบรายชื่อสมาชิกที่ค้นหา</div>`;
        return;
      }

      container.innerHTML = filtered.map(m => {
        const rec = m.leaveHistory ? m.leaveHistory[selectedDate] : null;
        const curType = rec ? rec.type : 'ready';
        const pInfo = findMemberPartyInfo(m.id);
        const teamBadge = pInfo
          ? `<span class="px-2 py-0.5 rounded text-[10px] font-semibold border ${getTeamTheme(pInfo.team.color).badgeClass}">${pInfo.team.name} • ${pInfo.party.name}</span>`
          : `<span class="text-[10px] text-slate-500">ยังไม่ลงตี้</span>`;

        const btnReadyClass = curType === 'ready'
          ? 'bg-emerald-600 text-white font-bold shadow'
          : 'bg-slate-900 hover:bg-slate-800 text-slate-400 border border-slate-800';
        const btnGvgClass = curType.includes('กิลด์วอร์')
          ? 'bg-rose-600 text-white font-bold shadow'
          : 'bg-slate-900 hover:bg-slate-800 text-slate-400 border border-slate-800';
        const btnLateClass = curType.includes('ลาศึกชิงปราสาท')
          ? 'bg-amber-500 text-slate-950 font-bold shadow'
          : 'bg-slate-900 hover:bg-slate-800 text-slate-400 border border-slate-800';
        const btnFullClass = curType.includes('ทั้งวัน')
          ? 'bg-sky-600 text-white font-bold shadow'
          : 'bg-slate-900 hover:bg-slate-800 text-slate-400 border border-slate-800';

        return `
          <div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90 flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2.5 min-w-0">
              ${renderJobEmblem(m.job, 30)}
              <div class="min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                  ${renderColoredMemberName(m)}
                  <span class="text-[11px] text-slate-400">${m.job}</span>
                  ${teamBadge}
                </div>
                ${rec ? `<div class="text-[11px] text-rose-300 mt-0.5">เหตุผล: ${rec.reason}</div>` : ''}
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-1">
              <button onclick="setMemberDailyLeaveQuick('${m.id}', '${selectedDate}', 'ready')" class="px-2.5 py-1 rounded-lg text-[11px] transition ${btnReadyClass}">
                ✅ พร้อมวอร์
              </button>
              <button onclick="setMemberDailyLeaveQuick('${m.id}', '${selectedDate}', 'ลากิลด์วอร์ (GVG)', 'ลากิลด์วอร์ (GVG)')" class="px-2.5 py-1 rounded-lg text-[11px] transition ${btnGvgClass}">
                ⚔️ ลากิลด์วอร์
              </button>
              <button onclick="setMemberDailyLeaveQuick('${m.id}', '${selectedDate}', 'ลาศึกชิงปราสาท', 'ลาศึกชิงปราสาท')" class="px-2.5 py-1 rounded-lg text-[11px] transition ${btnLateClass}">
                🕒 ลาศึกชิงปราสาท
              </button>
              <button onclick="setMemberDailyLeaveQuick('${m.id}', '${selectedDate}', 'ลาทั้งวัน (ไม่เข้าเกม)', 'ไม่สะดวกเข้าเกม')" class="px-2.5 py-1 rounded-lg text-[11px] transition ${btnFullClass}">
                📋 ลาทั้งวัน
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function getMemberWeeklyEventSummaryAllWeeks(m) {
      let joined = 0, leave = 0, absent = 0;
      if (m.weeklyEvents && typeof m.weeklyEvents === 'object') {
        Object.keys(m.weeklyEvents).forEach(wKey => {
          const wObj = m.weeklyEvents[wKey];
          if (!wObj || typeof wObj !== 'object') return;
          WEEKLY_EVENTS_CONFIG.forEach(ev => {
            const st = getMemberEventRecord(m, wKey, ev.key).status;
            if (st === 'joined') joined++;
            else if (st === 'leave') leave++;
            else if (st === 'absent') absent++;
          });
        });
      }
      return { joined, leave, absent, leaveAndAbsent: leave + absent };
    }

    function renderLeaveStatsTable() {
      const tbody = document.getElementById('leaveStatsTableBody');
      if (!tbody) return;
      const q = (document.getElementById('leaveStatsSearch')?.value || '').trim().toLowerCase();
      const sortMode = document.getElementById('leaveStatsSortSelect')?.value || 'daily_desc';

      const rowsData = members
        .filter(m => !q || m.name.toLowerCase().includes(q) || m.job.toLowerCase().includes(q))
        .map(m => {
          ensureLeaveHistoryObject(m);
          const dates = Object.keys(m.leaveHistory).sort().reverse();
          const evSummary = getMemberWeeklyEventSummaryAllWeeks(m);
          return {
            member: m,
            dates,
            count: dates.length,
            evSummary
          };
        })
        .sort((a, b) => {
          if (sortMode === 'event_leave_absent_desc') {
            return b.evSummary.leaveAndAbsent - a.evSummary.leaveAndAbsent || b.count - a.count || b.member.gear - a.member.gear;
          }
          if (sortMode === 'event_absent_desc') {
            return b.evSummary.absent - a.evSummary.absent || b.evSummary.leave - a.evSummary.leave || b.count - a.count;
          }
          if (sortMode === 'total_all_desc') {
            return (b.count + b.evSummary.leaveAndAbsent) - (a.count + a.evSummary.leaveAndAbsent) || b.member.gear - a.member.gear;
          }
          return b.count - a.count || b.evSummary.leaveAndAbsent - a.evSummary.leaveAndAbsent || b.member.gear - a.member.gear;
        });

      if (rowsData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-500">ไม่พบข้อมูลสมาชิก</td></tr>`;
        return;
      }

      tbody.innerHTML = rowsData.map(({ member: m, dates, count, evSummary }) => {
        const pInfo = findMemberPartyInfo(m.id);
        const teamHtml = pInfo
          ? `<span class="px-2 py-0.5 rounded text-[10px] font-semibold border ${getTeamTheme(pInfo.team.color).badgeClass}">${pInfo.team.name} • ${pInfo.party.name}</span>`
          : `<span class="text-slate-500 text-[11px]">-</span>`;

        const historyPills = dates.length
          ? dates.map(dStr => {
              const r = m.leaveHistory[dStr];
              return `
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-slate-900 border border-slate-700 text-[11px] text-slate-200 mr-1 mb-1">
                  <span onclick="changeSelectedDate('${dStr}')" title="คลิกเพื่อสลับไปดูวันที่ ${formatThaiDateFull(dStr)}" class="cursor-pointer hover:underline">
                    <strong class="mono text-amber-300">${formatThaiDateShort(dStr)}</strong>
                    <span class="text-slate-400">(${r.reason || r.type})</span>
                  </span>
                  <button onclick="removeMemberLeaveOnDate('${m.id}', '${dStr}')" title="ยกเลิกการลาของวันที่ ${formatThaiDateShort(dStr)}" class="text-rose-400 hover:text-rose-200 font-bold px-1 rounded hover:bg-rose-500/20 transition">✕</button>
                </span>
              `;
            }).join('')
          : `<span class="text-slate-500 text-[11px]">ไม่เคยลารายวัน (เข้าครบทุกวัน)</span>`;

        const evStatsBadge = `
          <div class="inline-flex items-center gap-1.5 flex-wrap justify-center">
            <span class="mono px-2 py-0.5 rounded-md text-[11px] font-semibold ${evSummary.leave > 0 ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-slate-900 text-slate-500 border border-slate-800'}">
              🏖️ ลา: ${evSummary.leave}
            </span>
            <span class="mono px-2 py-0.5 rounded-md text-[11px] font-semibold ${evSummary.absent > 0 ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' : 'bg-slate-900 text-slate-500 border border-slate-800'}">
              ❌ ขาด: ${evSummary.absent}
            </span>
          </div>
        `;

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="py-2.5 px-3">
              <div class="flex items-center gap-2">
                ${renderJobEmblem(m.job, 26)}
                <div>
                  ${renderColoredMemberName(m)}
                  <div class="text-[10px] text-slate-400 mt-0.5">${m.job}</div>
                </div>
              </div>
            </td>
            <td class="py-2.5 px-3">${teamHtml}</td>
            <td class="py-2.5 px-3 text-center">
              <span class="mono px-2.5 py-0.5 rounded-full text-xs font-bold ${count > 0 ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' : 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'}">
                ${count} วัน
              </span>
            </td>
            <td class="py-2.5 px-3 text-center">${evStatsBadge}</td>
            <td class="py-2.5 px-3 max-w-md">${historyPills}</td>
            <td class="py-2.5 px-3 text-right">
              ${count > 0 ? `
                <button onclick="clearMemberAllLeaveHistory('${m.id}')" class="px-2.5 py-1 rounded-lg bg-rose-500/15 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 text-[11px] transition">
                  ล้างประวัติ
                </button>
              ` : '-'}
            </td>
          </tr>
        `;
      }).join('');
    }

    function copyDailyLeaveReport() {
      const onLeaveList = members.filter(m => m.leaveHistory && m.leaveHistory[selectedDate]);
      const lines = [];
      lines.push(`🏖️ สรุปรายชื่อคนลาประจำวัน — ${guildName}`);
      lines.push(`📅 ประจำวันที่: ${formatThaiDateFull(selectedDate)}`);
      lines.push(`✅ พร้อมวอร์: ${members.length - onLeaveList.length} คน | 🚨 แจ้งลา: ${onLeaveList.length} คน`);
      lines.push(`========================================`);

      if (onLeaveList.length === 0) {
        lines.push(`🎉 ไม่มีสมาชิกแจ้งลาในวันนี้ (พร้อมวอร์ครบทุกคน!)`);
      } else {
        onLeaveList.forEach((m, idx) => {
          const rec = m.leaveHistory[selectedDate];
          const pInfo = findMemberPartyInfo(m.id);
          const teamText = pInfo ? `[${pInfo.team.name} - ${pInfo.party.name}]` : `[ไม่ได้ลงตี้]`;
          lines.push(`${idx + 1}. ${m.name} (${m.job}) ${teamText} — ${rec.type} (เหตุผล: ${rec.reason || '-'})`);
        });
      }

      const tempArea = document.createElement('textarea');
      tempArea.value = lines.join('\n');
      document.body.appendChild(tempArea);
      tempArea.select();
      document.execCommand('copy');
      tempArea.remove();
      showToast(`📋 คัดลอกสรุปรายชื่อคนลาประจำวันที่ ${formatThaiDateShort(selectedDate)} แล้ว!`, 'success');
    }

    function exportLeaveHistoryCSV() {
      const headers = ['วันที่ลา (YYYY-MM-DD)', 'วันที่ (ไทย)', 'ชื่อตัวละคร', 'คลาสอาชีพ', 'คะแนน Gear', 'ทีม', 'ปาร์ตี้', 'ประเภทการลา', 'เหตุผลการลา', 'เวลาที่บันทึก'];
      const rows = [];

      members.forEach(m => {
        ensureLeaveHistoryObject(m);
        const pInfo = findMemberPartyInfo(m.id);
        const teamStr = pInfo ? pInfo.team.name : '-';
        const partyStr = pInfo ? pInfo.party.name : 'ไม่ได้ลงตี้';
        Object.keys(m.leaveHistory).sort().forEach(dateKey => {
          const rec = m.leaveHistory[dateKey];
          rows.push([
            dateKey,
            formatThaiDateFull(dateKey).replace(/,/g, ' '),
            m.name,
            m.job,
            m.gear,
            teamStr,
            partyStr,
            (rec.type || '').replace(/,/g, ' '),
            (rec.reason || '').replace(/,/g, ' '),
            (rec.updatedAt || '-').replace(/,/g, ' ')
          ].join(','));
        });
      });

      if (rows.length === 0) {
        showToast('ยังไม่มีประวัติการลาในระบบให้ส่งออก CSV ครับ', 'info');
        return;
      }

      const csvContent = '\uFEFF' + headers.join(',') + '\n' + rows.join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `ประวัติการลา_${guildName.replace(/\s+/g, '_')}_${selectedDate}.csv`;
      a.click();
      showToast(`📥 ส่งออกไฟล์ CSV ประวัติการลาทั้งหมด (${rows.length} รายการ) สำเร็จ!`, 'success');
    }

    // ============================================================================
    // 6. TEAM, FIELD (สนามหลัก / สนามรอง) & PARTY CRUD OPERATIONS
    // ============================================================================
    function setTeamColor(teamId, colorKey) {
      const team = teams.find(t => t.id === teamId);
      if (!team) return;
      team.color = colorKey;
      syncTeamMetadataToParties();
      renderAll();
      showToast(`🎨 เปลี่ยนสี "${team.name}" เป็นโทนสี${getTeamTheme(colorKey).name}แล้ว`, 'success');
    }

    function setTeamField(teamId, fieldKey) {
      const team = teams.find(t => t.id === teamId);
      if (!team) return;
      team.field = (fieldKey === 'sub') ? 'sub' : 'main';
      syncTeamMetadataToParties();
      renderAll();
      const fz = getFieldZone(team.field);
      showToast(`${fz.icon} ย้าย "${team.name}" ไปยัง 【${fz.name}】 เรียบร้อยแล้ว`, 'success');
    }

    function openCreateTeamModal(defaultFieldKey = 'main') {
      const nextLetter = String.fromCharCode(65 + teams.length);
      const colorKeys = Object.keys(TEAM_COLORS);
      const defaultColor = colorKeys[teams.length % colorKeys.length];
      const initField = (defaultFieldKey === 'sub' || currentTeamFilter === 'field_sub') ? 'sub' : 'main';

      openCustomDialog({
        title: '➕ สร้างทีมใหม่เข้าสนามรบ',
        message: 'ตั้งชื่อทีมใหม่ และเลือกสนาม (สนามหลัก / สนามรอง)\nระบบจะสร้าง ปาร์ตี้ 1 ถึง ปาร์ตี้ 4 ให้ในทีมอัตโนมัติ:',
        showInput: true,
        defaultInput: `ทีม ${nextLetter}`,
        showFieldPicker: true,
        defaultField: initField,
        showColorPicker: true,
        defaultColor: defaultColor,
        confirmText: 'สร้างทีม',
        onConfirm: (val, pickedColor, pickedField) => {
          const name = (val || '').trim() || `ทีม ${nextLetter}`;
          const newTeamId = 'team_' + Date.now();
          const fKey = (pickedField === 'sub') ? 'sub' : 'main';
          const newTeam = { id: newTeamId, name, color: pickedColor || 'purple', field: fKey };
          teams.push(newTeam);
          for (let i = 1; i <= 4; i++) {
            parties.push({
              id: `${newTeamId}_p${i}_${Math.random().toString(36).slice(2, 5)}`,
              name: `ปาร์ตี้ ${i}`,
              teamId: newTeamId,
              teamName: name,
              teamColor: newTeam.color,
              teamField: fKey,
              raid: fKey,
              slots: [null, null, null, null, null]
            });
          }
          renderAll();
          const fz = getFieldZone(fKey);
          showToast(`➕ สร้าง "${name}" ใน 【${fz.name}】 พร้อมปาร์ตี้ 1-4 เรียบร้อยแล้ว`, 'success');
        }
      });
    }

    function renameTeam(teamId) {
      const team = teams.find(t => t.id === teamId);
      if (!team) return;
      openCustomDialog({
        title: '✏️ เปลี่ยนชื่อทีม',
        message: `กรอกชื่อใหม่สำหรับ "${team.name}":`,
        showInput: true,
        defaultInput: team.name,
        confirmText: 'บันทึกชื่อทีม',
        onConfirm: (val) => {
          if (val && val.trim()) {
            team.name = val.trim();
            syncTeamMetadataToParties();
            renderAll();
            showToast(`✏️ เปลี่ยนชื่อทีมเป็น "${team.name}" แล้ว`, 'success');
          }
        }
      });
    }

    function deleteTeam(teamId) {
      if (teams.length <= 1) {
        showToast('ต้องมีอย่างน้อย 1 ทีมในระบบครับ', 'danger');
        return;
      }
      const team = teams.find(t => t.id === teamId);
      if (!team) return;
      openCustomDialog({
        title: `🗑️ ยืนยันการลบ "${team.name}"`,
        message: `คุณต้องการลบ "${team.name}" และปาร์ตี้ทั้งหมดในทีมนี้ใช่หรือไม่?\n(สมาชิกที่อยู่ในทีมนี้จะถูกย้ายกลับไปที่รายชื่อรอจัดตี้)`,
        confirmText: 'ลบทีมนี้',
        onConfirm: () => {
          teams = teams.filter(t => t.id !== teamId);
          parties = parties.filter(p => p.teamId !== teamId);
          if (currentTeamFilter === teamId) currentTeamFilter = 'all';
          renderAll();
          showToast(`🗑️ ลบ "${team.name}" เรียบร้อยแล้ว`, 'danger');
        }
      });
    }

    function addPartyToTeam(teamId) {
      const team = teams.find(t => t.id === teamId);
      if (!team) return;
      const teamPartiesCount = parties.filter(p => p.teamId === teamId).length;
      const newParty = {
        id: `${teamId}_p_${Date.now()}`,
        name: `ปาร์ตี้ ${teamPartiesCount + 1}`,
        teamId: team.id,
        teamName: team.name,
        teamColor: team.color,
        teamField: team.field || 'main',
        raid: team.field || 'main',
        slots: [null, null, null, null, null]
      };
      parties.push(newParty);
      renderAll();
      showToast(`➕ เพิ่ม "${newParty.name}" ใน ${team.name} แล้ว`, 'success');
    }

    function renumberPartiesInTeam(teamId) {
      const team = teams.find(t => t.id === teamId);
      if (!team) return;
      const teamParties = parties.filter(p => p.teamId === teamId);
      teamParties.forEach((p, idx) => {
        p.name = `ปาร์ตี้ ${idx + 1}`;
      });
      renderAll();
      showToast(`🔢 รันเลขปาร์ตี้ 1-${teamParties.length} ใน ${team.name} เรียบร้อยแล้ว`, 'success');
    }

    function movePartyToTeam(partyId, targetTeamId) {
      const party = parties.find(p => p.id === partyId);
      const targetTeam = teams.find(t => t.id === targetTeamId);
      if (!party || !targetTeam) return;
      party.teamId = targetTeam.id;
      party.teamName = targetTeam.name;
      party.teamColor = targetTeam.color;
      party.teamField = targetTeam.field || 'main';
      party.raid = targetTeam.field || 'main';
      renderAll();
      showToast(`ย้าย "${party.name}" ไปยัง ${targetTeam.name} (${getFieldZone(targetTeam.field).name}) เรียบร้อยแล้ว`, 'info');
    }

    function renameParty(partyId) {
      const p = parties.find(x => x.id === partyId);
      if (!p) return;
      openCustomDialog({
        title: '✏️ เปลี่ยนชื่อปาร์ตี้',
        message: `ตั้งชื่อใหม่ให้ "${p.name}" (${p.teamName}):`,
        showInput: true,
        defaultInput: p.name,
        confirmText: 'บันทึก',
        onConfirm: (val) => {
          if (val && val.trim()) {
            p.name = val.trim();
            renderAll();
            showToast(`✏️ เปลี่ยนชื่อเป็น "${p.name}" แล้ว`, 'success');
          }
        }
      });
    }

    function deleteParty(partyId) {
      const idx = parties.findIndex(p => p.id === partyId);
      if (idx === -1) return;
      const target = parties[idx];
      parties.splice(idx, 1);
      renderAll();
      showToast(`🗑️ ลบ "${target.name}" (${target.teamName}) แล้ว`, 'danger');
    }

    function clearSingleParty(partyId) {
      const p = parties.find(x => x.id === partyId);
      if (!p) return;
      p.slots = [null, null, null, null, null];
      renderAll();
      showToast(`ถอดสมาชิกออกจาก "${p.name}" (${p.teamName}) แล้ว`, 'info');
    }

    function clearAllParties() {
      openCustomDialog({
        title: 'ล้างคนในปาร์ตี้ทั้งหมด',
        message: 'ต้องการถอดสมาชิกทุกคนออกจากทุกปาร์ตี้ใช่หรือไม่? (โครงสร้างสนาม ทีม และปาร์ตี้จะยังอยู่ครบ)',
        confirmText: 'ถอดทุกคนออก',
        onConfirm: () => {
          parties.forEach(p => p.slots = [null, null, null, null, null]);
          renderAll();
          showToast('ถอดสมาชิกออกจากทุกปาร์ตี้เรียบร้อยแล้ว', 'info');
        }
      });
    }

    function resetDefaultTeamsStructure() {
      openCustomDialog({
        title: '🔄 ตั้งค่าโครงสร้างเริ่มต้น (สนามหลัก: ทีม A | สนามรอง: ทีม B, C)',
        message: 'ต้องการจัดโครงสร้างเป็น สนามหลัก (ทีม A) และ สนามรอง (ทีม B, ทีม C) ทีมละ 4 ปาร์ตี้ ใช่หรือไม่?',
        confirmText: 'รีเซ็ตโครงสร้างทีม',
        onConfirm: () => {
          initDefaultTeamsAndParties();
          renderAll();
          showToast('🔄 ตั้งค่าโครงสร้าง สนามหลัก (ทีม A) & สนามรอง (ทีม B, C) เรียบร้อยแล้ว', 'success');
        }
      });
    }

    function setTeamFilter(teamId) {
      currentTeamFilter = teamId;
      renderAll();
    }

    // ============================================================================
    // 7. SMART AUTO-ASSIGN BY GEAR & ROLE (PRIORITIZES สนามหลัก THEN สนามรอง)
    // ============================================================================
    function autoAssignByGearAndRole() {
      if (members.length === 0) {
        showToast('ยังไม่มีข้อมูลสมาชิกให้จัดตี้ กรุณาเพิ่มสมาชิกหรือนำเข้าไฟล์ CSV ก่อนครับ', 'info');
        return;
      }
      if (teams.length === 0 || parties.length === 0) {
        initDefaultTeamsAndParties();
      } else {
        parties.forEach(p => p.slots = [null, null, null, null, null]);
      }

      syncTeamMetadataToParties();
      syncMembersStatusForSelectedDate();

      const readyMembers = members
        .filter(m => m.status === 'ready')
        .sort((a, b) => b.gear - a.gear);

      const tanks = readyMembers.filter(m => getJobMeta(m.job).role === 'tank');
      const healers = readyMembers.filter(m => getJobMeta(m.job).role === 'healer');
      const bards = readyMembers.filter(m => getJobMeta(m.job).role === 'bard');
      const usedIds = new Set();

      const orderedTeams = [
        ...teams.filter(t => t.field === 'main'),
        ...teams.filter(t => t.field !== 'main')
      ];

      const orderedParties = [];
      orderedTeams.forEach(t => {
        parties.filter(p => p.teamId === t.id).forEach(p => orderedParties.push(p));
      });

      orderedParties.forEach(p => {
        const h = healers.find(m => !usedIds.has(m.id));
        if (h) { p.slots[0] = h.id; usedIds.add(h.id); }
      });

      orderedParties.forEach(p => {
        const t = tanks.find(m => !usedIds.has(m.id));
        if (t) { p.slots[1] = t.id; usedIds.add(t.id); }
      });

      orderedParties.forEach(p => {
        const b = bards.find(m => !usedIds.has(m.id));
        if (b) { p.slots[2] = b.id; usedIds.add(b.id); }
      });

      const remainingReady = readyMembers.filter(m => !usedIds.has(m.id));
      orderedParties.forEach(p => {
        for (let s = 0; s < 5; s++) {
          if (!p.slots[s]) {
            const nextM = remainingReady.find(m => !usedIds.has(m.id));
            if (nextM) {
              p.slots[s] = nextM.id;
              usedIds.add(nextM.id);
            }
          }
        }
      });

      renderAll();
      showToast(`⚡ จัดสมาชิกที่พร้อมวอร์เข้า 【สนามหลัก】 และ 【สนามรอง】 ตาม Gear เรียบร้อยแล้ว`, 'success');
    }

    // ============================================================================
    // 8. MEMBER MANUAL ADD, DELETE & CSV IMPORT/EXPORT
    // ============================================================================
    function openAddMemberModal() {
      document.getElementById('newMemName').value = '';
      document.getElementById('addMemberModal').classList.remove('hidden');
      setTimeout(() => document.getElementById('newMemName').focus(), 50);
    }

    function closeAddMemberModal() {
      document.getElementById('addMemberModal').classList.add('hidden');
    }

    function confirmAddMember() {
      const name = document.getElementById('newMemName').value.trim();
      if (!name) {
        showToast('กรุณากรอกชื่อตัวละครก่อนบันทึกครับ', 'danger');
        return;
      }
      const job = document.getElementById('newMemJob').value;
      const lv = parseInt(document.getElementById('newMemLv').value, 10) || 90;
      const gear = parseInt(document.getElementById('newMemGear').value, 10) || 30000;
      const pos = document.getElementById('newMemPos').value.trim() || 'สมาชิก';
      const nextCsvId = members.length ? Math.max(...members.map(m => m.csvId || 0)) + 1 : 1;

      const newMem = {
        id: 'm_custom_' + Date.now() + '_' + Math.random().toString(36).slice(2, 5),
        csvId: nextCsvId,
        name,
        lv,
        job,
        title: '-',
        gender: '-',
        position: pos,
        gear,
        weeklyActivity: 0,
        weeklyContrib: 0,
        totalContrib: 0,
        onlineStatus: '[ออนไลน์]',
        status: 'ready',
        leaveReason: '',
        leaveHistory: {}
      };

      if (teams.length === 0 || parties.length === 0) initDefaultTeamsAndParties();
      members.unshift(newMem);
      fileTimestamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
      closeAddMemberModal();
      populateClassFilterDropdown();
      renderAll();
      showToast(`➕ เพิ่มสมาชิก "${name}" (${job}) แล้ว`, 'success');
    }

    function deleteMember(memberId) {
      const idx = members.findIndex(m => m.id === memberId);
      if (idx === -1) return;
      const target = members[idx];
      openCustomDialog({
        title: '🗑️ ยืนยันการลบสมาชิก',
        message: `ต้องการลบ "${target.name}" (${target.job} • Gear ${target.gear.toLocaleString()}) ออกจากรายชื่อกิลด์ใช่หรือไม่?`,
        confirmText: 'ลบสมาชิก',
        onConfirm: () => {
          parties.forEach(p => {
            const sIdx = p.slots.indexOf(memberId);
            if (sIdx !== -1) p.slots[sIdx] = null;
          });
          if (selectedSource && selectedSource.memberId === memberId) selectedSource = null;
          selectedMemberIds.delete(memberId);
          members.splice(idx, 1);
          populateClassFilterDropdown();
          renderAll();
          showToast(`🗑️ ลบสมาชิก "${target.name}" ออกจากกิลด์แล้ว`, 'danger');
        }
      });
    }

    function toggleSelectMember(memberId, checked) {
      if (checked) selectedMemberIds.add(memberId);
      else selectedMemberIds.delete(memberId);
      updateBulkDeleteButton();
    }

    function toggleSelectAllVisible(checked) {
      const visibleCheckboxes = document.querySelectorAll('.member-row-checkbox');
      visibleCheckboxes.forEach(cb => {
        cb.checked = checked;
        const id = cb.getAttribute('data-id');
        if (checked) selectedMemberIds.add(id);
        else selectedMemberIds.delete(id);
      });
      updateBulkDeleteButton();
    }

    function updateBulkDeleteButton() {
      const btn = document.getElementById('btnDeleteSelected');
      if (!btn) return;
      if (selectedMemberIds.size > 0) {
        btn.classList.remove('hidden');
        btn.textContent = `🗑️ ลบที่เลือก (${selectedMemberIds.size} คน)`;
      } else {
        btn.classList.add('hidden');
      }
    }

    function deleteSelectedMembers() {
      const count = selectedMemberIds.size;
      if (count === 0) return;
      openCustomDialog({
        title: `🗑️ ลบสมาชิกที่เลือก (${count} คน)`,
        message: `ยืนยันการลบสมาชิกที่เลือกทั้งหมด ${count} คน ออกจากรายชื่อกิลด์?`,
        confirmText: 'ลบทั้งหมดที่เลือก',
        onConfirm: () => {
          members = members.filter(m => !selectedMemberIds.has(m.id));
          parties.forEach(p => {
            p.slots = p.slots.map(id => (id && selectedMemberIds.has(id)) ? null : id);
          });
          selectedMemberIds.clear();
          const selectAllCb = document.getElementById('selectAllCheckbox');
          if (selectAllCb) selectAllCb.checked = false;
          populateClassFilterDropdown();
          renderAll();
          showToast(`🗑️ ลบสมาชิกที่เลือกจำนวน ${count} คน เรียบร้อยแล้ว`, 'danger');
        }
      });
    }

    function deleteOfflineMembers(mode) {
      const targetStatuses = mode === '7'
        ? ['ออฟไลน์เกิน 7 วัน']
        : ['ออฟไลน์ 4 วัน', 'ออฟไลน์ 5 วัน', 'ออฟไลน์ 6 วัน', 'ออฟไลน์เกิน 7 วัน'];
      const toDelete = members.filter(m => targetStatuses.includes(m.onlineStatus));
      if (toDelete.length === 0) {
        showToast('ไม่พบสมาชิกที่ตรงเงื่อนไขออฟไลน์ดังกล่าว', 'info');
        return;
      }
      const label = mode === '7' ? 'ออฟไลน์เกิน 7 วัน' : 'ออฟไลน์ตั้งแต่ 4 วันขึ้นไป';
      openCustomDialog({
        title: `🗑️ ลบคน${label}`,
        message: `พบสมาชิกที่ "${label}" จำนวน ${toDelete.length} คน\nต้องการลบออกจากรายชื่อกิลด์ทั้งหมดเลยหรือไม่?`,
        confirmText: `ลบ ${toDelete.length} คน`,
        onConfirm: () => {
          const delIds = new Set(toDelete.map(m => m.id));
          members = members.filter(m => !delIds.has(m.id));
          parties.forEach(p => {
            p.slots = p.slots.map(id => (id && delIds.has(id)) ? null : id);
          });
          delIds.forEach(id => selectedMemberIds.delete(id));
          populateClassFilterDropdown();
          renderAll();
          showToast(`🗑️ ลบสมาชิกที่${label} จำนวน ${toDelete.length} คน เรียบร้อยแล้ว`, 'danger');
        }
      });
    }

    function clearAllGuildData() {
      openCustomDialog({
        title: '🗑️ ล้างข้อมูลบนหน้าจอทั้งหมด',
        message: 'ต้องการล้างรายชื่อสมาชิกและรีเซ็ตทีม A, B, C ใหม่ทั้งหมดใช่หรือไม่?',
        confirmText: 'ล้างข้อมูล',
        onConfirm: () => {
          members = [];
          selectedMemberIds.clear();
          selectedSource = null;
          fileTimestamp = 'ล้างข้อมูลแล้ว';
          initDefaultTeamsAndParties();
          populateClassFilterDropdown();
          renderAll();
          showToast('🗑️ ล้างรายชื่อสมาชิกและรีเซ็ตปาร์ตี้ทั้งหมดแล้ว', 'danger');
        }
      });
    }

    function parseCSVText(text) {
      const cleanText = text.replace(/^\uFEFF/, '').trim();
      const lines = cleanText.split(/\r?\n/).filter(l => l.trim().length > 0);
      if (lines.length < 2) return [];
      const headers = lines[0].split(',').map(h => h.trim());
      const rows = [];
      for (let i = 1; i < lines.length; i++) {
        const cols = lines[i].split(',').map(c => c.trim());
        if (cols.length < 4) continue;
        const obj = {};
        headers.forEach((h, idx) => { obj[h] = cols[idx] !== undefined ? cols[idx] : ''; });
        rows.push(obj);
      }
      return rows;
    }

    function handleCSVUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const baseName = file.name.replace(/\.csv$/i, '');
      const parts = baseName.split('_');
      if (parts.length >= 2) {
        guildName = 'กิลด์ ' + parts[0];
        if (parts[1].length === 8) {
          const y = parts[1].slice(0, 4), m = parts[1].slice(4, 6), d = parts[1].slice(6, 8);
          const timePart = parts[2] && parts[2].length === 4 ? ` ${parts[2].slice(0, 2)}:${parts[2].slice(2, 4)}` : '';
          fileTimestamp = `${d}/${m}/${y}${timePart}`;
        }
      } else {
        fileTimestamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
      }

      const reader = new FileReader();
      reader.onload = function(e) {
        const rows = parseCSVText(e.target.result);
        if (!rows.length) {
          showToast('ไม่สามารถอ่านข้อมูลจากไฟล์ CSV ได้ กรุณาตรวจสอบไฟล์', 'danger');
          event.target.value = '';
          return;
        }

        const nowStamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
        const importedMembers = rows.map((r, idx) => {
          const onlineStr = (r['สถานะออนไลน์'] || '[ออนไลน์]').trim();
          const isLongOffline = ['ออฟไลน์ 4 วัน', 'ออฟไลน์ 5 วัน', 'ออฟไลน์ 6 วัน', 'ออฟไลน์เกิน 7 วัน'].includes(onlineStr);
          const leaveHist = {};
          if (isLongOffline) {
            leaveHist[selectedDate] = {
              type: 'ลาทั้งวัน (ไม่เข้าเกม)',
              reason: onlineStr,
              updatedAt: nowStamp
            };
          }
          return {
            id: 'm_csv_' + Date.now() + '_' + (r['ID'] || (idx + 1)),
            csvId: parseInt(r['ID'] || (idx + 1), 10),
            name: (r['ชื่อผู้เล่น'] || 'Unknown').trim(),
            lv: parseInt(r['Lv.'] || '1', 10) || 1,
            job: (r['คลาส'] || 'Novice').trim(),
            title: (r['Title'] || '-').trim(),
            gender: (r['เพศ'] || '-').trim(),
            position: (r['ตำแหน่ง'] || 'สมาชิก').trim(),
            gear: parseInt(r['คะแนน Gear'] || '0', 10) || 0,
            weeklyActivity: parseInt(r['กิจกรรมสัปดาห์นี้'] || '0', 10) || 0,
            weeklyContrib: parseInt(r['แต้มสนับสนุนสัปดาห์นี้'] || '0', 10) || 0,
            totalContrib: parseInt(r['แต้มสนับสนุนสะสม'] || '0', 10) || 0,
            onlineStatus: onlineStr,
            status: isLongOffline ? 'leave' : 'ready',
            leaveReason: isLongOffline ? onlineStr : '',
            leaveHistory: leaveHist
          };
        });

        const applyMerge = () => {
          const existingByName = new Map(members.map(m => [m.name.toLowerCase(), m]));
          let addedCount = 0;
          let updatedCount = 0;
          importedMembers.forEach(imp => {
            const key = imp.name.toLowerCase();
            if (existingByName.has(key)) {
              const ex = existingByName.get(key);
              ex.lv = imp.lv;
              ex.job = imp.job;
              ex.title = imp.title;
              ex.gender = imp.gender;
              ex.position = imp.position;
              ex.gear = imp.gear;
              ex.weeklyActivity = imp.weeklyActivity;
              ex.weeklyContrib = imp.weeklyContrib;
              ex.totalContrib = imp.totalContrib;
              ex.onlineStatus = imp.onlineStatus;
              ensureLeaveHistoryObject(ex);
              ensureWeeklyEventsObject(ex);
              ex._leaveMigrated = true;
              updatedCount++;
            } else {
              imp._leaveMigrated = true;
              members.push(imp);
              addedCount++;
            }
          });
          if (teams.length === 0 || parties.length === 0) initDefaultTeamsAndParties();
          syncMembersStatusForSelectedDate();
          populateClassFilterDropdown();
          renderAll();
          showToast(`📂 รวมไฟล์ CSV สำเร็จ! (อัปเดต ${updatedCount} คน, เพิ่มใหม่ ${addedCount} คน)`, 'success');
        };

        const applyReplace = () => {
          importedMembers.forEach(imp => { imp._leaveMigrated = true; });
          members = importedMembers;
          selectedMemberIds.clear();
          if (teams.length === 0 || parties.length === 0) initDefaultTeamsAndParties();
          syncMembersStatusForSelectedDate();
          populateClassFilterDropdown();
          autoAssignByGearAndRole();
          showToast(`📂 นำเข้าไฟล์ CSV สำเร็จ! โหลดสมาชิก ${members.length} คน`, 'success');
        };

        if (members.length > 0) {
          openCustomDialog({
            title: '📂 พบรายชื่อสมาชิกเดิมในระบบ',
            message: `ตอนนี้มีรายชื่อสมาชิกอยู่แล้ว ${members.length} คน\nกด "รวมข้อมูลและอัปเดต Gear" เพื่อรักษาการจัดปาร์ตี้และประวัติการลาเดิมไว้`,
            confirmText: 'รวมข้อมูลและอัปเดต Gear',
            cancelText: 'ทับข้อมูลใหม่ทั้งหมด',
            onConfirm: () => applyMerge()
          });
          document.getElementById('dialogCancelBtn').onclick = () => {
            closeCustomDialog();
            applyReplace();
          };
        } else {
          applyReplace();
        }

        event.target.value = '';
      };
      reader.readAsText(file, 'utf-8');
    }

    // ============================================================================
    // 9. RENDERING UI (JOB BAR, TACTICAL BOARD, TEAMS, ROSTER, QUICK CHECK)
    // ============================================================================
    function selectJobBarFamily(familyKey) {
      activeJobBarFamily = (activeJobBarFamily === familyKey) ? 'all' : familyKey;
      const resetBtn = document.getElementById('resetJobBarBtn');
      if (resetBtn) resetBtn.classList.toggle('hidden', activeJobBarFamily === 'all');
      renderAll();
    }

    function renderJobEmblemBar() {
      const bar = document.getElementById('jobEmblemBarContainer');
      if (!bar) return;

      bar.innerHTML = JOB_FAMILIES.map(fam => {
        const count = members.filter(m => getJobFamily(m.job).familyKey === fam.familyKey).length;
        const isSelected = activeJobBarFamily === fam.familyKey;
        const activeClasses = isSelected
          ? 'bg-[#363d4e] border-slate-500 ring-2 ring-amber-400/80 shadow-lg'
          : 'bg-transparent border-transparent hover:bg-[#272c3a]';

        return `
          <button onclick="selectJobBarFamily('${fam.familyKey}')" class="group relative flex flex-col items-center justify-center min-w-[74px] sm:min-w-[82px] px-2.5 py-2 rounded-xl border transition-all cursor-pointer ${activeClasses}" title="${fam.label} (${fam.jobs.join(' / ')}) — ${count} คน">
            ${count > 0 ? `<span class="absolute top-1 right-1.5 mono text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-slate-950/90 text-amber-300 border border-slate-700">${count}</span>` : ''}
            <div class="transform group-hover:scale-110 transition duration-200">
              ${renderJobEmblem(fam.jobs[0], 42)}
            </div>
            <span class="mt-1.5 text-xs font-bold tracking-tight ${isSelected ? 'text-white' : 'text-slate-400 group-hover:text-slate-200'}">${fam.label}</span>
          </button>
        `;
      }).join('');
    }

    function findMemberPartyInfo(memberId) {
      for (const p of parties) {
        const idx = p.slots.indexOf(memberId);
        if (idx !== -1) {
          const team = teams.find(t => t.id === p.teamId) || {
            id: 'team_a',
            name: p.teamName || 'ทีม A',
            color: p.teamColor || 'rose',
            field: p.teamField || p.raid || 'main'
          };
          const fieldZone = getFieldZone(team.field);
          return { party: p, team, fieldZone, slotIndex: idx };
        }
      }
      return null;
    }

    function getAssignedSet() {
      const set = new Set();
      parties.forEach(p => p.slots.forEach(id => { if (id) set.add(id); }));
      return set;
    }

    function formatGearBadge(gear) {
      if (gear >= 40000) return `<span class="mono px-1.5 py-0.5 rounded text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">★ ${gear.toLocaleString()}</span>`;
      if (gear >= 30000) return `<span class="mono px-1.5 py-0.5 rounded text-[11px] font-semibold bg-purple-500/20 text-purple-300 border border-purple-500/30">${gear.toLocaleString()}</span>`;
      if (gear >= 20000) return `<span class="mono px-1.5 py-0.5 rounded text-[11px] font-medium bg-sky-500/20 text-sky-300 border border-sky-500/30">${gear.toLocaleString()}</span>`;
      return `<span class="mono px-1.5 py-0.5 rounded text-[11px] text-slate-300 bg-slate-800/90">${gear.toLocaleString()}</span>`;
    }

    function updateKPIs() {
      syncMembersStatusForSelectedDate();
      document.getElementById('guildTitleDisplay').textContent = guildName;
      document.getElementById('fileMetaBadge').textContent = fileTimestamp;
      const readyList = members.filter(m => m.status === 'ready');
      const leaveList = members.filter(m => m.status === 'leave');
      const assignedSet = getAssignedSet();
      const avgGear = readyList.length
        ? Math.round(readyList.reduce((acc, m) => acc + m.gear, 0) / readyList.length)
        : 0;

      document.getElementById('statTotal').textContent = members.length;
      document.getElementById('statReady').textContent = readyList.length;
      document.getElementById('statLeave').textContent = leaveList.length;
      document.getElementById('statAssigned').textContent = `${assignedSet.size} / ${parties.length * 5}`;
      document.getElementById('statAvgGear').textContent = avgGear.toLocaleString();
      document.getElementById('tabBtn-roster').textContent = `📋 ตารางสมาชิก (${members.length} คน)`;
      document.getElementById('tabBtn-leave').textContent = `🏖️ ระบบบันทึกการลา (${leaveList.length})`;

      let totalJoinedEvents = 0;
      const maxEventsPossible = members.length * WEEKLY_EVENTS_CONFIG.length;
      members.forEach(m => {
        WEEKLY_EVENTS_CONFIG.forEach(ev => {
          if (getMemberEventRecord(m, selectedWeekMonday, ev.key).status === 'joined') {
            totalJoinedEvents++;
          }
        });
      });
      const weeklyEventPct = maxEventsPossible > 0 ? Math.round((totalJoinedEvents / maxEventsPossible) * 100) : 0;
      const statEventsEl = document.getElementById('statWeeklyEvents');
      if (statEventsEl) statEventsEl.textContent = `${weeklyEventPct}% (${totalJoinedEvents}/${maxEventsPossible})`;
      const evBtn = document.getElementById('tabBtn-events');
      if (evBtn) evBtn.textContent = `🏆 กิจกรรมประจำสัปดาห์ (${weeklyEventPct}%)`;

      updateBulkDeleteButton();
    }

    function renderTeamFilterBar() {
      const bar = document.getElementById('teamFilterButtons');
      if (!bar) return;

      const mainTeams = teams.filter(t => t.field === 'main');
      const subTeams = teams.filter(t => t.field === 'sub');
      const mainPartiesCount = parties.filter(p => mainTeams.some(t => t.id === p.teamId)).length;
      const subPartiesCount = parties.filter(p => subTeams.some(t => t.id === p.teamId)).length;

      const allBtnClass = currentTeamFilter === 'all'
        ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/20'
        : 'bg-slate-800 text-slate-300 hover:bg-slate-700';

      const mainBtnClass = currentTeamFilter === 'field_main'
        ? 'bg-amber-500 text-slate-950 font-bold shadow-md shadow-amber-500/20'
        : 'bg-amber-950/40 text-amber-300 hover:bg-amber-900/50 border border-amber-500/40';

      const subBtnClass = currentTeamFilter === 'field_sub'
        ? 'bg-sky-500 text-slate-950 font-bold shadow-md shadow-sky-500/20'
        : 'bg-sky-950/40 text-sky-300 hover:bg-sky-900/50 border border-sky-500/40';

      let html = `
        <button onclick="setTeamFilter('all')" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition ${allBtnClass}">
          ทุกสนาม (${teams.length} ทีม • ${parties.length} ตี้)
        </button>
        <button onclick="setTeamFilter('field_main')" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition flex items-center gap-1 ${mainBtnClass}">
          <span>🏟️ สนามหลัก (${mainTeams.length} ทีม • ${mainPartiesCount} ตี้)</span>
        </button>
        <button onclick="setTeamFilter('field_sub')" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition flex items-center gap-1 ${subBtnClass}">
          <span>🚩 สนามรอง (${subTeams.length} ทีม • ${subPartiesCount} ตี้)</span>
        </button>
        <span class="text-slate-700 hidden sm:inline">|</span>
      `;

      teams.forEach(t => {
        const theme = getTeamTheme(t.color);
        const fz = getFieldZone(t.field);
        const tParties = parties.filter(p => p.teamId === t.id);
        const isSelected = currentTeamFilter === t.id;
        const btnClass = isSelected
          ? `${theme.buttonClass} shadow-md`
          : 'bg-slate-800/90 text-slate-300 hover:bg-slate-700 border border-slate-700';

        html += `
          <button onclick="setTeamFilter('${t.id}')" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition ${btnClass}">
            <span class="w-2.5 h-2.5 rounded-full ${theme.dotClass}"></span>
            <span>${t.name}</span>
            <span class="px-1.5 py-0.2 rounded text-[10px] bg-slate-950/60 text-slate-300">${fz.shortName}•${tParties.length}ตี้</span>
          </button>
        `;
      });

      bar.innerHTML = html;
    }

    function renderTeamCardHtml(team) {
      const theme = getTeamTheme(team.color);
      const teamParties = parties.filter(p => p.teamId === team.id);

      const teamMembers = [];
      teamParties.forEach(p => {
        p.slots.forEach(mId => {
          const m = members.find(x => x.id === mId);
          if (m) teamMembers.push(m);
        });
      });
      const teamAvgGear = teamMembers.length
        ? Math.round(teamMembers.reduce((sum, m) => sum + m.gear, 0) / teamMembers.length)
        : 0;

      const colorDotsHtml = Object.values(TEAM_COLORS).map(c => `
        <button onclick="setTeamColor('${team.id}', '${c.key}')" title="เปลี่ยนสีทีมเป็น ${c.name}" class="w-4 h-4 rounded-full ${c.dotClass} transition transform hover:scale-125 ${team.color === c.key ? 'ring-2 ring-white scale-110' : 'opacity-65 hover:opacity-100'}"></button>
      `).join('');

      const partiesCardsHtml = teamParties.map(p => {
        const partyMembers = p.slots.map(id => members.find(m => m.id === id) || null);
        const presentMembers = partyMembers.filter(Boolean);
        const hasHealer = presentMembers.some(m => getJobMeta(m.job).role === 'healer' && m.status === 'ready');
        const leaveMembers = presentMembers.filter(m => m.status === 'leave');
        const avgPartyGear = presentMembers.length
          ? Math.round(presentMembers.reduce((sum, m) => sum + m.gear, 0) / presentMembers.length)
          : 0;

        const moveOptionsHtml = teams.map(tOpt => `
          <option value="${tOpt.id}" ${tOpt.id === team.id ? 'selected' : ''}>ย้ายไป: ${tOpt.name} (${getFieldZone(tOpt.field).shortName})</option>
        `).join('');

        const slotsHtml = p.slots.map((mId, sIdx) => {
          const m = members.find(x => x.id === mId);
          const isSelected = selectedSource && selectedSource.partyId === p.id && selectedSource.slotIndex === sIdx;
          if (!m) {
            return `
              <div onclick="handleSlotClick('${p.id}', ${sIdx})" class="h-11 rounded-xl border border-dashed border-slate-700/80 hover:border-amber-400/70 bg-slate-950/50 px-2.5 flex items-center justify-between text-[11px] text-slate-500 cursor-pointer transition ${isSelected ? 'slot-selected' : ''}">
                <span class="truncate">+ ช่องว่างที่ ${sIdx + 1} (แตะวาง)</span>
                <span class="text-[10px] opacity-60 shrink-0 ml-1">${team.name}</span>
              </div>
            `;
          }
          const meta = getJobMeta(m.job);
          return `
            <div onclick="handleSlotClick('${p.id}', ${sIdx})" style="${meta.cardTintStyle}" class="py-1.5 rounded-xl border px-2 flex items-center justify-between gap-1.5 cursor-pointer transition hover:brightness-110 ${isSelected ? 'slot-selected' : ''}">
              <div class="flex items-center gap-1.5 min-w-0">
                ${renderJobEmblem(m.job, 28)}
                <div class="min-w-0">
                  <div class="flex items-center gap-1">
                    ${renderColoredMemberName(m, 'px-2 py-0 text-[11px]')}
                    <span class="mono text-[10px] text-slate-300 shrink-0">Lv.${m.lv}</span>
                  </div>
                  <div class="flex items-center gap-1 mt-0.5 flex-wrap">
                    <span style="${meta.badgeStyle}" class="px-1.5 rounded text-[9px] border">${m.job}</span>
                    ${m.status === 'leave'
                      ? `<span class="px-1 rounded text-[9px] font-semibold bg-rose-500/30 text-rose-200 border border-rose-500/40 truncate max-w-[100px]">🏖️ ลา (${m.leaveReason || 'วันนี้'})</span>`
                      : `<span class="text-[9px] truncate ${m.onlineStatus === '[ออนไลน์]' ? 'text-emerald-300' : 'text-slate-400'}">${m.onlineStatus}</span>`
                    }
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1 shrink-0">
                ${formatGearBadge(m.gear)}
                <button onclick="event.stopPropagation(); removeMemberFromSlot('${p.id}', ${sIdx})" title="ถอดออกจากตี้" class="w-5 h-5 rounded hover:bg-amber-500/20 text-slate-300 hover:text-amber-300 text-xs flex items-center justify-center">✕</button>
              </div>
            </div>
          `;
        }).join('');

        return `
          <div class="bg-slate-950/90 border ${theme.partyBorder} rounded-2xl p-3 flex flex-col gap-2.5 shadow-lg transition">
            <div class="flex flex-col gap-1.5 border-b border-slate-800/90 pb-2 ${theme.partyHeaderBg} -mx-3 -mt-3 px-3 pt-2.5 rounded-t-2xl">
              <div class="flex items-center justify-between gap-1.5">
                <div class="flex items-center gap-1.5 min-w-0">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold border shrink-0 ${theme.badgeClass}">
                    ${team.name}
                  </span>
                  <h4 class="font-bold text-xs sm:text-sm text-white truncate">${p.name}</h4>
                  <button onclick="renameParty('${p.id}')" title="เปลี่ยนชื่อปาร์ตี้" class="text-slate-400 hover:text-white text-xs shrink-0">✏️</button>
                </div>

                <div class="flex items-center gap-1 shrink-0">
                  <select onchange="movePartyToTeam('${p.id}', this.value)" class="bg-slate-900 border border-slate-700 rounded-lg px-1 py-0.5 text-[10px] text-slate-300 focus:outline-none max-w-[96px] truncate">
                    ${moveOptionsHtml}
                  </select>
                  ${presentMembers.length > 0 ? `<button onclick="clearSingleParty('${p.id}')" title="ถอดคนในตี้นี้ออกทั้งหมด" class="px-1.5 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[10px] transition">ล้าง</button>` : ''}
                  <button onclick="deleteParty('${p.id}')" title="ลบปาร์ตี้นี้" class="px-1.5 py-0.5 rounded bg-rose-500/15 hover:bg-rose-500/30 border border-rose-500/30 text-rose-300 text-[10px] transition">🗑️</button>
                </div>
              </div>

              <div class="flex items-center justify-between text-[11px] text-slate-400">
                <div class="flex items-center gap-1.5">
                  <span>เฉลี่ย Gear: <strong class="mono text-indigo-300">${avgPartyGear.toLocaleString()}</strong></span>
                  <span>• ${presentMembers.length}/5 คน</span>
                </div>
                <div class="flex items-center gap-1">
                  ${!hasHealer && presentMembers.length > 0 ? `<span class="px-1.5 py-0.2 rounded-full text-[9px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/40">⚠️ ขาดพระ</span>` : ''}
                  ${leaveMembers.length > 0 ? `<span class="px-1.5 py-0.2 rounded-full text-[9px] font-semibold bg-rose-500/20 text-rose-300 border border-rose-500/40">🚨 ลา ${leaveMembers.length}</span>` : ''}
                </div>
              </div>
            </div>

            <div class="space-y-1.5">
              ${slotsHtml}
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="rounded-3xl border-2 ${theme.containerBorder} ${theme.containerBg} p-4 sm:p-5 space-y-4 shadow-xl">
          <div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-2xl border ${theme.headerBg}">
            <div class="flex items-center gap-3 flex-wrap">
              <div class="flex items-center gap-2">
                <span class="w-4 h-4 rounded-full ${theme.dotClass} shadow"></span>
                <h3 class="text-base sm:text-lg font-bold text-white tracking-wide">${team.name}</h3>
                <button onclick="renameTeam('${team.id}')" title="เปลี่ยนชื่อทีม" class="text-slate-300 hover:text-white text-xs px-1.5 py-0.5 rounded bg-slate-800/70">✏️ เปลี่ยนชื่อ</button>
              </div>

              <!-- ปุ่มสลับสนามประจำทีม (สนามหลัก / สนามรอง) -->
              <div class="inline-flex items-center bg-slate-950/90 p-1 rounded-xl border border-slate-800 text-[11px]">
                <button onclick="setTeamField('${team.id}', 'main')" class="px-2.5 py-1 rounded-lg transition ${team.field === 'main' ? 'bg-amber-500 text-slate-950 font-bold shadow' : 'text-slate-400 hover:text-white'}" title="กำหนดให้ ${team.name} อยู่ในสนามหลัก">
                  🏟️ สนามหลัก
                </button>
                <button onclick="setTeamField('${team.id}', 'sub')" class="px-2.5 py-1 rounded-lg transition ${team.field === 'sub' ? 'bg-sky-400 text-slate-950 font-bold shadow' : 'text-slate-400 hover:text-white'}" title="กำหนดให้ ${team.name} อยู่ในสนามรอง">
                  🚩 สนามรอง
                </button>
              </div>

              <div class="flex items-center gap-2 text-xs text-slate-300 bg-slate-950/60 px-3 py-1 rounded-xl border border-slate-800">
                <span>ปาร์ตี้ในทีม: <strong class="text-white">${teamParties.length} ตี้</strong></span>
                <span>•</span>
                <span>สมาชิก: <strong class="text-emerald-400">${teamMembers.length}/${teamParties.length * 5} คน</strong></span>
                <span>•</span>
                <span>เฉลี่ย Gear: <strong class="mono text-amber-300">${teamAvgGear.toLocaleString()}</strong></span>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <div class="flex items-center gap-1.5 bg-slate-950/80 px-3 py-1.5 rounded-xl border border-slate-800">
                <span class="text-[11px] text-slate-400 mr-1">🎨 สีทีม:</span>
                ${colorDotsHtml}
              </div>
              <div class="flex items-center gap-1.5 flex-wrap">
                <button onclick="openExportImageModal('${team.id}')" class="px-2.5 py-1.5 rounded-xl bg-fuchsia-600/25 hover:bg-fuchsia-600/40 text-fuchsia-200 border border-fuchsia-500/40 text-xs font-semibold transition flex items-center gap-1" title="ส่งออกรูปภาพเฉพาะ ${team.name}">
                  📸 รูป${team.name}
                </button>
                <button onclick="addPartyToTeam('${team.id}')" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition ${theme.buttonClass} shadow">
                  + เพิ่มปาร์ตี้ใน ${team.name}
                </button>
                <button onclick="renumberPartiesInTeam('${team.id}')" title="รันเลขปาร์ตี้ 1, 2, 3, 4 ใหม่" class="px-2.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs border border-slate-700 transition">
                  🔢 รันเลขตี้ 1-N
                </button>
                <button onclick="deleteTeam('${team.id}')" title="ลบทีมนี้" class="px-2.5 py-1.5 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 text-xs transition">
                  🗑️ ลบทีม
                </button>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3.5">
            ${partiesCardsHtml || `
              <div class="col-span-full py-8 text-center text-xs text-slate-400 border border-dashed border-slate-800 rounded-2xl">
                ยังไม่มีปาร์ตี้ใน ${team.name} — กดปุ่ม <strong>"+ เพิ่มปาร์ตี้ใน ${team.name}"</strong> ด้านบนได้เลยครับ
              </div>
            `}
          </div>
        </div>
      `;
    }

    function renderBoard() {
      syncTeamMetadataToParties();
      syncMembersStatusForSelectedDate();
      renderTeamFilterBar();

      const assignedSet = getAssignedSet();
      const q = (document.getElementById('poolSearch').value || '').toLowerCase();
      const roleFilter = document.getElementById('poolRoleFilter').value;
      const statusFilter = document.getElementById('poolStatusFilter').value;

      const unassigned = members
        .filter(m => !assignedSet.has(m.id))
        .filter(m => statusFilter === 'all' ? true : m.status === 'ready')
        .filter(m => roleFilter === 'all' ? true : getJobMeta(m.job).role === roleFilter)
        .filter(m => activeJobBarFamily === 'all' ? true : getJobFamily(m.job).familyKey === activeJobBarFamily)
        .filter(m => !q || m.name.toLowerCase().includes(q) || m.job.toLowerCase().includes(q) || m.position.toLowerCase().includes(q))
        .sort((a, b) => b.gear - a.gear);

      document.getElementById('unassignedCountBadge').textContent = unassigned.length;

      const poolEl = document.getElementById('unassignedPoolList');
      poolEl.innerHTML = unassigned.map(m => {
        const meta = getJobMeta(m.job);
        const isSelected = selectedSource && selectedSource.memberId === m.id;
        return `
          <div onclick="handlePoolClick('${m.id}')" style="${meta.cardTintStyle}" class="p-2.5 rounded-xl border cursor-pointer transition flex items-center justify-between gap-2 group hover:brightness-110 ${isSelected ? 'slot-selected' : ''}">
            <div class="flex items-center gap-2.5 min-w-0">
              ${renderJobEmblem(m.job, 34)}
              <div class="min-w-0">
                <div class="flex items-center gap-1.5">
                  ${renderColoredMemberName(m)}
                  <span class="mono text-[10px] text-slate-300 font-semibold">Lv.${m.lv}</span>
                </div>
                <div class="flex items-center gap-1.5 mt-1 flex-wrap">
                  <span style="${meta.badgeStyle}" class="px-1.5 py-0.2 rounded text-[10px] font-medium border">${m.job}</span>
                  ${m.status === 'leave'
                    ? `<span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-rose-500/25 text-rose-300 border border-rose-500/40">🏖️ ${m.leaveReason || 'ลาวันนี้'}</span>`
                    : `<span class="text-[10px] ${m.onlineStatus === '[ออนไลน์]' ? 'text-emerald-300' : 'text-slate-400'}">${m.onlineStatus}</span>`
                  }
                </div>
              </div>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              ${formatGearBadge(m.gear)}
            </div>
          </div>
        `;
      }).join('') || `
        <div class="text-center text-xs text-slate-500 py-8 space-y-2">
          <div>${members.length === 0 ? 'ยังไม่มีรายชื่อสมาชิกในระบบ' : 'ไม่มีสมาชิกที่ตรงกับเงื่อนไข'}</div>
          ${members.length === 0 ? `<div class="text-[11px] text-slate-400">กดปุ่ม <strong>"➕ เพิ่มสมาชิก"</strong> หรือ <strong>"📂 นำเข้า .CSV"</strong> ด้านบนเพื่อเริ่มต้น</div>` : ''}
        </div>
      `;

      const container = document.getElementById('teamsHierarchyContainer');

      const zonesToRender = FIELD_ZONES.filter(fz => {
        if (currentTeamFilter === 'field_main') return fz.key === 'main';
        if (currentTeamFilter === 'field_sub') return fz.key === 'sub';
        if (currentTeamFilter !== 'all') {
          const targetTeam = teams.find(t => t.id === currentTeamFilter);
          return targetTeam ? targetTeam.field === fz.key : true;
        }
        return true;
      });

      container.innerHTML = zonesToRender.map(fZone => {
        const fieldTeams = teams
          .filter(t => t.field === fZone.key)
          .filter(t => (currentTeamFilter === 'all' || currentTeamFilter === 'field_main' || currentTeamFilter === 'field_sub') ? true : t.id === currentTeamFilter);

        const allFieldParties = parties.filter(p => fieldTeams.some(t => t.id === p.teamId));
        const allFieldMembers = [];
        allFieldParties.forEach(p => {
          p.slots.forEach(mId => {
            const m = members.find(x => x.id === mId);
            if (m) allFieldMembers.push(m);
          });
        });
        const readyInField = allFieldMembers.filter(m => m.status === 'ready').length;
        const leaveInField = allFieldMembers.filter(m => m.status === 'leave').length;
        const fieldAvgGear = allFieldMembers.length
          ? Math.round(allFieldMembers.reduce((s, m) => s + m.gear, 0) / allFieldMembers.length)
          : 0;

        const teamsCardsHtml = fieldTeams.length > 0
          ? fieldTeams.map(team => renderTeamCardHtml(team)).join('')
          : `
            <div class="py-10 px-4 text-center border-2 border-dashed border-slate-800 rounded-2xl bg-slate-950/50 space-y-2.5">
              <div class="text-2xl">${fZone.icon}</div>
              <div class="text-sm font-bold text-slate-300">ยังไม่มีทีมใน ${fZone.name}</div>
              <p class="text-xs text-slate-400">คุณสามารถกดปุ่ม <strong>"➕ สร้างทีมใน${fZone.name}"</strong> ด้านบน หรือกดสลับปุ่ม <strong>"${fZone.icon} ${fZone.name}"</strong> บนหัวการ์ดของทีมที่มีอยู่เพื่อย้ายทีมเข้ามาในสนามนี้ได้ทันที</p>
              <button onclick="openCreateTeamModal('${fZone.key}')" class="mt-1 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow transition">
                ➕ สร้างทีมใหม่ใน${fZone.name}
              </button>
            </div>
          `;

        return `
          <div class="rounded-[32px] border-2 ${fZone.wrapperBorder} ${fZone.wrapperBg} p-4 sm:p-6 space-y-5 shadow-2xl">
            <!-- Outer Field Header (สนามหลัก / สนามรอง ครอบคลุมทีม) -->
            <div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-2xl border ${fZone.headerClass} shadow-lg">
              <div class="flex items-center gap-3.5 flex-wrap">
                <div class="w-11 h-11 rounded-2xl bg-slate-950/80 border border-slate-700/80 flex items-center justify-center text-2xl shadow-inner">
                  ${fZone.icon}
                </div>
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="text-lg sm:text-xl font-extrabold text-white tracking-wide">${fZone.fullName}</h2>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold border ${fZone.badgeClass}">
                      ครอบคลุม ${fieldTeams.length} ทีม ${fieldTeams.length ? `(${fieldTeams.map(t => t.name).join(', ')})` : ''}
                    </span>
                  </div>
                  <p class="text-xs text-slate-300 mt-0.5">${fZone.subtitle} • สามารถกดย้ายทีมระหว่างสนามหลักและสนามรองได้ที่หัวการ์ดของแต่ละทีม</p>
                </div>
              </div>

              <!-- Field KPIs & Quick Actions -->
              <div class="flex flex-wrap items-center gap-2.5">
                <div class="flex flex-wrap items-center gap-2 text-xs text-slate-200 bg-slate-950/85 px-3.5 py-2 rounded-xl border border-slate-800">
                  <span>ทีม: <strong class="text-white">${fieldTeams.length}</strong></span>
                  <span>•</span>
                  <span>ปาร์ตี้รวม: <strong class="text-white">${allFieldParties.length} ตี้</strong></span>
                  <span>•</span>
                  <span>สมาชิก: <strong class="text-emerald-400">${allFieldMembers.length}/${allFieldParties.length * 5} คน</strong> <span class="text-[10px] text-slate-400">(พร้อม ${readyInField} / ลา ${leaveInField})</span></span>
                  <span>•</span>
                  <span>เฉลี่ย Gear ${fZone.name}: <strong class="mono text-amber-300">${fieldAvgGear.toLocaleString()}</strong></span>
                </div>

                <div class="flex items-center gap-1.5">
                  <button onclick="openExportImageModal('field_${fZone.key}')" class="px-3 py-2 rounded-xl bg-fuchsia-600/25 hover:bg-fuchsia-600/40 text-fuchsia-200 border border-fuchsia-500/40 text-xs font-semibold transition flex items-center gap-1" title="ส่งออกรูปภาพเฉพาะ ${fZone.name}">
                    <span>📸 รูป${fZone.name}</span>
                  </button>
                  <button onclick="openCreateTeamModal('${fZone.key}')" class="px-3 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow transition flex items-center gap-1">
                    <span>➕ สร้างทีมใน${fZone.name}</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Teams enclosed inside this Field -->
            <div class="space-y-5 pl-0 sm:pl-2">
              ${teamsCardsHtml}
            </div>
          </div>
        `;
      }).join('');
    }

    function handlePoolClick(memberId) {
      if (selectedSource && selectedSource.memberId === memberId) {
        selectedSource = null;
      } else {
        selectedSource = { type: 'pool', memberId };
      }
      renderBoard();
    }

    function handleSlotClick(partyId, slotIndex) {
      const party = parties.find(p => p.id === partyId);
      if (!party) return;
      const targetMemberId = party.slots[slotIndex];

      if (!selectedSource) {
        if (targetMemberId) {
          selectedSource = { type: 'slot', partyId, slotIndex, memberId: targetMemberId };
          renderBoard();
        }
        return;
      }

      if (selectedSource.type === 'pool') {
        parties.forEach(p => {
          const i = p.slots.indexOf(selectedSource.memberId);
          if (i !== -1) p.slots[i] = null;
        });
        party.slots[slotIndex] = selectedSource.memberId;
        selectedSource = null;
      } else if (selectedSource.type === 'slot') {
        const srcParty = parties.find(p => p.id === selectedSource.partyId);
        if (srcParty) {
          const temp = party.slots[slotIndex];
          party.slots[slotIndex] = selectedSource.memberId;
          srcParty.slots[selectedSource.slotIndex] = temp;
        }
        selectedSource = null;
      }
      renderAll();
    }

    function removeMemberFromSlot(partyId, slotIndex) {
      const party = parties.find(p => p.id === partyId);
      if (party) party.slots[slotIndex] = null;
      renderAll();
    }

    function populateClassFilterDropdown() {
      const select = document.getElementById('rosterClassFilter');
      if (!select) return;
      const currentVal = select.value || 'all';
      const counts = {};
      members.forEach(m => { counts[m.job] = (counts[m.job] || 0) + 1; });
      const sortedJobs = Object.keys(counts).sort((a, b) => counts[b] - counts[a]);
      select.innerHTML = `<option value="all">ทุกคลาสอาชีพ (${sortedJobs.length} คลาส)</option>` +
        sortedJobs.map(j => `<option value="${j}">${j} (${counts[j]} คน)</option>`).join('');
      if (counts[currentVal]) select.value = currentVal;
    }

    function renderRosterTable() {
      syncMembersStatusForSelectedDate();
      const q = (document.getElementById('rosterSearch').value || '').toLowerCase();
      const cls = document.getElementById('rosterClassFilter').value;
      const sortBy = document.getElementById('rosterSortBy').value;

      let list = members.filter(m => {
        if (cls !== 'all' && m.job !== cls) return false;
        if (activeJobBarFamily !== 'all' && getJobFamily(m.job).familyKey !== activeJobBarFamily) return false;
        if (!q) return true;
        return m.name.toLowerCase().includes(q) || m.job.toLowerCase().includes(q) || m.position.toLowerCase().includes(q) || m.title.toLowerCase().includes(q);
      });

      list.sort((a, b) => {
        if (sortBy === 'gear_desc') return b.gear - a.gear;
        if (sortBy === 'gear_asc') return a.gear - b.gear;
        if (sortBy === 'lv_desc') return b.lv - a.lv || b.gear - a.gear;
        if (sortBy === 'act_desc') return b.weeklyActivity - a.weeklyActivity;
        if (sortBy === 'contrib_desc') return b.totalContrib - a.totalContrib;
        return (a.csvId || 0) - (b.csvId || 0);
      });

      const tbody = document.getElementById('rosterTableBody');
      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="11" class="py-12 text-center text-slate-500 text-xs sm:text-sm">
              ยังไม่มีข้อมูลสมาชิกที่ตรงเงื่อนไข — กดปุ่ม <strong>"➕ เพิ่มสมาชิก"</strong> หรือ <strong>"📂 นำเข้า .CSV"</strong> ด้านบนได้เลยครับ
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = list.map(m => {
        const meta = getJobMeta(m.job);
        const pInfo = findMemberPartyInfo(m.id);
        let partyBadge = `<span class="text-xs text-slate-500">ยังไม่ได้ลงตี้</span>`;
        if (pInfo) {
          const tTheme = getTeamTheme(pInfo.team.color);
          partyBadge = `
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg text-xs font-semibold border ${tTheme.badgeClass}">
              <span class="w-2 h-2 rounded-full ${tTheme.dotClass}"></span>
              <span>${pInfo.fieldZone.icon} ${pInfo.fieldZone.shortName} • ${pInfo.team.name} • ${pInfo.party.name}</span>
            </span>
          `;
        }

        const onlineColor = m.onlineStatus === '[ออนไลน์]'
          ? 'text-emerald-400 font-semibold'
          : (m.onlineStatus.includes('วัน') && !['ออฟไลน์ 1 วัน', 'ออฟไลน์ 2 วัน', 'ออฟไลน์ 3 วัน'].includes(m.onlineStatus) ? 'text-rose-400' : 'text-sky-300');

        const isChecked = selectedMemberIds.has(m.id) ? 'checked' : '';

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="py-2.5 px-3">
              <input type="checkbox" data-id="${m.id}" ${isChecked} onchange="toggleSelectMember('${m.id}', this.checked)" class="member-row-checkbox rounded bg-slate-900 border-slate-700 text-indigo-600 focus:ring-0 cursor-pointer" />
            </td>
            <td class="py-2.5 px-3 mono text-xs text-slate-400">#${m.csvId || '-'}</td>
            <td class="py-2.5 px-3">
              <div class="flex items-center gap-2">
                ${renderJobEmblem(m.job, 28)}
                ${renderColoredMemberName(m)}
              </div>
            </td>
            <td class="py-2.5 px-3 mono text-xs">${m.lv}</td>
            <td class="py-2.5 px-3">
              <span style="${meta.badgeStyle}" class="px-2 py-0.5 rounded text-xs font-medium border">${m.job}</span>
            </td>
            <td class="py-2.5 px-3">${formatGearBadge(m.gear)}</td>
            <td class="py-2.5 px-3 text-xs text-slate-300">${m.position} <span class="text-slate-500">(${m.title})</span></td>
            <td class="py-2.5 px-3 mono text-xs text-slate-300">${m.weeklyActivity} / <span class="text-amber-300">${m.totalContrib.toLocaleString()}</span></td>
            <td class="py-2.5 px-3 text-xs ${onlineColor}">${m.onlineStatus}</td>
            <td class="py-2.5 px-3">${partyBadge}</td>
            <td class="py-2.5 px-3 text-right">
              <div class="inline-flex items-center gap-1.5">
                <button onclick="toggleMemberLeave('${m.id}')" class="px-2.5 py-1 rounded-lg text-xs font-medium transition ${m.status === 'ready' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30 hover:bg-amber-500/30'}">
                  ${m.status === 'ready' ? '✅ พร้อมวอร์' : `🏖️ ลา (${m.leaveReason || 'วันนี้'})`}
                </button>
                <button onclick="deleteMember('${m.id}')" class="px-2.5 py-1 rounded-lg bg-rose-500/15 hover:bg-rose-500/30 border border-rose-500/30 text-rose-300 text-xs font-medium transition">
                  🗑️ ลบ
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    async function toggleMemberLeave(memberId) {
      const m = members.find(x => String(x.id) === String(memberId));
      if (!m) return;
      ensureLeaveHistoryObject(m);
      m._leaveMigrated = true;
      if (!m.leaveHistory[selectedDate]) {
        const defaultReason = m.onlineStatus !== '[ออนไลน์]' ? m.onlineStatus : 'ติดธุระส่วนตัว';
        m.leaveHistory[selectedDate] = {
          status: 'leave',
          type: 'ลากิลด์วอร์ (GVG)',
          reason: defaultReason,
          updatedAt: new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })
        };
        m.status = 'leave';
        m.leaveReason = defaultReason;
        m.leaveType = 'ลากิลด์วอร์ (GVG)';
        syncMembersStatusForSelectedDate();
        renderAll();
        showToast(`🏖️ บันทึกการลาของ "${m.name}" ในวันที่ ${formatThaiDateShort(selectedDate)} ลง Database แล้ว`, 'info');
        await saveLeaveToDatabaseSilent(`สลับสถานะลา: ${m.name}`);
      } else {
        delete m.leaveHistory[selectedDate];
        m.status = 'ready';
        m.leaveReason = '';
        m.leaveType = '';
        syncMembersStatusForSelectedDate();
        renderAll();
        showToast(`✅ ตั้ง "${m.name}" เป็นพร้อมวอร์ในวันที่ ${formatThaiDateShort(selectedDate)} แล้ว`, 'success');
        await saveLeaveToDatabaseSilent(`ยกเลิกการลา: ${m.name}`);
      }
    }

    async function markOfflineAsLeave() {
      const longOfflineList = ['ออฟไลน์ 4 วัน', 'ออฟไลน์ 5 วัน', 'ออฟไลน์ 6 วัน', 'ออฟไลน์เกิน 7 วัน'];
      const nowStamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
      let markedCount = 0;

      members.forEach(m => {
        ensureLeaveHistoryObject(m);
        m._leaveMigrated = true;
        if (longOfflineList.includes(m.onlineStatus)) {
          m.leaveHistory[selectedDate] = {
            status: 'leave',
            type: 'ลาทั้งวัน (ไม่เข้าเกม)',
            reason: m.onlineStatus,
            updatedAt: nowStamp
          };
          markedCount++;
        }
      });

      syncMembersStatusForSelectedDate();
      renderAll();
      showToast(`💤 บันทึกคนออฟไลน์ตั้งแต่ 4 วันขึ้นไป (${markedCount} คน) เป็น "ลา" ในวันที่ ${formatThaiDateShort(selectedDate)} แล้ว`, 'info');
      await saveLeaveToDatabaseSilent('ตั้งคนออฟไลน์เป็นลาประจำวัน');
    }

    async function markAllReady() {
      members.forEach(m => {
        ensureLeaveHistoryObject(m);
        m._leaveMigrated = true;
        if (m.leaveHistory[selectedDate]) {
          delete m.leaveHistory[selectedDate];
        }
        m.status = 'ready';
        m.leaveReason = '';
        m.leaveType = '';
      });
      syncMembersStatusForSelectedDate();
      renderAll();
      showToast(`✅ ตั้งสมาชิกทุกคนเป็นสถานะ "พร้อมวอร์" สำหรับวันที่ ${formatThaiDateShort(selectedDate)} แล้ว`, 'success');
      await saveLeaveToDatabaseSilent('ตั้งทุกคนพร้อมวอร์ประจำวัน');
    }

    function renderMemberQuickCheck() {
      syncMembersStatusForSelectedDate();
      const q = (document.getElementById('memberQuickSearch').value || '').trim().toLowerCase();
      const resEl = document.getElementById('memberQuickResult');
      if (!q) {
        resEl.innerHTML = `<div class="text-center text-xs text-slate-500 py-4">กรุณาพิมพ์ชื่อตัวละครด้านบนเพื่อตรวจสอบทีม ปาร์ตี้ และแจ้งลาประจำวัน (${formatThaiDateFull(selectedDate)})</div>`;
        return;
      }
      const matches = members.filter(m => m.name.toLowerCase().includes(q));
      if (!matches.length) {
        resEl.innerHTML = `<div class="text-center text-sm text-rose-400 py-4">ไม่พบชื่อตัวละครนี้ในรายชื่อกิลด์</div>`;
        return;
      }
      resEl.innerHTML = matches.map(m => {
        const pInfo = findMemberPartyInfo(m.id);
        const meta = getJobMeta(m.job);
        const rec = m.leaveHistory ? m.leaveHistory[selectedDate] : null;

        const selfLeaveControlsHtml = `
          <div class="mt-3 pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2">
            <div class="text-xs text-slate-300">
              <span>📅 สถานะวันที่ <strong>${formatThaiDateFull(selectedDate)}</strong>:</span>
              ${rec
                ? `<span class="ml-1.5 px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 font-semibold">🏖️ ${rec.type} (${rec.reason})</span>`
                : `<span class="ml-1.5 px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold">✅ พร้อมวอร์</span>`
              }
            </div>
            <div class="flex items-center gap-1.5">
              ${rec ? `
                <button onclick="editMemberDailyLeaveReason('${m.id}', '${selectedDate}')" class="px-3 py-1 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs border border-slate-700 transition">✏️ แก้เหตุผล</button>
                <button onclick="setMemberDailyLeaveQuick('${m.id}', '${selectedDate}', 'ready')" class="px-3 py-1 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition">✅ เปลี่ยนเป็นพร้อมวอร์</button>
              ` : `
                <button onclick="promptMemberSelfLeave('${m.id}')" class="px-3.5 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold shadow transition">🏖️ แจ้งลาวันนี้ (บันทึกลง Cloud)</button>
              `}
            </div>
          </div>
        `;

        if (!pInfo) {
          return `
            <div style="${meta.cardTintStyle}" class="p-4 rounded-2xl border mb-3 space-y-2">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-3">
                  ${renderJobEmblem(m.job, 42)}
                  <div>
                    <div class="flex items-center gap-2">
                      ${renderColoredMemberName(m, 'text-sm')}
                      <span class="text-xs text-slate-300">(Lv.${m.lv} ${m.job})</span>
                    </div>
                    <div class="text-xs text-slate-300 mt-1">คะแนน Gear: ${m.gear.toLocaleString()}</div>
                  </div>
                </div>
                <span class="px-3 py-1 rounded-lg bg-slate-800 text-slate-300 text-xs">ยังไม่ได้จัดลงปาร์ตี้</span>
              </div>
              ${selfLeaveControlsHtml}
            </div>
          `;
        }
        const tTheme = getTeamTheme(pInfo.team.color);
        const teammates = pInfo.party.slots.map(id => members.find(x => x.id === id)).filter(Boolean);
        return `
          <div class="p-4 rounded-2xl border-2 ${tTheme.containerBorder} ${tTheme.containerBg} mb-3 space-y-3">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-3">
                ${renderJobEmblem(m.job, 44)}
                <div>
                  <div class="flex items-center gap-1.5 flex-wrap mb-1">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold border ${pInfo.fieldZone.badgeClass}">
                      <span>${pInfo.fieldZone.icon} ${pInfo.fieldZone.name}</span>
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold border ${tTheme.badgeClass}">
                      <span class="w-2 h-2 rounded-full ${tTheme.dotClass}"></span>
                      <span>${pInfo.team.name}</span>
                    </span>
                  </div>
                  <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2 flex-wrap">
                    ${renderColoredMemberName(m, 'text-sm')}
                    <span>อยู่ใน <span class="underline decoration-amber-400">${pInfo.party.name}</span> (ช่องที่ ${pInfo.slotIndex + 1})</span>
                  </h3>
                </div>
              </div>
              ${formatGearBadge(m.gear)}
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-5 gap-2 pt-2 border-t border-slate-800/80">
              ${teammates.map(tm => {
                const tmMeta = getJobMeta(tm.job);
                return `
                  <div style="${tmMeta.cardTintStyle}" class="p-2.5 rounded-xl border ${tm.id === m.id ? 'ring-2 ring-amber-400' : ''} text-xs flex items-center gap-2">
                    ${renderJobEmblem(tm.job, 28)}
                    <div class="min-w-0">
                      <div class="truncate">${renderColoredMemberName(tm, 'px-1.5 py-0 text-[11px]')}</div>
                      <div class="text-[10px] text-slate-300 mt-0.5 truncate">${tm.job} • ${(tm.gear/1000).toFixed(1)}k</div>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
            ${selfLeaveControlsHtml}
          </div>
        `;
      }).join('');
    }

    function promptMemberSelfLeave(memberId) {
      const m = members.find(x => String(x.id) === String(memberId));
      if (!m) return;
      openCustomDialog({
        title: `🏖️ แจ้งลาประจำวันที่ ${formatThaiDateFull(selectedDate)}`,
        message: `ตัวละคร: ${m.name} (${m.job})\nกรุณาระบุเหตุผลการลา (จะถูกบันทึกลงฐานข้อมูลทันที):`,
        showInput: true,
        defaultInput: 'ติดธุระส่วนตัว',
        confirmText: '💾 บันทึกการลา',
        onConfirm: async (reasonVal) => {
          ensureLeaveHistoryObject(m);
          m._leaveMigrated = true;
          m.leaveHistory[selectedDate] = {
            status: 'leave',
            type: 'ลากิลด์วอร์ (GVG)',
            reason: (reasonVal || '').trim() || 'ติดธุระส่วนตัว',
            updatedAt: new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })
          };
          syncMembersStatusForSelectedDate();
          renderAll();
          showToast(`🏖️ บันทึกการลาของ "${m.name}" ลง Database เรียบร้อยแล้ว`, 'success');
          await saveLeaveToDatabaseSilent(`ลูกกิลด์แจ้งลา: ${m.name}`);
        }
      });
    }

    function generateSummaryText() {
      syncMembersStatusForSelectedDate();
      const lines = [];
      lines.push(`⚔️ สรุปผังทัพกิลด์วอร์ — ${guildName}`);
      lines.push(`📅 ประจำวันที่: ${formatThaiDateFull(selectedDate)}`);
      const readyCount = members.filter(m => m.status === 'ready').length;
      const leaveList = members.filter(m => m.status === 'leave');
      lines.push(`✅ พร้อมวอร์: ${readyCount} คน | 🏖️ แจ้งลาวันนี้: ${leaveList.length} คน`);
      lines.push(`========================================`);

      FIELD_ZONES.forEach(fz => {
        const fieldTeams = teams.filter(t => t.field === fz.key);
        if (!fieldTeams.length) return;
        lines.push(`\n${fz.icon} ====== 【 ${fz.name} (${fieldTeams.map(t => t.name).join(', ')}) 】 ======`);
        fieldTeams.forEach(team => {
          const theme = getTeamTheme(team.color);
          const teamParties = parties.filter(p => p.teamId === team.id);
          lines.push(`\n  🚩 【 ${team.name} (สี${theme.name} • ${fz.name}) 】`);
          let hasAnyMember = false;
          teamParties.forEach(p => {
            const pMembers = p.slots.map(id => members.find(m => m.id === id)).filter(Boolean);
            if (!pMembers.length) return;
            hasAnyMember = true;
            const avgG = Math.round(pMembers.reduce((s, m) => s + m.gear, 0) / pMembers.length);
            const names = pMembers.map(m => {
              const leaveTag = m.status === 'leave' ? `[ลา: ${m.leaveReason}] ` : '';
              return `${leaveTag}${m.name} (${m.job} • ${(m.gear/1000).toFixed(1)}k)`;
            }).join(' | ');
            lines.push(`    • ${p.name} [เฉลี่ย ${avgG.toLocaleString()}]: ${names}`);
          });
          if (!hasAnyMember) {
            lines.push(`    • (ยังไม่มีสมาชิกในทีมนี้)`);
          }
        });
      });

      if (leaveList.length > 0) {
        lines.push(`\n🏖️ 【 รายชื่อคนแจ้งลาประจำวันที่ ${formatThaiDateShort(selectedDate)} (${leaveList.length} คน) 】`);
        leaveList.forEach((m, idx) => {
          const rec = m.leaveHistory?.[selectedDate];
          lines.push(`  ${idx + 1}. ${m.name} (${m.job}) — ${rec?.type || 'ลา'} : ${m.leaveReason || '-'}`);
        });
      }

      return lines.join('\n');
    }

    function copySummaryText() {
      const textarea = document.getElementById('summaryPreviewText');
      textarea.select();
      document.execCommand('copy');
      showToast('📋 คัดลอกข้อความสรุปผังทัพเรียบร้อยแล้ว!', 'success');
    }

    async function sendToDiscordWebhook() {
      const url = document.getElementById('discordWebhookInput').value.trim();
      if (!url) {
        showToast('กรุณาวางลิงก์ Discord Webhook URL ก่อนครับ', 'danger');
        return;
      }
      const content = document.getElementById('summaryPreviewText').value;
      try {
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: content.slice(0, 1990) })
        });
        if (res.ok) showToast('🚀 ส่งผังทัพเข้า Discord สำเร็จ!', 'success');
        else showToast('ส่งไม่สำเร็จ กรุณาตรวจสอบลิงก์ Webhook', 'danger');
      } catch (err) {
        showToast('เกิดข้อผิดพลาดในการเชื่อมต่อ Discord Webhook', 'danger');
      }
    }

    function exportLineupCSV() {
      if (members.length === 0) {
        showToast('ยังไม่มีข้อมูลสมาชิกให้ส่งออก CSV ครับ', 'danger');
        return;
      }
      syncMembersStatusForSelectedDate();
      const headers = ['ID','ชื่อผู้เล่น','Lv.','คลาส','Title','เพศ','ตำแหน่ง','คะแนน Gear','กิจกรรมสัปดาห์นี้','แต้มสนับสนุนสัปดาห์นี้','แต้มสนับสนุนสะสม','สถานะออนไลน์','สนาม (หลัก/รอง)','ทีม','ปาร์ตี้กิลด์วอร์',`สถานะวันที่ (${selectedDate})`];
      const rows = members.map(m => {
        const pInfo = findMemberPartyInfo(m.id);
        const fieldStr = pInfo ? pInfo.fieldZone.name : '-';
        const teamStr = pInfo ? pInfo.team.name : '-';
        const partyStr = pInfo ? pInfo.party.name : 'ไม่ได้ลงตี้';
        const statusStr = m.status === 'ready' ? 'พร้อมวอร์' : `ลา (${m.leaveType || ''} - ${m.leaveReason || ''})`;
        return [
          m.csvId, m.name, m.lv, m.job, m.title, m.gender, m.position,
          m.gear, m.weeklyActivity, m.weeklyContrib, m.totalContrib, m.onlineStatus,
          fieldStr, teamStr, partyStr, statusStr.replace(/,/g, ' ')
        ].join(',');
      });
      const csvContent = '\uFEFF' + headers.join(',') + '\n' + rows.join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `ผังทัพ_${guildName.replace(/\s+/g, '_')}_${selectedDate}.csv`;
      a.click();
    }


    // ============================================================================
    // WEEKLY EVENT ATTENDANCE SYSTEM (6 กิจกรรมหลัก แยก Guild League อังคาร/พฤหัสบดี)
    // ============================================================================
    const WEEKLY_EVENTS_CONFIG = [
      {
        key: 'mirror_world',
        name: 'Mirror World',
        shortName: 'Mirror World',
        icon: '🪞',
        accentClass: 'border-cyan-500/40 bg-cyan-950/25 text-cyan-300',
        btnActiveClass: 'bg-cyan-600 hover:bg-cyan-500 text-white'
      },
      {
        key: 'hazy_maze',
        name: 'The Hazy Maze Forest',
        shortName: 'Hazy Maze',
        icon: '🌲',
        accentClass: 'border-emerald-500/40 bg-emerald-950/25 text-emerald-300',
        btnActiveClass: 'bg-emerald-600 hover:bg-emerald-500 text-white'
      },
      {
        key: 'guild_league_tue',
        name: 'Guild League (อังคาร)',
        shortName: 'GL (อังคาร)',
        icon: '⚔️',
        accentClass: 'border-amber-500/40 bg-amber-950/25 text-amber-300',
        btnActiveClass: 'bg-amber-500 hover:bg-amber-400 text-slate-950'
      },
      {
        key: 'guild_league_thu',
        name: 'Guild League (พฤหัสบดี)',
        shortName: 'GL (พฤหัสฯ)',
        icon: '🛡️',
        accentClass: 'border-orange-500/40 bg-orange-950/25 text-orange-300',
        btnActiveClass: 'bg-orange-500 hover:bg-orange-400 text-white'
      },
      {
        key: 'polarity_zone',
        name: 'Polarity Zone',
        shortName: 'Polarity Zone',
        icon: '⚡',
        accentClass: 'border-purple-500/40 bg-purple-950/25 text-purple-300',
        btnActiveClass: 'bg-purple-600 hover:bg-purple-500 text-white'
      },
      {
        key: 'castle_siege',
        name: 'ศึกชิงปราสาท',
        shortName: 'ศึกชิงปราสาท',
        icon: '🏰',
        accentClass: 'border-rose-500/40 bg-rose-950/25 text-rose-300',
        btnActiveClass: 'bg-rose-600 hover:bg-rose-500 text-white'
      }
    ];

    function getWeekMondayISO(dateInput = new Date()) {
      let dt;
      if (typeof dateInput === 'string' && dateInput.includes('-')) {
        const [y, m, d] = dateInput.split('-').map(Number);
        dt = new Date(y, m - 1, d);
      } else {
        dt = new Date(dateInput);
      }
      const day = dt.getDay();
      const diffToMonday = day === 0 ? -6 : 1 - day;
      dt.setDate(dt.getDate() + diffToMonday);
      return getLocalDateISO(dt);
    }

    function getWeekSundayISO(mondayIso) {
      const [y, m, d] = mondayIso.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      dt.setDate(dt.getDate() + 6);
      return getLocalDateISO(dt);
    }

    function formatThaiWeekRange(mondayIso) {
      if (!mondayIso) return '';
      const sunIso = getWeekSundayISO(mondayIso);
      return `${formatThaiDateShort(mondayIso)} - ${formatThaiDateFull(sunIso)}`;
    }

    let selectedWeekMonday = getWeekMondayISO(new Date());
    let activeEventSubView = 'matrix';

    function ensureWeeklyEventsObject(m) {
      if (!m.weeklyEvents || typeof m.weeklyEvents !== 'object' || Array.isArray(m.weeklyEvents)) {
        m.weeklyEvents = {};
      }
      if (!m.weeklyEvents[selectedWeekMonday] || typeof m.weeklyEvents[selectedWeekMonday] !== 'object') {
        m.weeklyEvents[selectedWeekMonday] = {};
      }
    }

    // ดึงข้อมูลสถานะแต่ละกิจกรรม (พร้อมรองรับข้อมูลเก่าจาก key 'guild_league' เดิมอัตโนมัติ)
    function getMemberEventRecord(m, weekKey, eventKey) {
      if (!m.weeklyEvents || !m.weeklyEvents[weekKey]) return { status: 'none', note: '' };
      if (m.weeklyEvents[weekKey][eventKey]) return m.weeklyEvents[weekKey][eventKey];
      if ((eventKey === 'guild_league_tue' || eventKey === 'guild_league_thu') && m.weeklyEvents[weekKey]['guild_league']) {
        return m.weeklyEvents[weekKey]['guild_league'];
      }
      return { status: 'none', note: '' };
    }

    function changeSelectedWeekByDate(dateVal) {
      if (!dateVal) return;
      selectedWeekMonday = getWeekMondayISO(dateVal);
      const picker = document.getElementById('eventWeekDatePicker');
      if (picker) picker.value = selectedWeekMonday;
      renderAll();
    }

    function shiftSelectedWeek(deltaWeeks) {
      const [y, m, d] = selectedWeekMonday.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      dt.setDate(dt.getDate() + deltaWeeks * 7);
      changeSelectedWeekByDate(getLocalDateISO(dt));
    }

    function setSelectedWeekToCurrent() {
      changeSelectedWeekByDate(getLocalDateISO(new Date()));
      showToast(`📅 สลับไปยังสัปดาห์ปัจจุบัน (${formatThaiWeekRange(selectedWeekMonday)})`, 'info');
    }

    function switchEventSubView(viewName) {
      activeEventSubView = viewName;
      ['matrix', 'ranking'].forEach(v => {
        const el = document.getElementById('eventSubView-' + v);
        const btn = document.getElementById('eventSubBtn-' + v);
        if (el) el.classList.toggle('hidden', v !== viewName);
        if (btn) {
          btn.className = v === viewName
            ? 'px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow transition flex items-center gap-1.5'
            : 'px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white transition flex items-center gap-1.5';
        }
      });
      renderWeeklyEventsSection();
    }

    async function handleEventCellClick(memberId, eventKey) {
      const m = members.find(x => String(x.id) === String(memberId));
      if (!m) return;
      ensureWeeklyEventsObject(m);

      const mode = document.getElementById('eventClickModeSelect')?.value || 'joined';
      const curRec = getMemberEventRecord(m, selectedWeekMonday, eventKey);
      const evConf = WEEKLY_EVENTS_CONFIG.find(e => e.key === eventKey);
      const nowStamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });

      if (mode === 'note') {
        openCustomDialog({
          title: `💬 หมายเหตุกิจกรรม ${evConf ? evConf.name : eventKey}`,
          message: `สมาชิก: ${m.name} (${m.job})\nสัปดาห์: ${formatThaiWeekRange(selectedWeekMonday)}\nระบุหมายเหตุ (เช่น มาสาย, ลงรอบซ้อม, ติดธุระ):`,
          showInput: true,
          defaultInput: curRec.note || '',
          confirmText: '💾 บันทึกหมายเหตุ',
          onConfirm: async (noteVal) => {
            m.weeklyEvents[selectedWeekMonday][eventKey] = {
              status: curRec.status === 'none' ? 'joined' : curRec.status,
              note: (noteVal || '').trim(),
              updatedAt: nowStamp
            };
            renderAll();
            await saveLeaveToDatabaseSilent(`บันทึกหมายเหตุกิจกรรม: ${m.name}`);
          }
        });
        return;
      }

      let nextStatus = 'joined';
      if (mode === 'cycle') {
        const order = ['none', 'joined', 'leave', 'absent'];
        const nextIdx = (order.indexOf(curRec.status || 'none') + 1) % order.length;
        nextStatus = order[nextIdx];
      } else {
        nextStatus = (curRec.status === mode) ? 'none' : mode;
      }

      if (nextStatus === 'none') {
        delete m.weeklyEvents[selectedWeekMonday][eventKey];
      } else {
        m.weeklyEvents[selectedWeekMonday][eventKey] = {
          status: nextStatus,
          note: curRec.note || '',
          updatedAt: nowStamp
        };
      }

      renderAll();
      await saveLeaveToDatabaseSilent(`อัปเดตกิจกรรม ${evConf?.shortName || eventKey}: ${m.name}`);
    }

    async function setMemberAllEventsInWeek(memberId, targetStatus) {
      const m = members.find(x => String(x.id) === String(memberId));
      if (!m) return;
      ensureWeeklyEventsObject(m);
      const nowStamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });

      if (targetStatus === 'none') {
        m.weeklyEvents[selectedWeekMonday] = {};
      } else {
        WEEKLY_EVENTS_CONFIG.forEach(ev => {
          m.weeklyEvents[selectedWeekMonday][ev.key] = {
            status: targetStatus,
            note: m.weeklyEvents[selectedWeekMonday][ev.key]?.note || '',
            updatedAt: nowStamp
          };
        });
      }
      renderAll();
      showToast(`✅ อัปเดตทั้ง ${WEEKLY_EVENTS_CONFIG.length} กิจกรรมของ "${m.name}" เรียบร้อยแล้ว`, 'success');
      await saveLeaveToDatabaseSilent(`อัปเดต ${WEEKLY_EVENTS_CONFIG.length} กิจกรรม: ${m.name}`);
    }

    async function bulkSetSingleEventForGuild(eventKey, targetStatus) {
      const evConf = WEEKLY_EVENTS_CONFIG.find(e => e.key === eventKey);
      if (!evConf || members.length === 0) return;

      const nowStamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
      members.forEach(m => {
        ensureWeeklyEventsObject(m);
        if (targetStatus === 'none') {
          delete m.weeklyEvents[selectedWeekMonday][eventKey];
        } else {
          const cur = getMemberEventRecord(m, selectedWeekMonday, eventKey);
          if (cur.status !== 'leave') {
            m.weeklyEvents[selectedWeekMonday][eventKey] = {
              status: targetStatus,
              note: cur.note || '',
              updatedAt: nowStamp
            };
          }
        }
      });

      renderAll();
      showToast(`🏆 อัปเดตกิจกรรม "${evConf.name}" ทั้งกิลด์และบันทึกลง Database แล้ว`, 'success');
      await saveLeaveToDatabaseSilent(`เช็คชื่อทั้งกิลด์: ${evConf.name}`);
    }

    async function markAllMembersAllEvents(targetStatus) {
      if (members.length === 0) return;
      const nowStamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
      members.forEach(m => {
        ensureWeeklyEventsObject(m);
        WEEKLY_EVENTS_CONFIG.forEach(ev => {
          const cur = getMemberEventRecord(m, selectedWeekMonday, ev.key);
          if (cur.status !== 'leave') {
            m.weeklyEvents[selectedWeekMonday][ev.key] = {
              status: targetStatus,
              note: cur.note || '',
              updatedAt: nowStamp
            };
          }
        });
      });
      renderAll();
      showToast(`✅ ตั้งสมาชิกทุกคนเข้าร่วมครบทั้ง ${WEEKLY_EVENTS_CONFIG.length} กิจกรรมในสัปดาห์นี้แล้ว`, 'success');
      await saveLeaveToDatabaseSilent('ตั้งเข้าครบทุกกิจกรรมทั้งกิลด์');
    }

    function clearAllEventsForSelectedWeek() {
      openCustomDialog({
        title: `🗑️ ล้างข้อมูลการเข้ากิจกรรมประจำสัปดาห์`,
        message: `ต้องการล้างข้อมูลเช็คชื่อทั้ง ${WEEKLY_EVENTS_CONFIG.length} กิจกรรมของสัปดาห์ ${formatThaiWeekRange(selectedWeekMonday)} ใช่หรือไม่?`,
        confirmText: 'ล้างข้อมูลสัปดาห์นี้',
        onConfirm: async () => {
          members.forEach(m => {
            if (m.weeklyEvents && m.weeklyEvents[selectedWeekMonday]) {
              delete m.weeklyEvents[selectedWeekMonday];
            }
          });
          renderAll();
          showToast(`🗑️ ล้างข้อมูลกิจกรรมของสัปดาห์ที่เลือกเรียบร้อยแล้ว`, 'danger');
          await saveLeaveToDatabaseSilent('ล้างข้อมูลกิจกรรมประจำสัปดาห์');
        }
      });
    }

    // ดึงข้อมูลวันลารายวันในสัปดาห์นั้นมาจับคู่เข้ากับ Guild League (อังคาร / พฤหัสบดี) และศึกชิงปราสาทอัตโนมัติ
    async function syncWeeklyEventsFromDailyLeave() {
      const weekDates = getDatesBetween(selectedWeekMonday, getWeekSundayISO(selectedWeekMonday));
      const nowStamp = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
      let syncedCount = 0;

      members.forEach(m => {
        ensureLeaveHistoryObject(m);
        ensureWeeklyEventsObject(m);

        weekDates.forEach(dStr => {
          const leaveRec = m.leaveHistory[dStr];
          if (!leaveRec) return;

          const [y, mo, da] = dStr.split('-').map(Number);
          const dayOfWeek = new Date(y, mo - 1, da).getDay(); // 2 = อังคาร, 4 = พฤหัสบดี
          const lType = leaveRec.type || '';
          const noteText = `ลาวันที่ ${formatThaiDateShort(dStr)}: ${leaveRec.reason || ''}`;

          if (lType.includes('ศึกชิงปราสาท')) {
            const cur = getMemberEventRecord(m, selectedWeekMonday, 'castle_siege');
            if (cur.status === 'none') {
              m.weeklyEvents[selectedWeekMonday]['castle_siege'] = {
                status: 'leave',
                note: noteText,
                updatedAt: nowStamp
              };
              syncedCount++;
            }
          } else if (dayOfWeek === 2 && (lType.includes('กิลด์วอร์') || lType.includes('กิจกรรม') || lType.includes('ทั้งวัน'))) {
            // แจ้งลาตรงกับวันอังคาร -> ซิงค์เข้า Guild League (อังคาร)
            const cur = getMemberEventRecord(m, selectedWeekMonday, 'guild_league_tue');
            if (cur.status === 'none') {
              m.weeklyEvents[selectedWeekMonday]['guild_league_tue'] = {
                status: 'leave',
                note: noteText,
                updatedAt: nowStamp
              };
              syncedCount++;
            }
          } else if (dayOfWeek === 4 && (lType.includes('กิลด์วอร์') || lType.includes('กิจกรรม') || lType.includes('ทั้งวัน'))) {
            // แจ้งลาตรงกับวันพฤหัสบดี -> ซิงค์เข้า Guild League (พฤหัสบดี)
            const cur = getMemberEventRecord(m, selectedWeekMonday, 'guild_league_thu');
            if (cur.status === 'none') {
              m.weeklyEvents[selectedWeekMonday]['guild_league_thu'] = {
                status: 'leave',
                note: noteText,
                updatedAt: nowStamp
              };
              syncedCount++;
            }
          } else if (lType.includes('กิจกรรม') || lType.includes('ทั้งวัน')) {
            WEEKLY_EVENTS_CONFIG.forEach(ev => {
              const cur = getMemberEventRecord(m, selectedWeekMonday, ev.key);
              if (cur.status === 'none') {
                m.weeklyEvents[selectedWeekMonday][ev.key] = {
                  status: 'leave',
                  note: noteText,
                  updatedAt: nowStamp
                };
              }
            });
            syncedCount++;
          }
        });
      });

      renderAll();
      showToast(`🔗 ซิงค์ข้อมูลคนแจ้งลา (แยก Guild League อังคาร/พฤหัสฯ) แล้ว (${syncedCount} รายการ)`, 'success');
      await saveLeaveToDatabaseSilent('ซิงค์วันลาเข้าตารางกิจกรรมรายสัปดาห์');
    }

    function renderEventCellButtonHtml(m, eventKey) {
      const rec = getMemberEventRecord(m, selectedWeekMonday, eventKey);
      const st = rec.status || 'none';
      const noteBadge = rec.note
        ? `<div class="text-[9px] text-amber-200 truncate max-w-[115px] mt-0.5" title="${rec.note}">💬 ${rec.note}</div>`
        : '';

      if (st === 'joined') {
        return `
          <button onclick="handleEventCellClick('${m.id}', '${eventKey}')" class="w-full py-1.5 px-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 font-bold text-[11px] transition flex flex-col items-center justify-center shadow-sm">
            <span>✅ เข้าร่วม</span>
            ${noteBadge}
          </button>
        `;
      }
      if (st === 'leave') {
        return `
          <button onclick="handleEventCellClick('${m.id}', '${eventKey}')" class="w-full py-1.5 px-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-semibold text-[11px] transition flex flex-col items-center justify-center">
            <span>🏖️ แจ้งลา</span>
            ${noteBadge}
          </button>
        `;
      }
      if (st === 'absent') {
        return `
          <button onclick="handleEventCellClick('${m.id}', '${eventKey}')" class="w-full py-1.5 px-2 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 border border-rose-500/40 text-rose-300 font-semibold text-[11px] transition flex flex-col items-center justify-center">
            <span>❌ ขาด</span>
            ${noteBadge}
          </button>
        `;
      }
      return `
        <button onclick="handleEventCellClick('${m.id}', '${eventKey}')" class="w-full py-1.5 px-2 rounded-xl bg-slate-950/80 hover:bg-slate-800 border border-dashed border-slate-700 text-slate-500 hover:text-slate-300 text-[11px] transition flex flex-col items-center justify-center">
          <span>⚪ รอเช็ค</span>
          ${noteBadge}
        </button>
      `;
    }

    function renderWeeklyEventsSection() {
      const badgeEl = document.getElementById('eventWeekLabelBadge');
      if (badgeEl) badgeEl.textContent = `📅 สัปดาห์: ${formatThaiWeekRange(selectedWeekMonday)}`;

      const pickerEl = document.getElementById('eventWeekDatePicker');
      if (pickerEl && pickerEl.value !== selectedWeekMonday) pickerEl.value = selectedWeekMonday;

      ['eventTeamFilterSelect', 'eventRankingTeamFilter'].forEach(selId => {
        const teamSelect = document.getElementById(selId);
        if (teamSelect) {
          const prevTeam = teamSelect.value || 'all';
          teamSelect.innerHTML =
            `<option value="all">ทุกสนาม & ทุกทีม (${teams.length} ทีม)</option>` +
            `<option value="field_main">🏟️ เฉพาะสนามหลัก</option>` +
            `<option value="field_sub">🚩 เฉพาะสนามรอง</option>` +
            teams.map(t => `<option value="${t.id}">เฉพาะ ${t.name} (${getFieldZone(t.field).shortName})</option>`).join('') +
            `<option value="unassigned">เฉพาะคนยังไม่มีปาร์ตี้</option>`;
          if (['all', 'field_main', 'field_sub', 'unassigned'].includes(prevTeam) || teams.some(t => t.id === prevTeam)) {
            teamSelect.value = prevTeam;
          }
        }
      });

      let allWeeksLeaveAbsentTotal = 0;
      members.forEach(m => {
        const s = getMemberWeeklyEventSummaryAllWeeks(m);
        allWeeksLeaveAbsentTotal += s.leaveAndAbsent;
      });
      const subBadge = document.getElementById('eventSubBtnLeaveAbsentBadge');
      if (subBadge) {
        subBadge.textContent = `ลา/ขาด ${allWeeksLeaveAbsentTotal}`;
      }

      // 1. Render 6-Week Calendar Strip
      const stripEl = document.getElementById('eventWeekStripContainer');
      if (stripEl) {
        const [y, m, d] = selectedWeekMonday.split('-').map(Number);
        const centerMonday = new Date(y, m - 1, d);
        const currentMondayIso = getWeekMondayISO(new Date());
        const cards = [];

        for (let offset = -3; offset <= 2; offset++) {
          const dt = new Date(centerMonday);
          dt.setDate(dt.getDate() + offset * 7);
          const monIso = getLocalDateISO(dt);
          const sunIso = getWeekSundayISO(monIso);
          const isSelected = monIso === selectedWeekMonday;
          const isCurrent = monIso === currentMondayIso;

          let joinedTotal = 0, leaveTotal = 0, absentTotal = 0;
          const totalPossible = members.length * WEEKLY_EVENTS_CONFIG.length;
          members.forEach(mem => {
            WEEKLY_EVENTS_CONFIG.forEach(ev => {
              const st = getMemberEventRecord(mem, monIso, ev.key).status;
              if (st === 'joined') joinedTotal++;
              else if (st === 'leave') leaveTotal++;
              else if (st === 'absent') absentTotal++;
            });
          });
          const pct = totalPossible > 0 ? Math.round((joinedTotal / totalPossible) * 100) : 0;

          const cardClass = isSelected
            ? 'bg-gradient-to-b from-indigo-600/40 to-slate-900 border-indigo-400 ring-2 ring-indigo-500/40 text-white'
            : 'bg-slate-950/90 hover:bg-slate-800/80 border-slate-800 text-slate-300';

          cards.push(`
            <button onclick="changeSelectedWeekByDate('${monIso}')" class="p-2.5 rounded-xl border text-left transition flex flex-col justify-between ${cardClass}">
              <div class="flex items-center justify-between w-full">
                <span class="text-[10px] font-semibold ${isSelected ? 'text-indigo-200' : 'text-slate-400'}">จันทร์ - อาทิตย์</span>
                ${isCurrent ? `<span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">สัปดาห์นี้</span>` : ''}
              </div>
              <div class="my-1 font-bold text-xs text-white truncate">${formatThaiDateShort(monIso)} - ${formatThaiDateShort(sunIso)}</div>
              <div class="flex items-center justify-between w-full pt-1 border-t border-slate-800/80 text-[10px]">
                <span class="mono font-bold ${pct >= 70 ? 'text-emerald-400' : (pct > 0 ? 'text-amber-300' : 'text-slate-500')}">✅ ${pct}%</span>
                <span class="mono text-[10px] ${(leaveTotal + absentTotal) > 0 ? 'text-rose-300 font-semibold' : 'text-slate-500'}">🏖️${leaveTotal} ❌${absentTotal}</span>
              </div>
            </button>
          `);
        }
        stripEl.innerHTML = cards.join('');
      }

      // 2. Render 6 Activity Summary Cards for Selected Week
      const summaryGrid = document.getElementById('eventSummaryCardsGrid');
      if (summaryGrid) {
        summaryGrid.innerHTML = WEEKLY_EVENTS_CONFIG.map(ev => {
          let joined = 0, leave = 0, absent = 0, none = 0;
          members.forEach(m => {
            const st = getMemberEventRecord(m, selectedWeekMonday, ev.key).status;
            if (st === 'joined') joined++;
            else if (st === 'leave') leave++;
            else if (st === 'absent') absent++;
            else none++;
          });
          const pct = members.length > 0 ? Math.round((joined / members.length) * 100) : 0;

          return `
            <div class="bg-slate-900 border ${ev.accentClass} rounded-2xl p-3.5 flex flex-col justify-between gap-2.5 shadow-lg">
              <div>
                <div class="flex items-center justify-between gap-1.5">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <span class="text-lg shrink-0">${ev.icon}</span>
                    <h3 class="font-bold text-xs sm:text-sm text-white truncate" title="${ev.name}">${ev.name}</h3>
                  </div>
                  <span class="mono text-xs font-bold px-2 py-0.5 rounded-full bg-slate-950/80 text-white border border-slate-700 shrink-0">${pct}%</span>
                </div>
                <div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden mt-2 flex">
                  <div class="h-full bg-emerald-400 transition-all duration-300" style="width: ${members.length ? (joined/members.length)*100 : 0}%"></div>
                  <div class="h-full bg-amber-400 transition-all duration-300" style="width: ${members.length ? (leave/members.length)*100 : 0}%"></div>
                  <div class="h-full bg-rose-500 transition-all duration-300" style="width: ${members.length ? (absent/members.length)*100 : 0}%"></div>
                </div>
                <div class="grid grid-cols-3 gap-1 text-[11px] mt-2.5 text-center">
                  <div class="bg-slate-950/70 rounded-lg py-1 border border-emerald-500/20">
                    <div class="text-slate-400 text-[10px]">เข้าร่วม</div>
                    <div class="mono font-bold text-emerald-400">${joined}</div>
                  </div>
                  <div class="bg-slate-950/70 rounded-lg py-1 border border-amber-500/20">
                    <div class="text-slate-400 text-[10px]">แจ้งลา</div>
                    <div class="mono font-bold text-amber-300">${leave}</div>
                  </div>
                  <div class="bg-slate-950/70 rounded-lg py-1 border border-rose-500/20">
                    <div class="text-slate-400 text-[10px]">ขาด (${none})</div>
                    <div class="mono font-bold text-rose-400">${absent}</div>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1.5 pt-2 border-t border-slate-800/80">
                <button onclick="bulkSetSingleEventForGuild('${ev.key}', 'joined')" class="flex-1 py-1 rounded-lg bg-emerald-600/25 hover:bg-emerald-600/40 border border-emerald-500/30 text-emerald-200 text-[11px] font-semibold transition">
                  ✅ เช็คมาทั้งกิลด์
                </button>
                <button onclick="bulkSetSingleEventForGuild('${ev.key}', 'none')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white text-[11px] transition" title="ล้างข้อมูลเฉพาะกิจกรรมนี้">
                  ↺
                </button>
              </div>
            </div>
          `;
        }).join('');
      }

      // 3. Render Weekly Matrix Table
      const tbody = document.getElementById('eventMatrixTableBody');
      if (tbody) {
        const q = (document.getElementById('eventSearchInput')?.value || '').trim().toLowerCase();
        const teamFilter = document.getElementById('eventTeamFilterSelect')?.value || 'all';
        const compFilter = document.getElementById('eventCompletionFilterSelect')?.value || 'all';
        const sortBy = document.getElementById('eventSortSelect')?.value || 'team_asc';

        let rows = members.map(m => {
          const pInfo = findMemberPartyInfo(m.id);
          let joinedCount = 0, leaveCount = 0, absentCount = 0;
          WEEKLY_EVENTS_CONFIG.forEach(ev => {
            const st = getMemberEventRecord(m, selectedWeekMonday, ev.key).status;
            if (st === 'joined') joinedCount++;
            else if (st === 'leave') leaveCount++;
            else if (st === 'absent') absentCount++;
          });
          return { member: m, pInfo, joinedCount, leaveCount, absentCount, leaveAndAbsent: leaveCount + absentCount };
        }).filter(item => {
          const { member: m, pInfo, joinedCount, leaveCount, absentCount, leaveAndAbsent } = item;
          if (activeJobBarFamily !== 'all' && getJobFamily(m.job).familyKey !== activeJobBarFamily) return false;
          if (teamFilter === 'unassigned' && pInfo) return false;
          if (teamFilter === 'field_main' && (!pInfo || pInfo.team.field !== 'main')) return false;
          if (teamFilter === 'field_sub' && (!pInfo || pInfo.team.field !== 'sub')) return false;
          if (!['all', 'unassigned', 'field_main', 'field_sub'].includes(teamFilter) && (!pInfo || pInfo.team.id !== teamFilter)) return false;
          if (compFilter === 'has_leave_or_absent' && leaveAndAbsent === 0) return false;
          if (compFilter === 'has_absent' && absentCount === 0) return false;
          if (compFilter === 'has_leave' && leaveCount === 0) return false;
          if (compFilter === 'full' && joinedCount < WEEKLY_EVENTS_CONFIG.length) return false;
          if (compFilter === 'partial' && (joinedCount === 0 || joinedCount === WEEKLY_EVENTS_CONFIG.length)) return false;
          if (compFilter === 'zero' && joinedCount > 0) return false;
          if (!q) return true;
          const teamStr = pInfo ? `${pInfo.team.name} ${pInfo.party.name}`.toLowerCase() : '';
          return m.name.toLowerCase().includes(q) || m.job.toLowerCase().includes(q) || teamStr.includes(q);
        });

        rows.sort((a, b) => {
          if (sortBy === 'leave_absent_desc') return b.leaveAndAbsent - a.leaveAndAbsent || b.absentCount - a.absentCount || b.member.gear - a.member.gear;
          if (sortBy === 'absent_desc') return b.absentCount - a.absentCount || b.leaveCount - a.leaveCount || b.member.gear - a.member.gear;
          if (sortBy === 'leave_desc') return b.leaveCount - a.leaveCount || b.absentCount - a.absentCount || b.member.gear - a.member.gear;
          if (sortBy === 'score_desc') return b.joinedCount - a.joinedCount || b.member.gear - a.member.gear;
          if (sortBy === 'score_asc') return a.joinedCount - b.joinedCount || b.member.gear - a.member.gear;
          if (sortBy === 'gear_desc') return b.member.gear - a.member.gear;
          if (sortBy === 'name_asc') return a.member.name.localeCompare(b.member.name, 'th');
          const tA = a.pInfo ? `${a.pInfo.team.name}_${a.pInfo.party.name}` : 'zzz';
          const tB = b.pInfo ? `${b.pInfo.team.name}_${b.pInfo.party.name}` : 'zzz';
          return tA.localeCompare(tB, 'th') || b.member.gear - a.member.gear;
        });

        if (rows.length === 0) {
          tbody.innerHTML = `<tr><td colspan="10" class="py-10 text-center text-slate-500">ไม่พบรายชื่อสมาชิกที่ตรงกับเงื่อนไข</td></tr>`;
        } else {
          tbody.innerHTML = rows.map(({ member: m, pInfo, joinedCount, leaveCount, absentCount }) => {
            const totalEv = WEEKLY_EVENTS_CONFIG.length;
            const teamBadge = pInfo
              ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[11px] font-semibold border ${getTeamTheme(pInfo.team.color).badgeClass}">${pInfo.team.name} • ${pInfo.party.name}</span>`
              : `<span class="text-[11px] text-slate-500">ยังไม่ลงตี้</span>`;

            const eventCells = WEEKLY_EVENTS_CONFIG.map(ev => `
              <td class="py-2 px-1.5 text-center">${renderEventCellButtonHtml(m, ev.key)}</td>
            `).join('');

            const scoreBadgeClass = joinedCount === totalEv
              ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40'
              : (joinedCount >= 4 ? 'bg-indigo-500/20 text-indigo-300 border-indigo-500/40' : 'bg-slate-800 text-slate-300 border-slate-700');

            return `
              <tr class="hover:bg-slate-800/40 transition">
                <td class="py-2.5 px-3">
                  <div class="flex items-center gap-2">
                    ${renderJobEmblem(m.job, 28)}
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5">
                        ${renderColoredMemberName(m)}
                        <span class="mono text-[10px] text-slate-400">Lv.${m.lv}</span>
                      </div>
                      <div class="text-[10px] text-slate-400 mt-0.5">${m.job} • Gear ${m.gear.toLocaleString()}</div>
                    </div>
                  </div>
                </td>
                <td class="py-2.5 px-2.5">${teamBadge}</td>
                ${eventCells}
                <td class="py-2.5 px-3 text-center">
                  <div class="flex items-center justify-center gap-1 flex-wrap">
                    <span class="mono px-2 py-0.5 rounded-md text-[11px] font-bold border ${scoreBadgeClass}" title="เข้าร่วม">
                      ✅ ${joinedCount}/${totalEv}
                    </span>
                    ${leaveCount > 0 ? `<span class="mono px-1.5 py-0.5 rounded-md text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40" title="แจ้งลา">🏖️ ${leaveCount}</span>` : ''}
                    ${absentCount > 0 ? `<span class="mono px-1.5 py-0.5 rounded-md text-[11px] font-bold bg-rose-500/25 text-rose-300 border border-rose-500/40" title="ขาดกิจกรรม">❌ ${absentCount}</span>` : ''}
                  </div>
                </td>
                <td class="py-2.5 px-2.5 text-right">
                  <div class="inline-flex items-center gap-1">
                    <button onclick="setMemberAllEventsInWeek('${m.id}', 'joined')" title="ตั้งเข้าครบ ${totalEv} กิจกรรม" class="px-2 py-1 rounded-lg bg-emerald-600/20 hover:bg-emerald-600/35 text-emerald-300 border border-emerald-500/30 text-[11px] font-semibold transition">✅ ครบ ${totalEv}</button>
                    <button onclick="setMemberAllEventsInWeek('${m.id}', 'none')" title="ล้างข้อมูลสัปดาห์นี้ของคนนี้" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white text-[11px] transition">✕</button>
                  </div>
                </td>
              </tr>
            `;
          }).join('');
        }
      }

      renderWeeklyEventsRankingTable();
    }

    function getTargetWeeksForStats() {
      const scope = document.getElementById('eventRankingScopeSelect')?.value || 'all_weeks';
      if (scope === 'selected_week') {
        return [selectedWeekMonday];
      }
      const allWeeksSet = new Set([selectedWeekMonday]);
      members.forEach(m => {
        if (m.weeklyEvents && typeof m.weeklyEvents === 'object') {
          Object.keys(m.weeklyEvents).forEach(w => {
            if (m.weeklyEvents[w] && Object.keys(m.weeklyEvents[w]).length > 0) {
              allWeeksSet.add(w);
            }
          });
        }
      });
      return Array.from(allWeeksSet).sort().reverse();
    }

    function computeLeaveAbsentAnalyticsData() {
      const targetWeeks = getTargetWeeksForStats();
      const totalWeeks = targetWeeks.length;
      const maxPossiblePerMember = totalWeeks * WEEKLY_EVENTS_CONFIG.length;

      const eventTotals = {};
      WEEKLY_EVENTS_CONFIG.forEach(ev => {
        eventTotals[ev.key] = { joined: 0, leave: 0, absent: 0, none: 0 };
      });

      let guildTotalJoined = 0;
      let guildTotalLeave = 0;
      let guildTotalAbsent = 0;
      let guildTotalDailyLeaveDays = 0;

      const memberStats = members.map(m => {
        ensureLeaveHistoryObject(m);
        const dailyLeaveDates = Object.keys(m.leaveHistory).sort().reverse();
        const dailyLeaveCount = dailyLeaveDates.length;
        guildTotalDailyLeaveDays += dailyLeaveCount;

        const byEvent = {};
        WEEKLY_EVENTS_CONFIG.forEach(ev => {
          byEvent[ev.key] = { joined: 0, leave: 0, absent: 0 };
        });

        let totalJoined = 0;
        let totalLeave = 0;
        let totalAbsent = 0;
        const leaveAbsentDetails = [];

        targetWeeks.forEach(wKey => {
          WEEKLY_EVENTS_CONFIG.forEach(ev => {
            const rec = getMemberEventRecord(m, wKey, ev.key);
            const st = rec.status || 'none';
            if (st === 'joined') {
              byEvent[ev.key].joined++;
              totalJoined++;
              eventTotals[ev.key].joined++;
              guildTotalJoined++;
            } else if (st === 'leave') {
              byEvent[ev.key].leave++;
              totalLeave++;
              eventTotals[ev.key].leave++;
              guildTotalLeave++;
              leaveAbsentDetails.push({
                weekKey: wKey,
                eventKey: ev.key,
                eventName: ev.shortName,
                eventIcon: ev.icon,
                status: 'leave',
                note: rec.note || ''
              });
            } else if (st === 'absent') {
              byEvent[ev.key].absent++;
              totalAbsent++;
              eventTotals[ev.key].absent++;
              guildTotalAbsent++;
              leaveAbsentDetails.push({
                weekKey: wKey,
                eventKey: ev.key,
                eventName: ev.shortName,
                eventIcon: ev.icon,
                status: 'absent',
                note: rec.note || ''
              });
            } else {
              eventTotals[ev.key].none++;
            }
          });
        });

        const totalLeaveAndAbsent = totalLeave + totalAbsent;
        const joinRate = maxPossiblePerMember > 0 ? Math.round((totalJoined / maxPossiblePerMember) * 100) : 0;
        const pInfo = findMemberPartyInfo(m.id);

        return {
          member: m,
          pInfo,
          byEvent,
          totalJoined,
          totalLeave,
          totalAbsent,
          totalLeaveAndAbsent,
          dailyLeaveCount,
          dailyLeaveDates,
          joinRate,
          leaveAbsentDetails
        };
      });

      return {
        targetWeeks,
        totalWeeks,
        maxPossiblePerMember,
        eventTotals,
        guildTotalJoined,
        guildTotalLeave,
        guildTotalAbsent,
        guildTotalDailyLeaveDays,
        memberStats
      };
    }

    function renderWeeklyEventsRankingTable() {
      const tbody = document.getElementById('eventRankingTableBody');
      if (!tbody) return;

      const data = computeLeaveAbsentAnalyticsData();
      const {
        totalWeeks,
        maxPossiblePerMember,
        eventTotals,
        guildTotalJoined,
        guildTotalLeave,
        guildTotalAbsent,
        guildTotalDailyLeaveDays,
        memberStats
      } = data;

      const kpiContainer = document.getElementById('eventLeaveAbsentKpiCards');
      if (kpiContainer) {
        let topLeaveEv = WEEKLY_EVENTS_CONFIG[0], topAbsentEv = WEEKLY_EVENTS_CONFIG[0];
        WEEKLY_EVENTS_CONFIG.forEach(ev => {
          if (eventTotals[ev.key].leave > eventTotals[topLeaveEv.key].leave) topLeaveEv = ev;
          if (eventTotals[ev.key].absent > eventTotals[topAbsentEv.key].absent) topAbsentEv = ev;
        });

        const membersWithLeaveOrAbsent = memberStats.filter(x => x.totalLeaveAndAbsent > 0).length;
        const topOffenders = [...memberStats]
          .filter(x => x.totalLeaveAndAbsent > 0)
          .sort((a, b) => b.totalLeaveAndAbsent - a.totalLeaveAndAbsent || b.totalAbsent - a.totalAbsent)
          .slice(0, 3)
          .map(x => `${x.member.name} (${x.totalLeaveAndAbsent})`)
          .join(', ') || 'ยังไม่มีคนลา/ขาด';

        kpiContainer.innerHTML = `
          <div class="bg-slate-950/90 border border-amber-500/40 rounded-2xl p-4 space-y-1.5 shadow-lg">
            <div class="flex items-center justify-between text-xs text-amber-300 font-semibold">
              <span>🏖️ รวมแจ้งลากิจกรรม</span>
              <span class="px-2 py-0.5 rounded-full bg-amber-500/15 text-[10px]">${totalWeeks} สัปดาห์</span>
            </div>
            <div class="mono text-2xl font-bold text-amber-400">${guildTotalLeave.toLocaleString()} <span class="text-xs font-normal text-slate-400">ครั้ง</span></div>
            <div class="text-[11px] text-slate-400 truncate">
              ลามากสุด: <strong class="text-amber-200">${eventTotals[topLeaveEv.key].leave > 0 ? `${topLeaveEv.icon} ${topLeaveEv.shortName} (${eventTotals[topLeaveEv.key].leave} ครั้ง)` : '-'}</strong>
            </div>
          </div>

          <div class="bg-slate-950/90 border border-rose-500/40 rounded-2xl p-4 space-y-1.5 shadow-lg">
            <div class="flex items-center justify-between text-xs text-rose-300 font-semibold">
              <span>❌ รวมขาดกิจกรรม (ไม่แจ้งลา)</span>
              <span class="px-2 py-0.5 rounded-full bg-rose-500/15 text-[10px]">${totalWeeks} สัปดาห์</span>
            </div>
            <div class="mono text-2xl font-bold text-rose-400">${guildTotalAbsent.toLocaleString()} <span class="text-xs font-normal text-slate-400">ครั้ง</span></div>
            <div class="text-[11px] text-slate-400 truncate">
              ขาดมากสุด: <strong class="text-rose-200">${eventTotals[topAbsentEv.key].absent > 0 ? `${topAbsentEv.icon} ${topAbsentEv.shortName} (${eventTotals[topAbsentEv.key].absent} ครั้ง)` : '-'}</strong>
            </div>
          </div>

          <div class="bg-slate-950/90 border border-fuchsia-500/40 rounded-2xl p-4 space-y-1.5 shadow-lg">
            <div class="flex items-center justify-between text-xs text-fuchsia-300 font-semibold">
              <span>🚨 สมาชิกที่มีประวัติ ลา / ขาด</span>
              <span class="px-2 py-0.5 rounded-full bg-fuchsia-500/15 text-[10px]">จาก ${members.length} คน</span>
            </div>
            <div class="mono text-2xl font-bold text-fuchsia-400">${membersWithLeaveOrAbsent} <span class="text-xs font-normal text-slate-400">คน</span></div>
            <div class="text-[11px] text-slate-400 truncate" title="${topOffenders}">
              สูงสุด: <strong class="text-fuchsia-200">${topOffenders}</strong>
            </div>
          </div>

          <div class="bg-slate-950/90 border border-emerald-500/40 rounded-2xl p-4 space-y-1.5 shadow-lg">
            <div class="flex items-center justify-between text-xs text-emerald-300 font-semibold">
              <span>✅ รวมเข้ากิจกรรม & ลารายวัน</span>
              <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-[10px]">Cloud Sync</span>
            </div>
            <div class="mono text-2xl font-bold text-emerald-400">${guildTotalJoined.toLocaleString()} <span class="text-xs font-normal text-slate-400">ครั้งที่เข้า</span></div>
            <div class="text-[11px] text-slate-400 truncate">
              วันลารายวันสะสมทั้งกิลด์: <strong class="text-amber-300">${guildTotalDailyLeaveDays} วัน</strong>
            </div>
          </div>
        `;
      }

      const breakdownGrid = document.getElementById('eventLeaveBreakdownGrid');
      if (breakdownGrid) {
        const totalSlotsPerEvent = members.length * totalWeeks;
        breakdownGrid.innerHTML = WEEKLY_EVENTS_CONFIG.map(ev => {
          const t = eventTotals[ev.key];
          const jPct = totalSlotsPerEvent > 0 ? Math.round((t.joined / totalSlotsPerEvent) * 100) : 0;
          const lPct = totalSlotsPerEvent > 0 ? Math.round((t.leave / totalSlotsPerEvent) * 100) : 0;
          const aPct = totalSlotsPerEvent > 0 ? Math.round((t.absent / totalSlotsPerEvent) * 100) : 0;

          return `
            <div class="bg-slate-900/95 border border-slate-800 rounded-xl p-3 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-xs text-white flex items-center gap-1">${ev.icon} ${ev.shortName}</span>
                <span class="mono text-[10px] text-rose-300 font-semibold">ลา+ขาด: ${t.leave + t.absent}</span>
              </div>
              <div class="w-full h-2 bg-slate-950 rounded-full overflow-hidden flex">
                <div class="h-full bg-emerald-400" style="width: ${jPct}%" title="เข้าร่วม ${t.joined} ครั้ง"></div>
                <div class="h-full bg-amber-400" style="width: ${lPct}%" title="แจ้งลา ${t.leave} ครั้ง"></div>
                <div class="h-full bg-rose-500" style="width: ${aPct}%" title="ขาด ${t.absent} ครั้ง"></div>
              </div>
              <div class="flex items-center justify-between text-[10px] pt-0.5">
                <span class="text-emerald-400 font-semibold">✅ ${t.joined}</span>
                <span class="text-amber-300 font-semibold">🏖️ ${t.leave} (${lPct}%)</span>
                <span class="text-rose-400 font-semibold">❌ ${t.absent} (${aPct}%)</span>
              </div>
            </div>
          `;
        }).join('');
      }

      const q = (document.getElementById('eventRankingSearchInput')?.value || '').trim().toLowerCase();
      const teamFilter = document.getElementById('eventRankingTeamFilter')?.value || 'all';
      const statusFilter = document.getElementById('eventRankingStatusFilter')?.value || 'all';
      const sortBy = document.getElementById('eventRankingSortSelect')?.value || 'leave_absent_desc';

      const filteredRows = memberStats.filter(item => {
        const { member: m, pInfo, totalLeave, totalAbsent, totalLeaveAndAbsent, dailyLeaveCount } = item;
        if (activeJobBarFamily !== 'all' && getJobFamily(m.job).familyKey !== activeJobBarFamily) return false;
        if (teamFilter === 'unassigned' && pInfo) return false;
        if (teamFilter === 'field_main' && (!pInfo || pInfo.team.field !== 'main')) return false;
        if (teamFilter === 'field_sub' && (!pInfo || pInfo.team.field !== 'sub')) return false;
        if (!['all', 'unassigned', 'field_main', 'field_sub'].includes(teamFilter) && (!pInfo || pInfo.team.id !== teamFilter)) return false;

        if (statusFilter === 'has_leave_or_absent' && totalLeaveAndAbsent === 0) return false;
        if (statusFilter === 'has_absent' && totalAbsent === 0) return false;
        if (statusFilter === 'has_leave' && totalLeave === 0) return false;
        if (statusFilter === 'has_daily_leave' && dailyLeaveCount === 0) return false;
        if (statusFilter === 'perfect' && (totalLeaveAndAbsent > 0 || dailyLeaveCount > 0)) return false;

        if (!q) return true;
        const teamStr = pInfo ? `${pInfo.team.name} ${pInfo.party.name}`.toLowerCase() : '';
        return m.name.toLowerCase().includes(q) || m.job.toLowerCase().includes(q) || teamStr.includes(q);
      });

      filteredRows.sort((a, b) => {
        if (sortBy === 'leave_absent_desc') {
          return b.totalLeaveAndAbsent - a.totalLeaveAndAbsent || b.totalAbsent - a.totalAbsent || b.dailyLeaveCount - a.dailyLeaveCount || b.member.gear - a.member.gear;
        }
        if (sortBy === 'absent_desc') {
          return b.totalAbsent - a.totalAbsent || b.totalLeave - a.totalLeave || b.member.gear - a.member.gear;
        }
        if (sortBy === 'leave_desc') {
          return b.totalLeave - a.totalLeave || b.totalAbsent - a.totalAbsent || b.member.gear - a.member.gear;
        }
        if (sortBy === 'daily_leave_desc') {
          return b.dailyLeaveCount - a.dailyLeaveCount || b.totalLeaveAndAbsent - a.totalLeaveAndAbsent || b.member.gear - a.member.gear;
        }
        return b.totalJoined - a.totalJoined || a.totalLeaveAndAbsent - b.totalLeaveAndAbsent || b.member.gear - a.member.gear;
      });

      if (filteredRows.length === 0) {
        tbody.innerHTML = `<tr><td colspan="13" class="py-10 text-center text-slate-500">ไม่พบข้อมูลสมาชิกที่ตรงกับตัวกรองสถิติการลา/ขาด</td></tr>`;
        return;
      }

      tbody.innerHTML = filteredRows.map((item, idx) => {
        const {
          member: m,
          pInfo,
          byEvent,
          totalJoined,
          totalLeave,
          totalAbsent,
          totalLeaveAndAbsent,
          dailyLeaveCount,
          joinRate,
          leaveAbsentDetails
        } = item;

        const teamHtml = pInfo
          ? `<span class="px-2 py-0.5 rounded text-[10px] font-semibold border ${getTeamTheme(pInfo.team.color).badgeClass}">${pInfo.team.name} • ${pInfo.party.name}</span>`
          : `<span class="text-slate-500 text-[11px]">ยังไม่ลงตี้</span>`;

        const evCols = WEEKLY_EVENTS_CONFIG.map(ev => {
          const c = byEvent[ev.key];
          return `
            <td class="py-2.5 px-1.5 text-center">
              <div class="inline-flex items-center justify-center gap-1 bg-slate-950/90 border border-slate-800 rounded-lg px-2 py-1 mono text-[11px]">
                <span class="text-emerald-400 font-bold" title="เข้าร่วม ${c.joined} ครั้ง">${c.joined}</span>
                <span class="text-slate-600">/</span>
                <span class="${c.leave > 0 ? 'text-amber-300 font-bold' : 'text-slate-500'}" title="แจ้งลา ${c.leave} ครั้ง">${c.leave}</span>
                <span class="text-slate-600">/</span>
                <span class="${c.absent > 0 ? 'text-rose-400 font-bold' : 'text-slate-500'}" title="ขาด ${c.absent} ครั้ง">${c.absent}</span>
              </div>
            </td>
          `;
        }).join('');

        const detailPillsHtml = leaveAbsentDetails.length > 0
          ? leaveAbsentDetails.slice(0, 6).map(d => {
              const isAbs = d.status === 'absent';
              const pillStyle = isAbs
                ? 'bg-rose-950/60 border-rose-500/40 text-rose-200'
                : 'bg-amber-950/60 border-amber-500/40 text-amber-200';
              const tagLabel = isAbs ? '❌ ขาด' : '🏖️ ลา';
              const noteStr = d.note ? ` • ${d.note}` : '';
              return `
                <button onclick="changeSelectedWeekByDate('${d.weekKey}'); switchEventSubView('matrix');" title="คลิกเพื่อเปิดตารางสัปดาห์ ${formatThaiDateShort(d.weekKey)}" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border text-[10px] mr-1 mb-1 hover:brightness-125 transition ${pillStyle}">
                  <span>${tagLabel} <strong>${d.eventName}</strong> (${formatThaiDateShort(d.weekKey)}${noteStr})</span>
                </button>
              `;
            }).join('') + (leaveAbsentDetails.length > 6 ? `<span class="text-[10px] text-slate-400">+อีก ${leaveAbsentDetails.length - 6} รายการ</span>` : '')
          : `<span class="text-[11px] text-emerald-400/80">🌟 ไม่มีประวัติลาหรือขาดกิจกรรม</span>`;

        return `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="py-2.5 px-3">
              <div class="flex items-center gap-2">
                <span class="mono text-xs text-slate-400 w-6">#${idx + 1}</span>
                ${renderJobEmblem(m.job, 26)}
                <div>
                  ${renderColoredMemberName(m)}
                  <div class="text-[10px] text-slate-400 mt-0.5">${m.job} • ${(m.gear/1000).toFixed(1)}k</div>
                </div>
              </div>
            </td>
            <td class="py-2.5 px-2.5">${teamHtml}</td>
            ${evCols}
            <td class="py-2.5 px-2 text-center">
              <span class="mono px-2.5 py-0.5 rounded-full text-xs font-bold ${totalLeave > 0 ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40' : 'bg-slate-900 text-slate-500'}">
                ${totalLeave} ครั้ง
              </span>
            </td>
            <td class="py-2.5 px-2 text-center">
              <span class="mono px-2.5 py-0.5 rounded-full text-xs font-bold ${totalAbsent > 0 ? 'bg-rose-500/25 text-rose-300 border border-rose-500/40' : 'bg-slate-900 text-slate-500'}">
                ${totalAbsent} ครั้ง
              </span>
            </td>
            <td class="py-2.5 px-2.5 text-center">
              <div class="flex flex-col items-center gap-0.5">
                <span class="mono px-2.5 py-0.5 rounded-full text-xs font-bold ${totalLeaveAndAbsent > 0 ? 'bg-rose-600/30 text-rose-200 border border-rose-500/50' : 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'}">
                  รวม ${totalLeaveAndAbsent} ครั้ง
                </span>
                ${dailyLeaveCount > 0 ? `<span class="text-[10px] text-amber-300 font-medium">📅 ลารายวัน ${dailyLeaveCount} วัน</span>` : `<span class="text-[10px] text-slate-500">ลารายวัน 0 วัน</span>`}
              </div>
            </td>
            <td class="py-2.5 px-2.5 text-center">
              <div class="flex flex-col items-center">
                <span class="mono font-bold text-emerald-400 text-xs">${totalJoined}/${maxPossiblePerMember}</span>
                <span class="mono text-[10px] text-slate-400">(${joinRate}%)</span>
              </div>
            </td>
            <td class="py-2.5 px-3 max-w-xs">${detailPillsHtml}</td>
          </tr>
        `;
      }).join('');
    }

    function copyLeaveAbsentStatsReport() {
      const data = computeLeaveAbsentAnalyticsData();
      const scope = document.getElementById('eventRankingScopeSelect')?.value || 'all_weeks';
      const scopeLabel = scope === 'selected_week'
        ? `เฉพาะสัปดาห์ ${formatThaiWeekRange(selectedWeekMonday)}`
        : `สะสมทั้งหมด ${data.totalWeeks} สัปดาห์`;

      const lines = [];
      lines.push(`🚨 สรุปสถิติของการลา / ขาดกิจกรรม — ${guildName}`);
      lines.push(`📅 ขอบเขตข้อมูล: ${scopeLabel}`);
      lines.push(`✅ เข้าร่วมรวม: ${data.guildTotalJoined} ครั้ง | 🏖️ แจ้งลารวม: ${data.guildTotalLeave} ครั้ง | ❌ ขาดรวม: ${data.guildTotalAbsent} ครั้ง`);
      lines.push(`========================================`);

      lines.push(`\n📌 【 สถิติการลา / ขาด แยกตาม 6 กิจกรรม 】`);
      WEEKLY_EVENTS_CONFIG.forEach(ev => {
        const t = data.eventTotals[ev.key];
        lines.push(`  ${ev.icon} ${ev.name}: ✅ เข้า ${t.joined} | 🏖️ ลา ${t.leave} | ❌ ขาด ${t.absent}`);
      });

      const offenders = [...data.memberStats]
        .filter(x => x.totalLeaveAndAbsent > 0 || x.dailyLeaveCount > 0)
        .sort((a, b) => b.totalLeaveAndAbsent - a.totalLeaveAndAbsent || b.totalAbsent - a.totalAbsent || b.dailyLeaveCount - a.dailyLeaveCount);

      if (offenders.length === 0) {
        lines.push(`\n🎉 ไม่มีสมาชิกที่มีประวัติลาหรือขาดกิจกรรมเลย!`);
      } else {
        lines.push(`\n🚨 【 รายชื่อสมาชิกที่มีประวัติ ลา / ขาด (${offenders.length} คน) 】`);
        offenders.forEach((item, idx) => {
          const teamTag = item.pInfo ? `[${item.pInfo.team.name}-${item.pInfo.party.name}]` : `[ยังไม่ลงตี้]`;
          const detailsStr = item.leaveAbsentDetails.map(d => `${d.status === 'absent' ? '❌ขาด' : '🏖️ลา'}:${d.eventName}`).join(', ');
          lines.push(`  ${idx + 1}. ${item.member.name} (${item.member.job}) ${teamTag} — 🏖️ ลากิจกรรม ${item.totalLeave} ครั้ง | ❌ ขาด ${item.totalAbsent} ครั้ง | 📅 ลารายวัน ${item.dailyLeaveCount} วัน ${detailsStr ? `(${detailsStr})` : ''}`);
        });
      }

      const tempArea = document.createElement('textarea');
      tempArea.value = lines.join('\n');
      document.body.appendChild(tempArea);
      tempArea.select();
      document.execCommand('copy');
      tempArea.remove();
      showToast(`📋 คัดลอกรายงานสถิติการลา/ขาดเรียบร้อยแล้ว!`, 'success');
    }

    function exportLeaveAbsentStatsCSV() {
      if (members.length === 0) {
        showToast('ยังไม่มีข้อมูลสมาชิกให้ส่งออก CSV ครับ', 'danger');
        return;
      }
      const data = computeLeaveAbsentAnalyticsData();
      const headers = [
        'อันดับ', 'ชื่อตัวละคร', 'คลาสอาชีพ', 'คะแนน Gear', 'ทีม', 'ปาร์ตี้',
        'Mirror World (เข้า/ลา/ขาด)', 'The Hazy Maze Forest (เข้า/ลา/ขาด)',
        'Guild League อังคาร (เข้า/ลา/ขาด)', 'Guild League พฤหัสบดี (เข้า/ลา/ขาด)',
        'Polarity Zone (เข้า/ลา/ขาด)', 'ศึกชิงปราสาท (เข้า/ลา/ขาด)',
        'รวมลากิจกรรม (ครั้ง)', 'รวมขาดกิจกรรม (ครั้ง)', 'รวม ลา+ขาด กิจกรรม (ครั้ง)',
        'วันลารายวันสะสม (วัน)', 'รวมเข้าร่วมกิจกรรม (ครั้ง)', 'อัตราเข้าร่วม (%)', 'รายละเอียดกิจกรรมที่ลาหรือขาด'
      ];

      const sortedStats = [...data.memberStats].sort(
        (a, b) => b.totalLeaveAndAbsent - a.totalLeaveAndAbsent || b.totalAbsent - a.totalAbsent || b.dailyLeaveCount - a.dailyLeaveCount
      );

      const rows = sortedStats.map((item, idx) => {
        const m = item.member;
        const teamStr = item.pInfo ? item.pInfo.team.name : '-';
        const partyStr = item.pInfo ? item.pInfo.party.name : 'ไม่ได้ลงตี้';
        const evCols = WEEKLY_EVENTS_CONFIG.map(ev => {
          const c = item.byEvent[ev.key];
          return `เข้า ${c.joined} / ลา ${c.leave} / ขาด ${c.absent}`;
        });
        const detailText = item.leaveAbsentDetails
          .map(d => `${d.status === 'absent' ? 'ขาด' : 'ลา'} ${d.eventName} (${d.weekKey}${d.note ? ' ' + d.note : ''})`)
          .join(' | ')
          .replace(/,/g, ' ');

        return [
          idx + 1, m.name, m.job, m.gear, teamStr, partyStr,
          ...evCols,
          item.totalLeave, item.totalAbsent, item.totalLeaveAndAbsent,
          item.dailyLeaveCount, item.totalJoined, `${item.joinRate}%`, detailText || '-'
        ].join(',');
      });

      const csvContent = '\uFEFF' + headers.join(',') + '\n' + rows.join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `สถิติการลาและขาดกิจกรรม_${guildName.replace(/\s+/g, '_')}_${selectedWeekMonday}.csv`;
      a.click();
      showToast(`📥 ส่งออกไฟล์ CSV สถิติการลาและขาดกิจกรรมสำเร็จ!`, 'success');
    }

    function copyWeeklyEventReport() {
      const lines = [];
      lines.push(`🏆 สรุปการเข้ากิจกรรมประจำสัปดาห์ — ${guildName}`);
      lines.push(`📅 สัปดาห์: ${formatThaiWeekRange(selectedWeekMonday)}`);
      lines.push(`========================================`);

      WEEKLY_EVENTS_CONFIG.forEach(ev => {
        const joinedList = members.filter(m => getMemberEventRecord(m, selectedWeekMonday, ev.key).status === 'joined');
        const leaveList = members.filter(m => getMemberEventRecord(m, selectedWeekMonday, ev.key).status === 'leave');
        const absentList = members.filter(m => getMemberEventRecord(m, selectedWeekMonday, ev.key).status === 'absent');
        lines.push(`${ev.icon} ${ev.name}: ✅ เข้าร่วม ${joinedList.length}/${members.length} คน | 🏖️ ลา ${leaveList.length} คน | ❌ ขาด ${absentList.length} คน`);
      });

      const tempArea = document.createElement('textarea');
      tempArea.value = lines.join('\n');
      document.body.appendChild(tempArea);
      tempArea.select();
      document.execCommand('copy');
      tempArea.remove();
      showToast(`📋 คัดลอกสรุปการเข้ากิจกรรมประจำสัปดาห์แล้ว!`, 'success');
    }

    function exportWeeklyEventsCSV() {
      if (members.length === 0) {
        showToast('ยังไม่มีข้อมูลสมาชิกให้ส่งออก CSV ครับ', 'danger');
        return;
      }
      const headers = [
        'สัปดาห์ (จันทร์)', 'ชื่อตัวละคร', 'คลาสอาชีพ', 'คะแนน Gear', 'ทีม', 'ปาร์ตี้',
        'Mirror World', 'The Hazy Maze Forest', 'Guild League (อังคาร)', 'Guild League (พฤหัสบดี)',
        'Polarity Zone', 'ศึกชิงปราสาท', 'รวมเข้าร่วม (จาก 6)', 'รวมแจ้งลา (จาก 6)', 'รวมขาด (จาก 6)'
      ];
      const statusMapThai = { joined: 'เข้าร่วม', leave: 'แจ้งลา', absent: 'ขาด', none: 'รอเช็ค' };

      const rows = members.map(m => {
        const pInfo = findMemberPartyInfo(m.id);
        const teamStr = pInfo ? pInfo.team.name : '-';
        const partyStr = pInfo ? pInfo.party.name : 'ไม่ได้ลงตี้';
        let joinedCount = 0, leaveCount = 0, absentCount = 0;
        const evCells = WEEKLY_EVENTS_CONFIG.map(ev => {
          const rec = getMemberEventRecord(m, selectedWeekMonday, ev.key);
          if (rec.status === 'joined') joinedCount++;
          else if (rec.status === 'leave') leaveCount++;
          else if (rec.status === 'absent') absentCount++;
          const label = statusMapThai[rec.status || 'none'];
          return rec.note ? `${label} (${rec.note.replace(/,/g, ' ')})` : label;
        });
        return [
          selectedWeekMonday, m.name, m.job, m.gear, teamStr, partyStr,
          ...evCells, `${joinedCount}/${WEEKLY_EVENTS_CONFIG.length}`, leaveCount, absentCount
        ].join(',');
      });

      const csvContent = '\uFEFF' + headers.join(',') + '\n' + rows.join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `สรุปกิจกรรมรายสัปดาห์_${guildName.replace(/\s+/g, '_')}_${selectedWeekMonday}.csv`;
      a.click();
      showToast(`📥 ส่งออกไฟล์ CSV กิจกรรมประจำสัปดาห์สำเร็จ!`, 'success');
    }

    function switchTab(tabId) {
      ['board', 'leave', 'events', 'roster', 'member', 'discord'].forEach(t => {
        const sec = document.getElementById('tab-' + t);
        if (sec) sec.classList.toggle('hidden', t !== tabId);
        const btn = document.getElementById('tabBtn-' + t);
        if (btn) {
          if (t === tabId) {
            btn.className = 'px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition bg-indigo-600 text-white shadow';
          } else {
            btn.className = 'px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition text-slate-400 hover:text-white hover:bg-slate-800';
          }
        }
      });
      if (tabId === 'leave') {
        renderLeaveSection();
      }
      if (tabId === 'events') {
        renderWeeklyEventsSection();
      }
      if (tabId === 'discord') {
        document.getElementById('summaryPreviewText').value = generateSummaryText();
      }
    }

    function renderAll() {
      syncMembersStatusForSelectedDate();
      updateKPIs();
      renderJobEmblemBar();
      renderBoard();
      renderLeaveSection();
      renderWeeklyEventsSection();
      renderRosterTable();
      renderMemberQuickCheck();
      const previewEl = document.getElementById('summaryPreviewText');
      if (previewEl) previewEl.value = generateSummaryText();
    }

    // ============================================================================
    // 10. SUPABASE CLOUD DATABASE INTEGRATION (WITH AUTO-SAVE FOR DAILY LEAVE)
    // ============================================================================
    const SUPABASE_URL = 'https://lzlrlnmphtjotgeumqht.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_YjR6DcMPq2OD3l0JVVMzPg_tigMFS6H';
    const ADMIN_PIN = 'Moonz';

    function getNormalizedSupabaseUrl(rawUrl) {
      const trimmed = (rawUrl || '').trim();
      if (!trimmed) return null;
      if (!trimmed.startsWith('http')) return `https://${trimmed}.supabase.co`;
      return trimmed;
    }

    const validSupabaseUrl = getNormalizedSupabaseUrl(SUPABASE_URL);
    const supabaseClient = (validSupabaseUrl && window.supabase)
      ? window.supabase.createClient(validSupabaseUrl, SUPABASE_KEY)
      : null;

    function setCloudStatus(text, isOnline) {
      const badge = document.getElementById('cloudStatusBadge');
      if (!badge) return;
      badge.textContent = text;
      badge.className = isOnline
        ? 'px-2 py-0.5 text-[11px] font-semibold rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'
        : 'px-2 py-0.5 text-[11px] font-semibold rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30';
    }

    async function saveLeaveToDatabaseSilent(actionLabel = 'อัปเดตการลา') {
      if (!supabaseClient) return;
      const syncBadge = document.getElementById('leaveDbSyncBadge');
      const eventSyncBadge = document.getElementById('eventDbSyncBadge');
      try {
        [syncBadge, eventSyncBadge].forEach(b => {
          if (b) {
            b.textContent = '⏳ กำลังบันทึกลง Database...';
            b.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/20 text-amber-300 border border-amber-500/30';
          }
        });
        setCloudStatus('⏳ กำลังบันทึกการลา...', false);

        const nowStr = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
        fileTimestamp = nowStr;
        syncTeamMetadataToParties();

        const { error } = await supabaseClient
          .from('guild_state')
          .upsert({
            id: 1,
            guild_name: guildName,
            file_timestamp: fileTimestamp,
            members: members,
            parties: parties,
            updated_at: new Date().toISOString()
          });

        if (error) throw error;

        [syncBadge, eventSyncBadge].forEach(b => {
          if (b) {
            b.textContent = `☁️ บันทึกลง Database แล้ว (${nowStr})`;
            b.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
          }
        });
        setCloudStatus(`☁️ บันทึกล่าสุด: ${nowStr}`, true);
      } catch (err) {
        console.error('Auto Save Leave Error:', err);
        if (syncBadge) {
          syncBadge.textContent = '⚠️ บันทึกอัตโนมัติไม่สำเร็จ';
          syncBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-rose-500/20 text-rose-300 border border-rose-500/30';
        }
        setCloudStatus('⚠️ บันทึกการลาไม่สำเร็จ', false);
      }
    }

    async function loadFromDatabase(manualRefresh = false) {
      if (!supabaseClient) {
        setCloudStatus('⚠️ ไม่ได้เชื่อมต่อ Supabase', false);
        initDefaultTeamsAndParties();
        populateClassFilterDropdown();
        renderAll();
        return;
      }

      try {
        setCloudStatus('🔄 กำลังโหลดฐานข้อมูล...', false);
        const { data, error } = await supabaseClient
          .from('guild_state')
          .select('*')
          .eq('id', 1)
          .maybeSingle();

        if (error) throw error;

        if (data && Array.isArray(data.members) && Array.isArray(data.parties)) {
          guildName = data.guild_name || guildName;
          fileTimestamp = data.file_timestamp || 'ซิงค์จาก Cloud ล่าสุด';
          members = data.members;
          members.forEach(m => migrateLegacyLeaveOnce(m));
          syncMembersStatusForSelectedDate();
          rebuildTeamsFromLoadedParties(data.parties);
          populateClassFilterDropdown();
          renderAll();
          setCloudStatus(`☁️ ซิงค์แล้ว (${members.length} คน)`, true);
          showToast(`☁️ โหลดข้อมูลและการลาจากฐานข้อมูลสำเร็จ (${members.length} คน)`, 'success');
        } else {
          members = [];
          initDefaultTeamsAndParties();
          populateClassFilterDropdown();
          renderAll();
          setCloudStatus('☁️ พร้อมใช้งาน (ยังไม่มีข้อมูลบน Cloud)', true);
          if (manualRefresh) {
            showToast('ยังไม่มีข้อมูลบน Cloud กรุณาเพิ่มสมาชิกหรือนำเข้าไฟล์ CSV แล้วกดบันทึกผังทัพ', 'info');
          }
        }
      } catch (err) {
        console.error('Database Load Error:', err);
        setCloudStatus('⚠️ เชื่อมต่อฐานข้อมูลไม่สำเร็จ', false);
        if (!parties.length) initDefaultTeamsAndParties();
        populateClassFilterDropdown();
        renderAll();
        showToast('⚠️ โหลดจาก Cloud ไม่สำเร็จ กรุณาตรวจสอบการเชื่อมต่อ', 'danger');
      }
    }

    function saveToDatabase() {
      if (!supabaseClient) {
        showToast('ไม่สามารถเชื่อมต่อ Supabase ได้', 'danger');
        return;
      }

      openCustomDialog({
        title: '🔒 ยืนยันรหัสผ่านแอดมินกิลด์',
        message: 'กรุณาใส่รหัสผ่านแอดมินกิลด์เพื่อบันทึกผังทัพและข้อมูลการลาขึ้น Cloud:',
        showInput: true,
        inputType: 'password',
        defaultInput: '',
        confirmText: '☁️ บันทึกขึ้น Cloud',
        onConfirm: async (pin) => {
          if (pin !== ADMIN_PIN) {
            showToast('❌ รหัสผ่านไม่ถูกต้อง ยกเลิกการบันทึก', 'danger');
            return;
          }

          try {
            setCloudStatus('⏳ กำลังบันทึก...', false);
            const nowStr = new Date().toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
            fileTimestamp = nowStr;
            syncTeamMetadataToParties();

            const { error } = await supabaseClient
              .from('guild_state')
              .upsert({
                id: 1,
                guild_name: guildName,
                file_timestamp: fileTimestamp,
                members: members,
                parties: parties,
                updated_at: new Date().toISOString()
              });

            if (error) throw error;
            renderAll();
            setCloudStatus(`☁️ บันทึกล่าสุด: ${nowStr} (${members.length} คน)`, true);
            showToast('☁️ บันทึกผังทัพและประวัติการลาขึ้นฐานข้อมูลเรียบร้อย!', 'success');
          } catch (err) {
            console.error('Database Save Error:', err);
            setCloudStatus('⚠️ บันทึกไม่สำเร็จ', false);
            showToast('เกิดข้อผิดพลาดในการบันทึกข้อมูลลงฐานข้อมูล', 'danger');
          }
        }
      });
    }

    // Initialize on window load
    window.addEventListener('DOMContentLoaded', () => {
      const todayIso = getLocalDateISO(new Date());
      selectedDate = todayIso;
      document.getElementById('headerDateInput').value = todayIso;
      document.getElementById('leaveDatePicker').value = todayIso;
      document.getElementById('leaveFormStartDate').value = todayIso;
      document.getElementById('leaveFormEndDate').value = todayIso;
      selectedWeekMonday = getWeekMondayISO(todayIso);
      const evPicker = document.getElementById('eventWeekDatePicker');
      if (evPicker) evPicker.value = selectedWeekMonday;

      initDefaultTeamsAndParties();
      renderAll();
      loadFromDatabase();
    });
  </script>
<!-- Drag & Drop Style & Script สำหรับจัดปาร์ตี้ -->
<style>
  [draggable="true"] {
    cursor: grab;
  }
  [draggable="true"]:active {
    cursor: grabbing;
  }
  .dnd-dragging {
    opacity: 0.45 !important;
    transform: scale(0.98);
  }
  .dnd-drop-target {
    outline: 2px dashed #f59e0b !important;
    background-color: rgba(245, 158, 11, 0.15) !important;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25) !important;
    transition: all 0.15s ease;
  }
  .dnd-pool-target {
    outline: 2px dashed #f43f5e !important;
    background-color: rgba(244, 63, 94, 0.08) !important;
  }
</style>

<script>
(function () {
  let dragPayload = null;

  // ล้างสถานะการคลิกค้างไว้ก่อนหน้า เพื่อไม่ให้ชนกับการลากวาง
  function resetActiveSelections() {
    try {
      if (typeof selectedMemberId !== 'undefined') selectedMemberId = null;
      if (typeof selectedPoolMemberId !== 'undefined') selectedPoolMemberId = null;
      if (typeof selectedSlot !== 'undefined') selectedSlot = null;
      if (typeof activeSlot !== 'undefined') activeSlot = null;
    } catch (e) {}

    document.querySelectorAll('.slot-selected').forEach(el => {
      el.classList.remove('slot-selected');
    });
  }

  // ดึงพารามิเตอร์จาก onclick="handlePoolClick('id')" และ onclick="handleSlotClick('partyId', idx)"
  function parsePoolId(el) {
    const attr = el.getAttribute('onclick') || '';
    const match = attr.match(/handlePoolClick\(\s*['"]([^'"]+)['"]\s*\)/);
    return match ? match[1] : null;
  }

  function parseSlotInfo(el) {
    const attr = el.getAttribute('onclick') || '';
    const match = attr.match(/handleSlotClick\(\s*['"]([^'"]+)['"]\s*,\s*(\d+)\s*\)/);
    return match ? { partyId: match[1], slotIndex: parseInt(match[2], 10) } : null;
  }

  function isSlotOccupied(slotEl) {
    return !!slotEl.querySelector('[onclick*="removeMemberFromSlot"]');
  }

  // ผูก Event Drag & Drop ให้การ์ดรายชื่อและช่องในปาร์ตี้ทั้งหมด
  function bindDragAndDrop() {
    // 1. รายชื่อสมาชิกฝั่งซ้าย (Unassigned Pool)
    const poolCards = document.querySelectorAll('#unassignedPoolList [onclick*="handlePoolClick"]');
    poolCards.forEach(card => {
      if (card.dataset.dndBound === '1') return;
      const memberId = parsePoolId(card);
      if (!memberId) return;

      card.dataset.dndBound = '1';
      card.setAttribute('draggable', 'true');

      card.addEventListener('dragstart', (e) => {
        dragPayload = { type: 'pool', memberId };
        card.classList.add('dnd-dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', JSON.stringify(dragPayload));
      });

      card.addEventListener('dragend', () => {
        card.classList.remove('dnd-dragging');
        clearDropHighlights();
        dragPayload = null;
      });
    });

    // 2. ช่องสมาชิกในแต่ละปาร์ตี้ (Party Slots)
    const slotCards = document.querySelectorAll('#teamsHierarchyContainer [onclick*="handleSlotClick"]');
    slotCards.forEach(slotEl => {
      if (slotEl.dataset.dndBound === '1') return;
      const info = parseSlotInfo(slotEl);
      if (!info) return;

      slotEl.dataset.dndBound = '1';
      const occupied = isSlotOccupied(slotEl);

      // ถ้ารายชื่ออยู่ในช่องปาร์ตี้แล้ว ให้สามารถลากเพื่อย้ายหรือสลับช่องได้
      if (occupied) {
        slotEl.setAttribute('draggable', 'true');
        slotEl.addEventListener('dragstart', (e) => {
          dragPayload = {
            type: 'slot',
            partyId: info.partyId,
            slotIndex: info.slotIndex
          };
          slotEl.classList.add('dnd-dragging');
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', JSON.stringify(dragPayload));
        });

        slotEl.addEventListener('dragend', () => {
          slotEl.classList.remove('dnd-dragging');
          clearDropHighlights();
          dragPayload = null;
        });
      }

      // เปิดให้ทุกช่องในปาร์ตี้รับการวาง (Drop Target)
      slotEl.addEventListener('dragover', (e) => {
        if (!dragPayload) return;
        e.preventDefault();
        e.stopPropagation();
        e.dataTransfer.dropEffect = 'move';
        slotEl.classList.add('dnd-drop-target');
      });

      slotEl.addEventListener('dragleave', () => {
        slotEl.classList.remove('dnd-drop-target');
      });

      slotEl.addEventListener('drop', (e) => {
        e.preventDefault();
        e.stopPropagation();
        slotEl.classList.remove('dnd-drop-target');

        const payload = dragPayload || safeParsePayload(e.dataTransfer.getData('text/plain'));
        if (!payload) return;

        // กรณีที่ 1: ลากจากรายชื่อฝั่งซ้าย มาลงช่องในปาร์ตี้
        if (payload.type === 'pool' && payload.memberId) {
          resetActiveSelections();
          handlePoolClick(payload.memberId);
          handleSlotClick(info.partyId, info.slotIndex);
        }
        // กรณีที่ 2: ลากจากช่องในปาร์ตี้ มาสลับหรือย้ายไปอีกช่อง
        else if (payload.type === 'slot') {
          if (payload.partyId === info.partyId && payload.slotIndex === info.slotIndex) return;
          resetActiveSelections();
          handleSlotClick(payload.partyId, payload.slotIndex);
          handleSlotClick(info.partyId, info.slotIndex);
        }

        dragPayload = null;
      });
    });

    // 3. รองรับการลากไปปล่อยบนกรอบการ์ดปาร์ตี้โดยตรง (หาช่องว่างช่องแรกให้อัตโนมัติ)
    const partyCards = document.querySelectorAll('#teamsHierarchyContainer [onclick*="clearSingleParty"]');
    partyCards.forEach(clearBtn => {
      const partyCard = clearBtn.closest('.rounded-2xl');
      if (!partyCard || partyCard.dataset.dndPartyBound === '1') return;
      partyCard.dataset.dndPartyBound = '1';

      partyCard.addEventListener('dragover', (e) => {
        if (!dragPayload || dragPayload.type !== 'pool') return;
        e.preventDefault();
        partyCard.classList.add('dnd-drop-target');
      });

      partyCard.addEventListener('dragleave', (e) => {
        if (!partyCard.contains(e.relatedTarget)) {
          partyCard.classList.remove('dnd-drop-target');
        }
      });

      partyCard.addEventListener('drop', (e) => {
        if (!dragPayload || dragPayload.type !== 'pool') return;
        e.preventDefault();
        partyCard.classList.remove('dnd-drop-target');

        // ค้นหาช่องว่างช่องแรกในปาร์ตี้นี้ (ถ้าเต็มแล้วจะลงช่องที่ 1)
        const slotsInParty = Array.from(partyCard.querySelectorAll('[onclick*="handleSlotClick"]'));
        const targetSlot = slotsInParty.find(s => !isSlotOccupied(s)) || slotsInParty[0];
        if (!targetSlot) return;

        const targetInfo = parseSlotInfo(targetSlot);
        if (targetInfo) {
          resetActiveSelections();
          handlePoolClick(dragPayload.memberId);
          handleSlotClick(targetInfo.partyId, targetInfo.slotIndex);
        }
        dragPayload = null;
      });
    });

    // 4. ลากจากปาร์ตี้กลับมาปล่อยที่กล่องรายชื่อฝั่งซ้าย เพื่อถอดออกจากตี้
    const poolContainer = document.getElementById('unassignedPoolList');
    if (poolContainer && poolContainer.dataset.dndPoolBound !== '1') {
      poolContainer.dataset.dndPoolBound = '1';

      poolContainer.addEventListener('dragover', (e) => {
        if (!dragPayload || dragPayload.type !== 'slot') return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        poolContainer.classList.add('dnd-pool-target');
      });

      poolContainer.addEventListener('dragleave', (e) => {
        if (!poolContainer.contains(e.relatedTarget)) {
          poolContainer.classList.remove('dnd-pool-target');
        }
      });

      poolContainer.addEventListener('drop', (e) => {
        poolContainer.classList.remove('dnd-pool-target');
        const payload = dragPayload || safeParsePayload(e.dataTransfer.getData('text/plain'));
        if (!payload || payload.type !== 'slot') return;

        e.preventDefault();
        resetActiveSelections();
        if (typeof removeMemberFromSlot === 'function') {
          removeMemberFromSlot(payload.partyId, payload.slotIndex);
        }
        dragPayload = null;
      });
    }
  }

  function safeParsePayload(str) {
    try { return JSON.parse(str); } catch (e) { return null; }
  }

  function clearDropHighlights() {
    document.querySelectorAll('.dnd-drop-target, .dnd-pool-target').forEach(el => {
      el.classList.remove('dnd-drop-target', 'dnd-pool-target');
    });
  }

  // ดักจับการ Re-render ของกระดานจัดตี้ด้วย MutationObserver
  function initDragObserver() {
    bindDragAndDrop();
    const targets = [
      document.getElementById('unassignedPoolList'),
      document.getElementById('teamsHierarchyContainer')
    ].filter(Boolean);

    const observer = new MutationObserver(() => {
      bindDragAndDrop();
    });

    targets.forEach(t => observer.observe(t, { childList: true, subtree: true }));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDragObserver);
  } else {
    initDragObserver();
  }
})();
</script>
</body></html>