alue="m_csv_1792521333043_97" class="py-1 px-2 rounded hover:bg-slate-800">✅ NEKOMAMUSHI- — Lord Knight [ทีม B • ปาร์ตี้ 1]</option><option value="m_csv_1792521333043_66" class="py-1 px-2 rounded hover:bg-slate-800">✅ NuBia — High Priest [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_73" class="py-1 px-2 rounded hover:bg-slate-800">✅ oattoツ — Clown [ทีม B • ปาร์ตี้ 3]</option><option value="m_csv_1792521333043_38" class="py-1 px-2 rounded hover:bg-slate-800">✅ oSISYPHUSo — Night Walker [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_91" class="py-1 px-2 rounded hover:bg-slate-800">✅ PAWAN4 — อาลิเทีย [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_125" class="py-1 px-2 rounded hover:bg-slate-800">✅ Phechr — Creator [ทีม C • ปาร์ตี้ 4]</option><option value="m_csv_1792521333043_29" class="py-1 px-2 rounded hover:bg-slate-800">✅ pololoy — High Priest [ทีม B • ปาร์ตี้ 2]</option><option value="m_csv_1792521333043_5" class="py-1 px-2 rounded hover:bg-slate-800">✅ polomintz — High Wizard [ทีม C • ปาร์ตี้ 2]</option><option value="m_csv_1792521333043_65" class="py-1 px-2 rounded hover:bg-slate-800">✅ Pr3DuceS — อาลิเทีย [ทีม B • ปาร์ตี้ 5]</option><option value="m_csv_1792521333043_42" class="py-1 px-2 rounded hover:bg-slate-800">✅ Redskale — High Priest [ทีม C • ปาร์ตี้ 2]</option><option value="m_csv_1792521333043_76" class="py-1 px-2 rounded hover:bg-slate-800">✅ Riricat — Creator [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_77" class="py-1 px-2 rounded hover:bg-slate-800">✅ Roronoa_Zoro — Assassin Cross [ทีม C • ปาร์ตี้ 3]</option><option value="m_csv_1792521333043_81" class="py-1 px-2 rounded hover:bg-slate-800">✅ Seasmoke — High Priest [ทีม A • ปาร์ตี้ 3]</option><option value="m_csv_1792521333043_74" class="py-1 px-2 rounded hover:bg-slate-800">✅ Serenella — High Wizard [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_130" class="py-1 px-2 rounded hover:bg-slate-800">✅ Shiny — Creator [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_3" class="py-1 px-2 rounded hover:bg-slate-800">✅ Shiraori — อาลิเทีย [ทีม B • ปาร์ตี้ 2]</option><option value="m_csv_1792521333043_47" class="py-1 px-2 rounded hover:bg-slate-800">✅ SlientSoul — Paladin [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_105" class="py-1 px-2 rounded hover:bg-slate-800">✅ Taomun — Lord Knight [ทีม B • ปาร์ตี้ 4]</option><option value="m_csv_1792521333043_78" class="py-1 px-2 rounded hover:bg-slate-800">✅ TER03 — High Wizard [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_93" class="py-1 px-2 rounded hover:bg-slate-800">✅ Toey — Paladin [ทีม C • ปาร์ตี้ 3]</option><option value="m_csv_1792521333043_17" class="py-1 px-2 rounded hover:bg-slate-800">✅ Top`Secrets — Assassin Cross [ทีม B • ปาร์ตี้ 1]</option><option value="m_csv_1792521333043_117" class="py-1 px-2 rounded hover:bg-slate-800">✅ wanon — High Priest [ทีม A • ปาร์ตี้ 4]</option><option value="m_csv_1792521333043_14" class="py-1 px-2 rounded hover:bg-slate-800">✅ WeedLDM — Lord Knight [ทีม A • ปาร์ตี้ 4]</option><option value="m_csv_1792521333043_10" class="py-1 px-2 rounded hover:bg-slate-800">✅ Wrist — Assassin Cross [ทีม A • ปาร์ตี้ 1]</option><option value="m_csv_1792521333043_132" class="py-1 px-2 rounded hover:bg-slate-800">✅ Xม่อม3Xยอย — อาลิเทีย [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_111" class="py-1 px-2 rounded hover:bg-slate-800">✅ xอยรุงรัง — Night Walker [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_40" class="py-1 px-2 rounded hover:bg-slate-800">✅ :xEMERGENCYx: — Whitesmith [ยังไม่ลงตี้]</option><option value="m_csv_1792521333043_21" class="py-1 px-2 rounded hover:bg-slate-800">✅ -Yร้าย- — Lord Knight [ทีม B • ปาร์ตี้ 2]</option><option value="m_csv_1792521333043_114" class="py-1 px-2 rounded hover:bg-slate-800">✅ YokYeenThird — High Priest [ทีม C • ปาร์ตี้ 4]</option><option value="m_csv_1792521333043_120" class="py-1 px-2 rounded hover:bg-slate-800">✅ YuizPAN — Gypsy [ทีม C • ปาร์ตี้ 2]</option><option value="m_csv_1792521333043_9" class="py-1 px-2 rounded hover:bg-slate-800">✅ エยざのะ — Clown [ทีม A • ปาร์ตี้ 1]</option></select>
            </div>

            <!-- Date Range Selection -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 bg-slate-950/70 p-3 rounded-xl border border-slate-800/90">
              <div>
                <label class="block text-[11px] text-slate-400 mb-1">ตั้งแต่วันที่ (วันเริ่มลา) *</label>
                <input type="date" id="leaveFormStartDate" onchange="syncLeaveEndDateMin()" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white mono focus:outline-none focus:border-indigo-500">
              </div>
              <div>
                <label class="block text-[11px] text-slate-400 mb-1">ถึงวันที่ (กรณีลาหลายวัน)</label>
                <input type="date" id="leaveFormEndDate" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white mono focus:outline-none focus:border-indigo-500">
              </div>
              <div class="col-span-full flex items-center justify-between pt-1">
                <span class="text-[11px] text-slate-400">หากลาแค่วันเดียว ให้ตั้งวันที่ทั้งสองช่องตรงกัน</span>
                <button type="button" onclick="setLeaveFormSingleDay()" class="text-[11px] text-indigo-400 hover:text-indigo-300 underline">ตั้งเป็นวันเดียว</button>
              </div>
            </div>

            <!-- Leave Type -->
            <div>
              <label class="block text-slate-300 font-medium mb-1.5">2. ประเภทการลา *</label>
              <div class="grid grid-cols-2 gap-2" id="leaveTypeRadioGroup">
                <label class="cursor-pointer flex items-center gap-2 p-2.5 rounded-xl border border-rose-500/50 bg-rose-950/30 text-rose-200 text-xs font-medium transition">
                  <input type="radio" name="leaveTypeRadio" value="ลากิลด์วอร์ (GVG)" checked="" onchange="updateLeaveTypeRadioStyles()" class="accent-rose-500">
                  <span>⚔️ ลากิลด์วอร์ (GVG)</span>
                </label>
                <label class="cursor-pointer flex items-center gap-2 p-2.5 rounded-xl border border-slate-800 bg-slate-950 text-slate-300 text-xs font-medium transition">
                  <input type="radio" name="leaveTypeRadio" value="ลาศึกชิงปราสาท" onchange="updateLeaveTypeRadioStyles()" class="accent-amber-500">
                  <span>🏰 ลาศึกชิงปราสาท</span>
                </label>
                <label class="cursor-pointer flex items-center gap-2 p-2.5 rounded-xl border border-slate-800 bg-slate-950 text-slate-300 text-xs font-medium transition">
                  <input type="radio" name="leaveTypeRadio" value="ลากิจกรรมกิลด์ / บอส" onchange="updateLeaveTypeRadioStyles()" class="accent-purple-500">
                  <span>🕒 ลากิจกรรม/บอส</span>
                </label>
                <label class="cursor-pointer flex items-center gap-2 p-2.5 rounded-xl border border-slate-800 bg-slate-950 text-slate-300 text-xs font-medium transition">
                  <input type="radio" name="leaveTypeRadio" value="ลาทั้งวัน (ไม่เข้าเกม)" onchange="updateLeaveTypeRadioStyles()" class="accent-sky-500">
                  <span>📋 ลาทั้งวัน (ไม่เข้าเกม)</span>
                </label>
              </div>
            </div>

            <!-- Leave Reason + Quick Chips -->
            <div>
              <label class="block text-slate-300 font-medium mb-1.5">3. เหตุผลการลา / หมายเหตุ</label>
              <div class="flex flex-wrap gap-1.5 mb-2">
                <button type="button" onclick="setQuickLeaveReason('ติดงาน / โอทีด่วน')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] border border-slate-700 transition">💼 ติดงาน/โอที</button>
                <button type="button" onclick="setQuickLeaveReason('ติดธุระส่วนตัว / ครอบครัว')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] border border-slate-700 transition">🏠 ติดธุระส่วนตัว</button>
                <button type="button" onclick="setQuickLeaveReason('เดินทาง / ไปต่างจังหวัด')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] border border-slate-700 transition">🚗 ไปต่างจังหวัด</button>
                <button type="button" onclick="setQuickLeaveReason('ไม่สบาย / พักผ่อน')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] border border-slate-700 transition">🤒 ป่วย/พักผ่อน</button>
                <button type="button" onclick="setQuickLeaveReason('เน็ตล่ม / คอมมีปัญหา')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] border border-slate-700 transition">🌐 เน็ต/คอมมีปัญหา</button>
              </div>
              <input type="text" id="leaveFormReasonInput" placeholder="ระบุเหตุผลการลา เช่น ติดโอทีเลิก 22.00 น. หรือไปต่างจังหวัด..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-xs sm:text-sm text-white focus:outline-none focus:border-indigo-500">
            </div>

            <!-- Submit Button -->
            <button type="button" onclick="submitDailyLeaveForm()" class="w-full py-3 rounded-xl bg-gradient-to-r from-rose-600 via-orange-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-bold text-xs sm:text-sm shadow-lg shadow-rose-600/25 flex items-center justify-center gap-2 transition">
              <span>💾 บันทึกการลาลง Database ทันที</span>
            </button>
          </div>
        </div>

        <!-- Right Column: Selected Date Leave Dashboard, Quick Attendance & History (8 cols) -->
        <div class="lg:col-span-7 xl:col-span-8 space-y-6">
          <!-- Summary Cards for Selected Date -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5">
              <div class="text-[11px] text-slate-400">พร้อมวอร์ (วันที่เลือก)</div>
              <div class="mono text-xl font-bold text-emerald-400 mt-1" id="leaveStatReadyDay">134 คน</div>
            </div>
            <div class="bg-slate-900 border border-rose-500/30 rounded-2xl p-3.5">
              <div class="text-[11px] text-rose-300">ลากิลด์วอร์ / ลาทั้งวัน</div>
              <div class="mono text-xl font-bold text-rose-400 mt-1" id="leaveStatAbsentDay">0 คน</div>
            </div>
            <div class="bg-slate-900 border border-amber-500/30 rounded-2xl p-3.5">
              <div class="text-[11px] text-amber-300">ลาศึกชิงปราสาท</div>
              <div class="mono text-xl font-bold text-amber-400 mt-1" id="leaveStatLateDay">0 คน</div>
            </div>
            <div class="bg-slate-900 border border-indigo-500/30 rounded-2xl p-3.5">
              <div class="text-[11px] text-indigo-300">คนในปาร์ตี้ที่ติดลาวันนี้</div>
              <div class="mono text-xl font-bold text-indigo-400 mt-1" id="leaveStatInPartyDay">0 คน</div>
            </div>
          </div>

          <!-- Sub-Navigation inside Right Panel -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-2 p-3.5 bg-slate-950/70 border-b border-slate-800">
              <div class="flex items-center gap-1.5">
                <button onclick="switchLeaveSubView('dailyList')" id="leaveSubBtn-dailyList" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-rose-600 text-white transition">
                  🏖️ รายชื่อคนลาในวันที่เลือก (<span id="leaveDailyCountLabel">0</span>)
                </button>
                <button onclick="switchLeaveSubView('quickCheckin')" id="leaveSubBtn-quickCheckin" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white transition">
                  ⚡ เช็คชื่อ / กดลาด่วนรายคน
                </button>
                <button onclick="switchLeaveSubView('statsHistory')" id="leaveSubBtn-statsHistory" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white transition">
                  📊 สถิติการลาสะสมรายบุคคล
                </button>
              </div>

              <div class="flex items-center gap-1.5">
                <button onclick="copyDailyLeaveReport()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-medium transition">
                  📋 คัดลอกสรุปคนลาวันนี้
                </button>
                <button onclick="exportLeaveHistoryCSV()" class="px-3 py-1.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/30 text-emerald-300 text-xs font-medium transition">
                  📥 Export ประวัติการลา CSV
                </button>
              </div>
            </div>

            <!-- SUB-VIEW 1: Daily Leave List for Selected Date -->
            <div id="leaveSubView-dailyList" class="p-4 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-slate-800/80">
                <span class="text-xs text-slate-400">รายชื่อสมาชิกที่ติดสถานะแจ้งลาในวันที่เลือก (กด <strong class="text-emerald-300">"✅ ยกเลิกการลาวันนี้"</strong> เพื่อเปลี่ยนสถานะกลับเป็นพร้อมวอร์ทันที)</span>
                <button onclick="clearAllLeaveForSelectedDate()" id="btnClearAllDailyLeave" class="hidden px-3 py-1 rounded-xl bg-rose-500/15 hover:bg-rose-500/30 border border-rose-500/30 text-rose-300 text-xs font-semibold transition">
                  🗑️ ยกเลิกการลาทุกคนในวันนี้
                </button>
              </div>
              <div id="dailyLeaveCardsContainer" class="space-y-2.5 max-h-[58vh] overflow-y-auto pr-1">
            <div class="py-12 text-center space-y-2 border border-dashed border-slate-800 rounded-2xl">
              <div class="text-2xl">🎉</div>
              <div class="text-sm font-semibold text-emerald-400">ไม่มีสมาชิกแจ้งลาในวันที่ พฤหัส 22 ต.ค. 2569</div>
              <div class="text-xs text-slate-400">สมาชิกทุกคนพร้อมเข้าร่วมกิลด์วอร์และกิจกรรมกิลด์ หรือสามารถบันทึกการลาได้ที่ฟอร์มด้านซ้าย</div>
            </div>
          </div>
            </div>

            <!-- SUB-VIEW 2: Quick Daily Attendance / Leave Toggle -->
            <div id="leaveSubView-quickCheckin" class="hidden p-4 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-slate-800">
                <input type="text" id="quickCheckinSearch" oninput="renderLeaveQuickCheckin()" placeholder="ค้นหาชื่อสมาชิก, อาชีพ, หรือทีม..." class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-white w-full sm:w-64 focus:outline-none focus:border-indigo-500">
                <div class="flex items-center gap-2">
                  <span class="text-[11px] text-slate-400">คลิกสถานะเพื่อสลับและบันทึกลง Database ทันที</span>
