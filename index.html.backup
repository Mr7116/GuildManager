            <!-- SUB-VIEW 3: Individual Leave Statistics & Full History -->
            <div id="leaveSubView-statsHistory" class="hidden p-4 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-slate-800">
                <div>
                  <p class="text-xs text-slate-300 font-semibold">📊 สรุปสถิติการลารายวันสะสม &amp; เชื่อมโยงสถิติ ลา/ขาด จาก 6 กิจกรรมประจำสัปดาห์</p>
                  <p class="text-[11px] text-slate-400">คลิกที่ป้ายวันที่เพื่อสลับไปดูข้อมูลวันนั้น หรือกดปุ่มด้านขวาเพื่อดูตารางวิเคราะห์การลา/ขาดแยกตาม 6 กิจกรรม</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <select id="leaveStatsSortSelect" onchange="renderLeaveStatsTable()" class="bg-slate-950 border border-slate-800 rounded-xl px-2.5 py-1.5 text-xs text-slate-200">
                    <option value="daily_desc">เรียงตาม: วันลารายวันสะสม (มาก → น้อย)</option>
                    <option value="event_leave_absent_desc">เรียงตาม: ลา+ขาด 6 กิจกรรม (มาก → น้อย)</option>
                    <option value="event_absent_desc">เรียงตาม: ขาดกิจกรรมโดยไม่แจ้ง (มาก → น้อย)</option>
                    <option value="total_all_desc">เรียงตาม: รวมวันลา + ลา/ขาดกิจกรรมทั้งหมด</option>
                  </select>
                  <input type="text" id="leaveStatsSearch" oninput="renderLeaveStatsTable()" placeholder="🔍 ค้นหาชื่อสมาชิก..." class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-white w-full sm:w-48 focus:outline-none focus:border-indigo-500">
                  <button onclick="switchTab('events'); switchEventSubView('ranking');" class="px-3 py-1.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 text-xs font-semibold transition">
                    🚨 ดูสถิติลา/ขาด 6 กิจกรรมเชิงลึก
                  </button>
                </div>
              </div>
              <div class="overflow-x-auto max-h-[54vh]">
                <table class="w-full text-left border-collapse text-xs">
                  <thead class="bg-slate-950 text-slate-400 sticky top-0 border-b border-slate-800 uppercase text-[11px]">
                    <tr>
