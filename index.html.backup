th:82px}.sm\:grid-cols-2{grid-template-columns:repeat(2, minmax(0, 1fr))}.sm\:grid-cols-3{grid-template-columns:repeat(3, minmax(0, 1fr))}.sm\:grid-cols-4{grid-template-columns:repeat(4, minmax(0, 1fr))}.sm\:flex-row{flex-direction:row}.sm\:gap-2{gap:0.5rem}.sm\:gap-2\.5{gap:0.625rem}.sm\:p-3{padding:0.75rem}.sm\:p-5{padding:1.25rem}.sm\:p-6{padding:1.5rem}.sm\:pl-2{padding-left:0.5rem}.sm\:text-base{font-size:1rem;line-height:1.5rem}.sm\:text-sm{font-size:0.875rem;line-height:1.25rem}.sm\:text-xl{font-size:1.25rem;line-height:1.75rem}.sm\:text-lg{font-size:1.125rem;line-height:1.75rem}}@media (min-width: 768px){.md\:grid-cols-7{grid-template-columns:repeat(7, minmax(0, 1fr))}.md\:grid-cols-2{grid-template-columns:repeat(2, minmax(0, 1fr))}}@media (min-width: 1024px){.lg\:sticky{position:sticky}.lg\:top-20{top:5rem}.lg\:col-span-3{grid-column:span 3 / span 3}.lg\:col-span-5{grid-column:span 5 / span 5}.lg\:col-span-7{grid-column:span 7 / span 7}.lg\:col-span-9{grid-column:span 9 / span 9}.lg\:grid-cols-12{grid-template-columns:repeat(12, minmax(0, 1fr))}.lg\:grid-cols-3{grid-template-columns:repeat(3, minmax(0, 1fr))}.lg\:grid-cols-4{grid-template-columns:repeat(4, minmax(0, 1fr))}.lg\:grid-cols-6{grid-template-columns:repeat(6, minmax(0, 1fr))}.lg\:p-5{padding:1.25rem}.lg\:px-6{padding-left:1.5rem;padding-right:1.5rem}}@media (min-width: 1280px){.xl\:col-span-4{grid-column:span 4 / span 4}.xl\:col-span-8{grid-column:span 8 / span 8}.xl\:grid-cols-6{grid-template-columns:repeat(6, minmax(0, 1fr))}.xl\:grid-cols-4{grid-template-columns:repeat(4, minmax(0, 1fr))}}@media (min-width: 1536px){.\32xl\:max-w-\[1860px\]{max-width:1860px}}</style></head>
<body class="min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Universal Action / Dialog Modal (Replaces alert, confirm, prompt) -->
  <div id="customDialogModal" class="fixed inset-0 z-50 hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-5 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 id="dialogTitle" class="font-bold text-base text-white">แจ้งเตือน</h3>
        <button onclick="closeCustomDialog()" class="text-slate-400 hover:text-white text-sm">✕</button>
      </div>
      <p id="dialogMessage" class="text-xs sm:text-sm text-slate-300 whitespace-pre-line leading-relaxed"></p>
      <div id="dialogInputWrapper" class="hidden">
        <input type="text" id="dialogInput" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-indigo-500">
      </div>
      <div id="dialogFieldPickerWrapper" class="hidden space-y-1.5">
        <label class="block text-xs text-slate-400">เลือกสนามประจำทีม (สนามหลัก / สนามรอง):</label>
        <div id="dialogFieldOptions" class="grid grid-cols-2 gap-2"></div>
      </div>
      <div id="dialogColorPickerWrapper" class="hidden space-y-1.5">
        <label class="block text-xs text-slate-400">เลือกสีประจำทีม:</label>
        <div id="dialogColorOptions" class="flex flex-wrap gap-2"></div>
      </div>
      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-800">
        <button id="dialogCancelBtn" onclick="closeCustomDialog()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition">ยกเลิก</button>
        <button id="dialogConfirmBtn" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition">ตกลง</button>
      </div>
    </div>
  </div>

  <!-- Donate QR Zoom Modal -->
  <div id="donateQrModal" onclick="if(event.target===this)this.classList.add('hidden')" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-amber-500/50 rounded-3xl max-w-sm w-full p-6 space-y-4 text-center shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="font-bold text-sm sm:text-base text-amber-300">💸 สนับสนุนค่าขนม</h3>
        <button onclick="document.getElementById('donateQrModal').classList.add('hidden')" class="text-slate-400 hover:text-white text-sm">✕</button>
      </div>
      <p class="text-sm font-semibold text-white leading-relaxed">
        สนับสนุนค่าขนมได้ตามความหล่อ/สวย ของคนโดเนท ✨
      </p>
      <div class="bg-white p-4 rounded-2xl inline-block mx-auto shadow-xl border-4 border-amber-400/70">
        <img src="data:image/png;base64," alt="QR Code โดเนท" class="w-60 h-60 object-contain mx-auto">
      </div>
      <div class="pt-2">
        <button onclick="document.getElementById('donateQrModal').classList.add('hidden')" class="w-full py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm transition">
          ปิดหน้าต่าง
        </button>
      </div>
    </div>
  </div>

  <!-- Add Member Modal -->
  <div id="addMemberModal" class="fixed inset-0 z-50 hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-5 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="font-bold text-base text-white">➕ เพิ่มสมาชิกใหม่เข้ากิลด์ (Manual)</h3>
        <button onclick="closeAddMemberModal()" class="text-slate-400 hover:text-white text-sm">✕</button>
      </div>
      <div class="space-y-3 text-xs sm:text-sm">
        <div>
          <label class="block text-slate-400 mb-1">ชื่อตัวละคร *</label>
          <input type="text" id="newMemName" placeholder="เช่น เทพซ่า007" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-indigo-500">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">สายอาชีพ (15 สายหลัก)</label>
            <select id="newMemJob" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-indigo-500">
              <option value="Lord Knight">⚔️ Lord Knight (Knight)</option>
              <option value="Knight">⚔️ Knight</option>
              <option value="Paladin">🛡️ Paladin (Crusader)</option>
              <option value="Crusader">🛡️ Crusader</option>
              <option value="High Wizard">🔥 High Wizard (Wizard)</option>
              <option value="Wizard">🔥 Wizard</option>
              <option value="Professor">📖 Professor (Sage)</option>
              <option value="Scholar">📖 Scholar (Sage)</option>
              <option value="Sage">📖 Sage</option>
              <option value="Sniper">🏹 Sniper (Hunter)</option>
              <option value="Hunter">🏹 Hunter</option>
              <option value="Clown">🎵 Clown (Bard)</option>
              <option value="Bard">🎵 Bard</option>
              <option value="Gypsy">💃 Gypsy (Dancer)</option>
              <option value="Dancer">💃 Dancer</option>
              <option value="High Priest">✨ High Priest (Priest)</option>
              <option value="Priest">✚ Priest</option>
              <option value="Champion">👊 Champion (Monk)</option>
              <option value="Monk">👊 Monk</option>
              <option value="Assassin Cross">☠️ Assassin Cross (Assassin)</option>
              <option value="Assassin">🗡️ Assassin</option>
              <option value="Stalker">🗡️ Stalker (Rogue)</option>
              <option value="Rogue">🗡️ Rogue</option>
              <option value="Whitesmith">🔨 Whitesmith (Blacksmith)</option>
              <option value="Blacksmith">🔨 Blacksmith</option>
              <option value="Creator">🧪 Creator (Alchemist)</option>
              <option value="Alchemist">🧪 Alchemist</option>
              <option value="Night Walker">🟤 Night Walker (Rebel)</option>
              <option value="Rebel">🔫 Rebel</option>
              <option value="Gunslinger">🔫 Gunslinger (Rebel)</option>
              <option value="คานอส">🌳 คานอส (Kanos)</option>
              <option value="อาลิเทีย">🌳 อาลิเทีย (สายคานอส)</option>
              <option value="Novice">🌱 Novice</option>
            </select>
          </div>
          <div>
            <label class="block text-slate-400 mb-1">เลเวล (Lv.)</label>
            <input type="number" id="newMemLv" value="90" min="1" max="150" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-indigo-500">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">คะแนน Gear</label>
            <input type="number" id="newMemGear" value="30000" step="500" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">ตำแหน่งในกิลด์</label>
            <input type="text" id="newMemPos" value="สมาชิก" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-indigo-500">
          </div>
        </div>
      </div>
      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-800">
        <button onclick="closeAddMemberModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium">ยกเลิก</button>
        <button onclick="confirmAddMember()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold">บันทึกสมาชิก</button>
      </div>
    </div>
  </div>

  <!-- Export Image Preview & Customizer Modal -->
  <div id="exportImageModal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-2 sm:p-3">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-[98vw] 2xl:max-w-[1860px] w-full max-h-[96vh] flex flex-col shadow-2xl overflow-hidden">
      <!-- Modal Top Controls Bar -->
      <div class="px-5 py-3.5 bg-slate-950 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-fuchsia-600 to-indigo-600 flex items-center justify-center text-white text-lg shadow">
            📸
          </div>
          <div>
            <h3 class="font-bold text-sm sm:text-base text-white">ส่งออกรูปภาพผังทัพที่จัด (Export PNG)</h3>
            <p class="text-[11px] text-slate-400">ปรับแต่งข้อมูลและความกว้างของตาราง แล้วกดดาวน์โหลดเป็นไฟล์รูปภาพ .PNG ความละเอียดสูงได้ทันที</p>
          </div>
        </div>

        <!-- Customization Filters & Toggles -->
        <div class="flex flex-wrap items-center gap-2.5 text-xs">
          <div class="flex items-center gap-1.5 bg-slate-900 border border-slate-800 rounded-xl px-2.5 py-1.5">
            <span class="text-slate-400">เลือกทีม:</span>
            <select id="exportTeamSelect" onchange="renderExportPosterPreview()" class="bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-white font-semibold focus:outline-none focus:border-indigo-500">
              <option value="all">ทุกทีมทั้งหมด</option>
            </select>
          </div>

          <div class="flex items-center gap-1.5 bg-slate-900 border border-slate-800 rounded-xl px-2.5 py-1.5">
            <span class="text-slate-400">ความกว้างรูป:</span>
            <select id="exportWidthSelect" onchange="renderExportPosterPreview()" class="bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-amber-300 font-semibold focus:outline-none focus:border-indigo-500">
              <option value="2400">2400px (Ultra Wide กว้างพิเศษ)</option>
              <option value="2048">2048px (แนะนำ ป้องกันข้อความตก)</option>
              <option value="1920">1920px (Full HD)</option>
              <option value="1680" selected="">1680px (มาตรฐาน)</option>
            </select>
          </div>

          <label class="cursor-pointer flex items-center gap-1.5 bg-slate-900 border border-slate-800 rounded-xl px-2.5 py-1.5 text-slate-200 select-none">
            <input type="checkbox" id="exportOptShowGear" checked="" onchange="renderExportPosterPreview()" class="accent-indigo-500 rounded">
            <span>แสดง Gear</span>
          </label>

          <label class="cursor-pointer flex items-center gap-1.5 bg-slate-900 border border-slate-800 rounded-xl px-2.5 py-1.5 text-slate-200 select-none">
            <input type="checkbox" id="exportOptShowStatus" checked="" onchange="renderExportPosterPreview()" class="accent-indigo-500 rounded">
            <span>แสดงสถานะ/ลา</span>
          </label>

          <label class="cursor-pointer flex items-center gap-1.5 bg-slate-900 border border-slate-800 rounded-xl px-2.5 py-1.5 text-slate-200 select-none">
            <input type="checkbox" id="exportOptShowLeaveFooter" checked="" onchange="renderExportPosterPreview()" class="accent-indigo-500 rounded">
            <span>สรุปคนลาท้ายตาราง</span>
          </label>

          <!-- Action Buttons -->
          <button id="btnDownloadExportImg" onclick="downloadExportedTeamImage()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-fuchsia-600 via-indigo-600 to-cyan-600 hover:from-fuchsia-500 hover:to-cyan-500 text-white font-bold text-xs sm:text-sm shadow-lg shadow-indigo-600/30 flex items-center gap-1.5 transition">
            <span>💾 ดาวน์โหลดรูปภาพ (.PNG)</span>
          </button>
          <button onclick="closeExportImageModal()" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-sm transition" title="ปิดหน้าต่าง">
            ✕
          </button>
        </div>
      </div>

      <!-- Scrollable Poster Preview Viewport -->
      <div class="flex-1 overflow-auto bg-[#070a12] p-4 sm:p-6 flex justify-center items-start">
        <!-- Target Poster Container for html2canvas -->
        <div id="exportPosterBoard" style="width: 1680px; min-width: 1680px; background: linear-gradient(180deg, #0b0f19 0%, #111827 100%); color: #f8fafc; font-family: 'Kanit', sans-serif;" class="rounded-3xl border-2 border-slate-700/80 p-8 space-y-6 shadow-2xl">
          <!-- Populated dynamically by renderExportPosterPreview() -->
        </div>
      </div>
    </div>
  </div>

  <!-- Top Header -->
  <header class="sticky top-0 z-30 bg-slate-900/95 backdrop-blur border-b border-slate-800 px-4 lg:px-6 py-3">
    <div class="max-w-[1850px] mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 via-orange-500 to-rose-600 flex items-center justify-center shadow-lg shadow-orange-500/20 font-bold text-xl text-white">
          ⚔️
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-lg sm:text-xl font-bold tracking-wide text-white" id="guildTitleDisplay">Moonz</h1>
            <span class="px-2 py-0.5 text-[11px] font-semibold rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" id="fileMetaBadge">22/10/69 02:30</span>
            <span class="px-2 py-0.5 text-[11px] font-semibold rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" id="cloudStatusBadge">☁️ ซิงค์แล้ว (134 คน)</span>
          </div>
          <p class="text-xs text-slate-400">ระบบจัดทัพ GVG แบ่งสนามหลัก/สนามรอง ครอบคลุมทีม (A, B, C) • บันทึกการลารายวัน &amp; เช็คชื่อ 6 กิจกรรมประจำสัปดาห์เชื่อม Cloud</p>
        </div>
      </div>

      <!-- KPI Summary Bar (Synced with Active Date) -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 text-xs">
        <div class="bg-indigo-950/70 border border-indigo-500/40 rounded-lg px-2.5 py-1 flex items-center gap-1.5">
          <span class="text-indigo-300 font-medium">📅 ข้อมูลวันที่:</span>
          <input type="date" id="headerDateInput" onchange="changeSelectedDate(this.value)" class="bg-transparent text-white font-bold mono text-xs focus:outline-none cursor-pointer">
          <button onclick="setSelectedDateToToday()" class="px-1.5 py-0.5 rounded bg-indigo-600/40 hover:bg-indigo-600 text-[10px] text-indigo-200 hover:text-white transition" title="กลับมาวันนี้">วันนี้</button>
        </div>
        <div class="bg-slate-800/90 border border-slate-700/80 rounded-lg px-3 py-1.5 flex items-center gap-2">
          <span class="text-slate-400">สมาชิก:</span>
          <span class="mono font-bold text-white text-sm" id="statTotal">134</span>
        </div>
        <div class="bg-slate-800/90 border border-slate-700/80 rounded-lg px-3 py-1.5 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-slate-400">พร้อมวอร์:</span>
          <span class="mono font-bold text-emerald-400 text-sm" id="statReady">134</span>
        </div>
        <div onclick="switchTab('leave')" class="cursor-pointer bg-slate-800/90 hover:bg-rose-950/40 border border-slate-700/80 hover:border-rose-500/40 rounded-lg px-3 py-1.5 flex items-center gap-2 transition" title="คลิกเพื่อดูรายละเอียดคนลาในวันนี้">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          <span class="text-slate-400">ลาวันนี้:</span>
          <span class="mono font-bold text-rose-400 text-sm" id="statLeave">0</span>
        </div>
        <div class="bg-slate-800/90 border border-slate-700/80 rounded-lg px-3 py-1.5 flex items-center gap-2">
          <span class="text-slate-400">ลงตี้แล้ว:</span>
          <span class="mono font-bold text-amber-400 text-sm" id="statAssigned">80 / 80</span>
        </div>
        <div onclick="switchTab('events')" class="cursor-pointer bg-slate-800/90 hover:bg-amber-950/40 border border-slate-700/80 hover:border-amber-500/40 rounded-lg px-3 py-1.5 flex items-center gap-2 transition" title="คลิกเพื่อเปิดระบบเช็คชื่อ 6 กิจกรรมประจำสัปดาห์">
          <span class="text-amber-400">🏆 กิจกรรมสัปดาห์นี้:</span>
          <span class="mono font-bold text-amber-300 text-sm" id="statWeeklyEvents">0% (0/804)</span>
        </div>
        <div class="bg-slate-800/90 border border-slate-700/80 rounded-lg px-3 py-1.5 flex items-center gap-2">
          <span class="text-slate-400">เฉลี่ย Gear:</span>
          <span class="mono font-bold text-indigo-400 text-sm" id="statAvgGear">48,451</span>
        </div>
      </div>

      <!-- Quick Import / Add / Export / Cloud Buttons -->
      <div class="flex flex-wrap items-center gap-2">
        <button onclick="saveToDatabase()" class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm shadow-lg shadow-amber-500/20 flex items-center gap-1.5 transition" title="บันทึกผังทัพและข้อมูลการลาขึ้นฐานข้อมูลให้ลูกกิลด์ทุกคนเห็น">
          <span>☁️ บันทึกข้อมูล (Cloud)</span>
        </button>
        <button onclick="loadFromDatabase(true)" class="px-3 py-2 rounded-xl bg-sky-600/20 hover:bg-sky-600/30 border border-sky-500/30 text-sky-300 font-medium text-xs sm:text-sm flex items-center gap-1.5 transition" title="ดึงข้อมูลล่าสุดจากฐานข้อมูล">
          <span>🔄 ซิงค์ข้อมูล</span>
        </button>
        <button onclick="openExportImageModal('all')" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-fuchsia-600 to-indigo-600 hover:from-fuchsia-500 hover:to-indigo-500 text-white font-bold text-xs sm:text-sm shadow-lg shadow-fuchsia-600/20 flex items-center gap-1.5 transition" title="ส่งออกรูปภาพผังทัพที่จัดเป็นไฟล์ PNG">
          <span>📸 ส่งออกรูปผังทัพ</span>
        </button>
        <button onclick="openAddMemberModal()" class="px-3 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs sm:text-sm shadow-lg shadow-indigo-600/20 flex items-center gap-1.5 transition">
          <span>➕ เพิ่มสมาชิก</span>
        </button>
        <label class="cursor-pointer px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-medium text-xs sm:text-sm shadow-lg shadow-emerald-600/20 flex items-center gap-1.5 transition">
          <span>📂 นำเข้า .CSV</span>
          <input type="file" id="csvFileInput" accept=".csv" class="hidden" onchange="handleCSVUpload(event)">
        </label>
        <button onclick="exportLineupCSV()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs sm:text-sm font-medium transition">
          📥 ส่งออก CSV
        </button>
        <button onclick="clearAllGuildData()" class="px-2.5 py-2 rounded-xl bg-rose-500/15 hover:bg-rose-500/30 border border-rose-500/30 text-rose-300 text-xs font-medium transition">
          🗑️ ล้างข้อมูล
        </button>
      </div>
    </div>
  </header>

  <!-- Navigation Tabs -->
  <div class="bg-slate-900/60 border-b border-slate-800/80 px-4 lg:px-6">
    <div class="max-w-[1850px] mx-auto flex flex-wrap items-center justify-between gap-2 py-2">
      <div class="flex items-center gap-1 sm:gap-2 overflow-x-auto">
        <button onclick="switchTab('board')" id="tabBtn-board" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition bg-indigo-600 text-white">
          🛡️ กระดานจัดทีม &amp; ปาร์ตี้ GVG
        </button>
        <button onclick="switchTab('leave')" id="tabBtn-leave" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition text-slate-400 hover:text-white hover:bg-slate-800">🏖️ ระบบบันทึกการลา (0)</button>
        <button onclick="switchTab('events')" id="tabBtn-events" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition text-slate-400 hover:text-white hover:bg-slate-800">🏆 กิจกรรมประจำสัปดาห์ (0%)</button>
        <button onclick="switchTab('roster')" id="tabBtn-roster" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition text-slate-400 hover:text-white hover:bg-slate-800">📋 ตารางสมาชิก (134 คน)</button>
        <button onclick="switchTab('member')" id="tabBtn-member" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition text-slate-400 hover:text-white hover:bg-slate-800">
          🔍 มุมมองลูกกิลด์ (ค้นหาตี้/แจ้งลา)
        </button>
        <button onclick="switchTab('discord')" id="tabBtn-discord" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition text-slate-400 hover:text-white hover:bg-slate-800">
          📢 ส่งแจ้งเตือน Discord / LINE
        </button>
      </div>

      <!-- Smart Actions Bar -->
      <div class="flex flex-wrap items-center gap-2">
        <button onclick="autoAssignByGearAndRole()" class="px-3 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 text-xs font-medium transition flex items-center gap-1.5">
          ⚡ จัดตี้สมดุลอัตโนมัติ (ตาม Gear)
        </button>
        <button onclick="markOfflineAsLeave()" class="px-3 py-1.5 rounded-lg bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 border border-rose-500/30 text-xs font-medium transition">
          💤 ตั้งคนออฟไลน์ ≥ 4 วันเป็น "ลาวันนี้"
        </button>
      </div>
    </div>
  </div>

  <!-- ROWORLDDB-STYLE 13 JOB CLASS EMBLEM BAR -->
  <div class="bg-[#141822] border-b border-slate-800/90 px-4 lg:px-6 py-2.5">
    <div class="max-w-[1850px] mx-auto">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[11px] font-medium text-slate-400 flex items-center gap-1.5">
          <span>🎖️ ตราสัญลักษณ์และสีประจำสายอาชีพทั้ง 15 สาย (คลิกที่ไอคอนอาชีพเพื่อกรองดูเฉพาะสายนั้น)</span>
        </span>
        <button onclick="selectJobBarFamily('all')" id="resetJobBarBtn" class="hidden text-[11px] px-2.5 py-0.5 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 hover:bg-amber-500/30 transition">
          ✕ แสดงทุกสายอาชีพทั้งหมด
        </button>
      </div>
      <div id="jobEmblemBarContainer" class="bg-[#1c202b] border border-slate-800 rounded-2xl p-2 flex items-center gap-1.5 sm:gap-2 overflow-x-auto select-none">
          <button onclick="selectJobBarFamily('knight')" class="group relative flex flex-col items-center justify-center min-w-[74px] sm:min-w-[82px] px-2.5 py-2 rounded-xl border transition-all cursor-pointer bg-transparent border-transparent hover:bg-[#272c3a]" title="Knight (Knight / Lord Knight) — 16 คน">
            <span class="absolute top-1 right-1.5 mono text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-slate-950/90 text-amber-300 border border-slate-700">16</span>
            <div class="transform group-hover:scale-110 transition duration-200">
              <svg width="42" height="42" style="width:42px;height:42px;min-width:42px;" viewBox="0 0 64 64" class="shrink-0 drop-shadow" xmlns="http://www.w3.org/2000/svg"><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(22.5 32 32)" fill="#881313" stroke="rgba(255,255,255,0.75)" stroke-width="2"></rect><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(67.5 32 32)" fill="#dc2626" stroke="rgba(255,255,255,0.9)" stroke-width="2"></rect><polygon points="24,9 40,9 55,24 55,40 40,55 24,55 9,40 9,24" fill="#dc2626" stroke="#ffffff" stroke-width="2.4" stroke-linejoin="round"></polygon><polygon points="26,14 38,14 50,26 50,38 38,50 26,50 14,38 14,26" fill="#881313" stroke="rgba(255,255,255,0.45)" stroke-width="1.3" stroke-linejoin="round"></polygon><path d="M19 45 L44 20 M40 18 L46 18 L46 24" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path><path d="M23 35 L29 41 M18 46 L22 42" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round"></path><path d="M45 45 L20 20 M24 18 L18 18 L18 24" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path><path d="M41 35 L35 41 M46 46 L42 42" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round"></path></svg>
            </div>
            <span class="mt-1.5 text-xs font-bold tracking-tight text-slate-400 group-hover:text-slate-200">Knight</span>
          </button>
        
          <button onclick="selectJobBarFamily('crusader')" class="group relative flex flex-col items-center justify-center min-w-[74px] sm:min-w-[82px] px-2.5 py-2 rounded-xl border transition-all cursor-pointer bg-transparent border-transparent hover:bg-[#272c3a]" title="Crusader (Crusader / Paladin) — 7 คน">
            <span class="absolute top-1 right-1.5 mono text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-slate-950/90 text-amber-300 border border-slate-700">7</span>
            <div class="transform group-hover:scale-110 transition duration-200">
              <svg width="42" height="42" style="width:42px;height:42px;min-width:42px;" viewBox="0 0 64 64" class="shrink-0 drop-shadow" xmlns="http://www.w3.org/2000/svg"><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(22.5 32 32)" fill="#5f0f12" stroke="rgba(255,255,255,0.75)" stroke-width="2"></rect><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(67.5 32 32)" fill="#9f1d20" stroke="rgba(255,255,255,0.9)" stroke-width="2"></rect><polygon points="24,9 40,9 55,24 55,40 40,55 24,55 9,40 9,24" fill="#9f1d20" stroke="#ffffff" stroke-width="2.4" stroke-linejoin="round"></polygon><polygon points="26,14 38,14 50,26 50,38 38,50 26,50 14,38 14,26" fill="#5f0f12" stroke="rgba(255,255,255,0.45)" stroke-width="1.3" stroke-linejoin="round"></polygon><path d="M32 16 L45 21 V32 C45 40.5 39 46.5 32 49 C25 46.5 19 40.5 19 32 V21 L32 16 Z" fill="rgba(255,255,255,0.18)" stroke="#ffffff" stroke-width="3.4" stroke-linejoin="round"></path><path d="M32 22 V42 M24 29 H40" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round"></path></svg>
            </div>
            <span class="mt-1.5 text-xs font-bold tracking-tight text-slate-400 group-hover:text-slate-200">Crusader</span>
          </button>
        
          <button onclick="selectJobBarFamily('wizard')" class="group relative flex flex-col items-center justify-center min-w-[74px] sm:min-w-[82px] px-2.5 py-2 rounded-xl border transition-all cursor-pointer bg-transparent border-transparent hover:bg-[#272c3a]" title="Wizard (Wizard / High Wizard) — 11 คน">
            <span class="absolute top-1 right-1.5 mono text-[10px] font-bold px-1.5 py-0.2 rounded-full bg-slate-950/90 text-amber-300 border border-slate-700">11</span>
            <div class="transform group-hover:scale-110 transition duration-200">
              <svg width="42" height="42" style="width:42px;height:42px;min-width:42px;" viewBox="0 0 64 64" class="shrink-0 drop-shadow" xmlns="http://www.w3.org/2000/svg"><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(22.5 32 32)" fill="#133785" stroke="rgba(255,255,255,0.75)" stroke-width="2"></rect><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(67.5 32 32)" fill="#1d5bd6" stroke="rgba(255,255,255,0.9)" stroke-width="2"></rect><polygon points="24,9 40,9 55,24 55,40 40,55 24,55 9,40 9,24" fill="#1d5bd6" stroke="#ffffff" stroke-width="2.4" stroke-linejoin="round"></polygon><polygon points="26,14 38,14 50,26 50,38 38,50 26,50 14,38 14,26" fill="#133785" stroke="rgba(255,255,255,0.45)" stroke-width="1.3" stroke-linejoin="round"></polygon><path d="M24 46 L37 29" stroke="#ffffff" stroke-width="3.8" stroke-linecap="round"></path><path d="M32 28 C30 21 36 16 42 19 C47 22 45 30 39 31 C36 31.5 35 28 37 26" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round" fill="none"></path><circle cx="39" cy="24" r="2.6" fill="#ffffff"></circle></svg>
            </div>
            <span class="mt-1.5 text-xs font-bold tracking-tight text-slate-400 group-hover:text-slate-200">Wizard</span>
          </button>
        
          <button onclick="selectJobBarFamily('hunter')" class="group relative flex flex-col items-center justify-center min-w-[74px] sm:min-w-[82px] px-2.5 py-2 rounded-xl border transition-all cursor-pointer bg-transparent border-transparent hover:bg-[#272c3a]" title="Hunter (Hunter / Sniper) — 5 คน">
