              <select id="eventRankingStatusFilter" onchange="renderWeeklyEventsRankingTable()" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-slate-200">
                <option value="all">แสดงสมาชิกทุกคน</option>
