  <!-- Main Workspace -->
  <main class="flex-1 max-w-[1850px] w-full mx-auto p-4 lg:p-5">

    <!-- TAB 1: TACTICAL BOARD (TEAMS & PARTIES) -->
    <section id="tab-board" class="grid grid-cols-1 lg:grid-cols-12 gap-5">
      <!-- Left: Unassigned Pool & Donate QR Box -->
      <div class="lg:col-span-3 flex flex-col gap-4 lg:sticky lg:top-20 self-start">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 flex flex-col h-[62vh]">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h2 class="font-bold text-sm sm:text-base text-white">สมาชิกที่ยังไม่ได้ลงตี้</h2>
              <p class="text-[11px] text-slate-400">คลิกเลือกชื่อ แล้วคลิกช่องว่างในตี้เพื่อจัดวาง</p>
            </div>
            <span id="unassignedCountBadge" class="mono px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-800 text-amber-400 border border-slate-700">54</span>
          </div>

          <!-- Pool Search & Filters -->
          <div class="space-y-2 mb-3">
            <input type="text" id="poolSearch" oninput="renderBoard()" placeholder="ค้นหาชื่อ, คลาส, ตำแหน่ง..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none focus:border-indigo-500">
            <div class="flex gap-1.5">
              <select id="poolRoleFilter" onchange="renderBoard()" class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-xs text-slate-300">
                <option value="all">ทุกบทบาท (Role)</option>
                <option value="healer">✨ พระ (Priest / High Priest)</option>
                <option value="tank">🛡️ แทงค์ (Knight / Crusader)</option>
                <option value="bard">🎵 บัฟเพลง (Bard / Dancer)</option>
                <option value="dps">⚔️ ดาเมจ (DPS ทุกคลาส)</option>
              </select>
              <select id="poolStatusFilter" onchange="renderBoard()" class="bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-xs text-slate-300">
                <option value="ready">เฉพาะพร้อมวอร์</option>
                <option value="all">รวมคนลาวันนี้</option>
              </select>
            </div>
          </div>

          <div id="unassignedPoolList" class="flex-1 overflow-y-auto space-y-2 pr-1">
          <div onclick="handlePoolClick('m_csv_1792521333043_6')" style="background: linear-gradient(90deg, rgba(33,131,50,0.26) 0%, rgba(15,23,42,0.95) 85%); border-color: rgba(33,131,50,0.48);" class="p-2.5 rounded-xl border cursor-pointer transition flex items-center justify-between gap-2 group hover:brightness-110 ">
            <div class="flex items-center gap-2.5 min-w-0">
              <svg width="34" height="34" style="width:34px;height:34px;min-width:34px;" viewBox="0 0 64 64" class="shrink-0 drop-shadow" xmlns="http://www.w3.org/2000/svg"><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(22.5 32 32)" fill="#124c1d" stroke="rgba(255,255,255,0.75)" stroke-width="2"></rect><rect x="11" y="11" width="42" height="42" rx="6" transform="rotate(67.5 32 32)" fill="#218332" stroke="rgba(255,255,255,0.9)" stroke-width="2"></rect><polygon points="24,9 40,9 55,24 55,40 40,55 24,55 9,40 9,24" fill="#218332" stroke="#ffffff" stroke-width="2.4" stroke-linejoin="round"></polygon><polygon points="26,14 38,14 50,26 50,38 38,50 26,50 14,38 14,26" fill="#124c1d" stroke="rgba(255,255,255,0.45)" stroke-width="1.3" stroke-linejoin="round"></polygon><path d="M32 16 V48 M18 30 H46" stroke="#ffffff" stroke-width="4.4" stroke-linecap="round"></path><circle cx="32" cy="30" r="5" fill="#218332" stroke="#ffffff" stroke-width="2.6"></circle><path d="M29 18 H35 M29 46 H35 M20 27 V33 M44 27 V33" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round"></path></svg>
